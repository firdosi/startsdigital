---
import Logo from './Logo.astro';
import { site } from '../../site.config';
import { getPublishedServices } from '../../data/services';
import { ArrowRight, ChevronDown } from '@lucide/astro';

const currentPath = Astro.url.pathname;
const publishedServices = getPublishedServices();
---

<header
  id="main-header"
  class="sticky top-0 z-50 bg-[#061d33] text-white border-b border-white/10 transition-all duration-300 font-body"
>
  <div class="mx-auto flex max-w-[1280px] items-center justify-between gap-6 px-6 sm:px-8 py-3.5 sm:py-5">
    <Logo />
    
    <!-- Desktop Navigation Links -->
    <nav class="hidden gap-7 text-[15px] sm:text-[16px] font-semibold lg:flex items-center text-slate-200 font-body relative">
      <a
        href={`${site.basePath}/`}
        aria-current={currentPath === `${site.basePath}/` || currentPath === `${site.basePath}` ? 'page' : undefined}
        class="py-1 text-slate-200 hover:text-white transition-colors duration-200 aria-current:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
      >
        Home
      </a>

        <!-- Desktop Services Dropdown Container -->
        <div id="desktop-services-container" class="relative group/svc flex items-center gap-1">
          <!-- Services link: click toggles dropdown (prevents nav), hover also opens it -->
          <a
            id="desktop-services-link"
            href={`${site.basePath}/services/`}
            aria-current={currentPath.startsWith(`${site.basePath}/services`) ? 'page' : undefined}
            class="py-1 text-slate-200 hover:text-white transition-colors duration-200 aria-current:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
          >
            Services
          </a>

          <button
            id="desktop-services-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="desktop-services-dropdown"
            aria-label="Toggle Services menu"
            class="p-1 rounded text-slate-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#ff762b] transition-transform"
          >
            <ChevronDown class="size-4 transition-transform duration-200" />
          </button>
        </div>

        <a
          href={`${site.basePath}/work/`}
          aria-current={currentPath.startsWith(`${site.basePath}/work`) ? 'page' : undefined}
          class="py-1 text-slate-200 hover:text-white transition-colors duration-200 aria-current:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
        >
          Work
        </a>

        <a
          href={`${site.basePath}/industries/`}
          aria-current={currentPath.startsWith(`${site.basePath}/industries`) ? 'page' : undefined}
          class="py-1 text-slate-200 hover:text-white transition-colors duration-200 aria-current:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
        >
          Industries
        </a>

        <a
          href={`${site.basePath}/about/`}
          aria-current={currentPath.startsWith(`${site.basePath}/about`) ? 'page' : undefined}
          class="py-1 text-slate-200 hover:text-white transition-colors duration-200 aria-current:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
        >
          About
        </a>

        <a
          href={`${site.basePath}/#faq`}
          class="py-1 text-slate-200 hover:text-white transition-colors duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
        >
          FAQ
        </a>

        <a
          href={`${site.basePath}/contact/`}
          aria-current={currentPath.startsWith(`${site.basePath}/contact`) ? 'page' : undefined}
          class="py-1 text-slate-200 hover:text-white transition-colors duration-200 aria-current:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
        >
          Contact
        </a>
      </nav>

      <!-- Right Actions: CTA button with arrow movement -->
      <div class="flex items-center gap-4 font-body">
        <a
          href={`${site.basePath}/contact/`}
          data-track="primary-cta"
          class="hidden lg:inline-flex items-center gap-2 rounded-full bg-white px-6 py-3 text-[15px] sm:text-[16px] font-semibold text-[#061d33] shadow-md hover:bg-[#ddff35] hover:text-[#061d33] transition-all transform hover:-translate-y-0.5 group/cta focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
        >
          <span>Start a Project</span>
          <ArrowRight class="size-4 text-[#061d33] group-hover/cta:translate-x-1 transition-transform" />
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-menu-toggle"
          type="button"
          class="flex size-11 items-center justify-center rounded-full border border-white/20 bg-white/10 text-white hover:bg-white/20 lg:hidden focus:outline-none focus:ring-2 focus:ring-[#ff762b] transition-transform duration-200 active:scale-95"
          aria-label="Toggle navigation"
          aria-expanded="false"
          aria-controls="mobile-menu-drawer"
        >
          <svg class="size-6 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>

    <!-- Expandable Header Services Panel (in-flow directly below nav row, expands header height) -->
    <div
      id="desktop-services-dropdown"
      class="hidden border-t border-white/10 bg-[#072440] py-4 shadow-xl transition-all duration-200 animate-in fade-in slide-in-from-top-1"
    >
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
        <div class="flex items-center justify-between pb-3 border-b border-white/10 mb-3">
          <a
            href={`${site.basePath}/services/`}
            data-services-menu-link="overview"
            class="flex items-center gap-2 text-xs font-heading font-bold uppercase tracking-wider text-[#ff762b] hover:text-white transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
          >
            <span>All Services Directory</span>
            <ArrowRight class="size-3.5 text-[#ff762b]" />
          </a>
          <span class="font-mono text-[11px] text-slate-400">6 Core Specialized Capabilities</span>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
          {publishedServices.map((svc, idx) => {
            const href = `${site.basePath}/services/${svc.slug}/`;
            const isActive = currentPath === href;

            return (
              <a
                href={href}
                data-services-menu-link={svc.slug}
                aria-current={isActive ? 'page' : undefined}
                class="rounded-xl border border-white/10 bg-white/5 p-3 hover:bg-white/15 hover:border-[#ff762b]/50 transition-all flex flex-col justify-between group/item focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
              >
                <div class="flex items-center justify-between mb-2">
                  <span class="font-mono text-xs text-[#ff762b] font-bold">0{idx + 1}</span>
                  <ArrowRight class="size-3.5 text-slate-400 group-hover/item:text-[#ff762b] transition-colors shrink-0" />
                </div>
                <span class="font-semibold text-xs text-white leading-snug">{svc.name}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>

  <!-- Mobile Drawer Navigation -->
  <div
    id="mobile-menu-drawer"
    class="!hidden grid grid-rows-[0fr] opacity-0 transition-all duration-300 ease-in-out border-t border-white/10 bg-[#061d33] px-6 sm:px-8 lg:hidden font-body overflow-hidden"
  >
    <div class="overflow-hidden py-6 flex flex-col gap-3 text-base font-semibold text-white">
      
      <a href={`${site.basePath}/`} class="mobile-link min-h-[44px] flex items-center py-2 hover:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs">Home</a>

      <!-- Mobile Services Accordion Submenu -->
      <div class="border-y border-white/10 py-2">
        <button
          id="mobile-services-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="mobile-services-submenu"
          class="w-full flex items-center justify-between min-h-[44px] text-base font-semibold text-white hover:text-[#ff762b] focus:outline-none focus:ring-2 focus:ring-[#ff762b] rounded-sm"
        >
          <span>Services</span>
          <ChevronDown id="mobile-services-chevron" class="size-5 transition-transform duration-300" />
        </button>

        <div id="mobile-services-submenu" class="hidden pl-4 pt-2 pb-1 space-y-2">
          <a href={`${site.basePath}/services/`} class="mobile-link min-h-[44px] flex items-center text-base text-[#ddff35] font-semibold hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs">
            All Services Directory
          </a>
          {publishedServices.map((svc) => (
            <a
              href={`${site.basePath}/services/${svc.slug}/`}
              class="mobile-link min-h-[44px] flex items-center text-base text-slate-200 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
            >
              {svc.name}
            </a>
          ))}
        </div>
      </div>

      <a href={`${site.basePath}/work/`} class="mobile-link min-h-[44px] flex items-center py-2 hover:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs">Work</a>
      <a href={`${site.basePath}/industries/`} class="mobile-link min-h-[44px] flex items-center py-2 hover:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs">Industries</a>
      <a href={`${site.basePath}/about/`} class="mobile-link min-h-[44px] flex items-center py-2 hover:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs">About</a>
      <a href={`${site.basePath}/#faq`} class="mobile-link min-h-[44px] flex items-center py-2 hover:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs">FAQ</a>
      <a href={`${site.basePath}/contact/`} class="mobile-link min-h-[44px] flex items-center py-2 hover:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs">Contact</a>

      <a
        href={`${site.basePath}/contact/`}
        data-track="primary-cta"
        class="mobile-link mt-4 rounded-full bg-[#ff762b] min-h-[44px] flex items-center justify-center px-6 py-3.5 text-center text-base font-semibold text-white shadow-md hover:bg-[#e56017] transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
      >
        Start a Project
      </a>
    </div>
  </div>
</header>

<script>
  let headerAbortController: AbortController | null = null;

  function setupHeaderNav() {
    // 1. Abort previous listeners to ensure zero duplicate handlers
    if (headerAbortController) {
      headerAbortController.abort();
    }
    headerAbortController = new AbortController();
    const { signal } = headerAbortController;

    const desktopToggle = document.getElementById('desktop-services-toggle');
    const desktopDropdown = document.getElementById('desktop-services-dropdown');
    const container = document.getElementById('desktop-services-container');
    const mobileMenuToggle = document.getElementById('mobile-menu-toggle');
    const mobileDrawer = document.getElementById('mobile-menu-drawer');
    const mobileServicesToggle = document.getElementById('mobile-services-toggle');
    const mobileServicesSubmenu = document.getElementById('mobile-services-submenu');
    const mobileServicesChevron = document.getElementById('mobile-services-chevron');

    // Helper: Reset all menus to closed state
    const resetAllMenus = () => {
      if (desktopDropdown) desktopDropdown.classList.add('hidden');
      if (desktopToggle) desktopToggle.setAttribute('aria-expanded', 'false');

      if (mobileDrawer) {
        mobileDrawer.classList.remove('grid-rows-[1fr]', 'opacity-100');
        mobileDrawer.classList.add('grid-rows-[0fr]', 'opacity-0', '!hidden');
      }
      if (mobileMenuToggle) mobileMenuToggle.setAttribute('aria-expanded', 'false');

      if (mobileServicesSubmenu) mobileServicesSubmenu.classList.add('hidden');
      if (mobileServicesChevron) mobileServicesChevron.classList.remove('rotate-180');
      if (mobileServicesToggle) mobileServicesToggle.setAttribute('aria-expanded', 'false');
    };

    // Always reset menu states on initial load and route changes
    resetAllMenus();

    let desktopCloseTimer: ReturnType<typeof setTimeout> | null = null;

    const showDesktopDropdown = () => {
      if (desktopCloseTimer) {
        clearTimeout(desktopCloseTimer);
        desktopCloseTimer = null;
      }
      if (desktopDropdown) desktopDropdown.classList.remove('hidden');
      if (desktopToggle) desktopToggle.setAttribute('aria-expanded', 'true');
    };

    const hideDesktopDropdownDelayed = () => {
      if (desktopCloseTimer) clearTimeout(desktopCloseTimer);
      desktopCloseTimer = setTimeout(() => {
        if (desktopDropdown) desktopDropdown.classList.add('hidden');
        if (desktopToggle) desktopToggle.setAttribute('aria-expanded', 'false');
      }, 400);
    };

    const hideDesktopDropdown = () => {
      if (desktopCloseTimer) {
        clearTimeout(desktopCloseTimer);
        desktopCloseTimer = null;
      }
      if (desktopDropdown) desktopDropdown.classList.add('hidden');
      if (desktopToggle) desktopToggle.setAttribute('aria-expanded', 'false');
    };

    const handleFocusOut = (e: FocusEvent) => {
      const related = e.relatedTarget as Node | null;
      if (container && desktopDropdown && !container.contains(related) && !desktopDropdown.contains(related)) {
        hideDesktopDropdown();
      }
    };

    if (container && desktopDropdown && desktopToggle) {
      // Pointer Hover enhancement
      container.addEventListener('mouseenter', showDesktopDropdown, { signal });
      container.addEventListener('mouseleave', hideDesktopDropdownDelayed, { signal });

      desktopDropdown.addEventListener('mouseenter', showDesktopDropdown, { signal });
      desktopDropdown.addEventListener('mouseleave', hideDesktopDropdownDelayed, { signal });

      // Shared focusout listeners (closes when focus leaves both container and dropdown)
      container.addEventListener('focusout', handleFocusOut, { signal });
      desktopDropdown.addEventListener('focusout', handleFocusOut, { signal });

      const firstMenuLink = desktopDropdown.querySelector('[data-services-menu-link]') as HTMLElement | null;

      // Function to open menu via keyboard and focus the first menu link
      const openMenuViaKeyboard = (e: Event) => {
        e.preventDefault();
        e.stopPropagation();
        showDesktopDropdown();
        if (firstMenuLink) {
          firstMenuLink.focus();
        }
      };

      // Desktop Services Link keyboard & click handlers
      const desktopServicesLink = document.getElementById('desktop-services-link');
      if (desktopServicesLink) {
        desktopServicesLink.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
            openMenuViaKeyboard(e);
          }
        }, { signal });

        desktopServicesLink.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          showDesktopDropdown();
        }, { signal });
      }

      // Desktop Services Toggle Button keyboard & click handlers
      desktopToggle.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'ArrowDown') {
          openMenuViaKeyboard(e);
        }
      }, { signal });

      desktopToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = !desktopDropdown.classList.contains('hidden');
        if (open) {
          hideDesktopDropdown();
        } else {
          showDesktopDropdown();
        }
      }, { signal });

      // Shift+Tab from 1st dropdown link closes panel and returns focus to Services toggle
      if (firstMenuLink) {
        firstMenuLink.addEventListener('keydown', (e: KeyboardEvent) => {
          if (e.key === 'Tab' && e.shiftKey) {
            e.preventDefault();
            hideDesktopDropdown();
            desktopToggle.focus();
          }
        }, { signal });
      }

      // Escape key closes dropdown and restores focus to Services toggle
      document.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Escape' && !desktopDropdown.classList.contains('hidden')) {
          hideDesktopDropdown();
          desktopToggle.focus();
        }
      }, { signal });
    }

    // Toggle Mobile Main Drawer
    if (mobileMenuToggle && mobileDrawer) {
      mobileMenuToggle.addEventListener('click', () => {
        const expanded = mobileMenuToggle.getAttribute('aria-expanded') === 'true';
        mobileMenuToggle.setAttribute('aria-expanded', String(!expanded));
        if (expanded) {
          mobileDrawer.classList.remove('grid-rows-[1fr]', 'opacity-100');
          mobileDrawer.classList.add('grid-rows-[0fr]', 'opacity-0');
          setTimeout(() => {
            if (mobileMenuToggle.getAttribute('aria-expanded') === 'false') {
              mobileDrawer.classList.add('!hidden');
            }
          }, 300);
        } else {
          mobileDrawer.classList.remove('!hidden');
          requestAnimationFrame(() => {
            mobileDrawer.classList.remove('grid-rows-[0fr]', 'opacity-0');
            mobileDrawer.classList.add('grid-rows-[1fr]', 'opacity-100');
          });
        }
      }, { signal });
    }

    // Toggle Mobile Services Submenu
    if (mobileServicesToggle && mobileServicesSubmenu && mobileServicesChevron) {
      mobileServicesToggle.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = mobileServicesSubmenu.classList.contains('hidden');
        if (open) {
          mobileServicesSubmenu.classList.remove('hidden');
          mobileServicesChevron.classList.add('rotate-180');
          mobileServicesToggle.setAttribute('aria-expanded', 'true');
        } else {
          mobileServicesSubmenu.classList.add('hidden');
          mobileServicesChevron.classList.remove('rotate-180');
          mobileServicesToggle.setAttribute('aria-expanded', 'false');
          mobileServicesToggle.focus();
        }
      }, { signal });
    }

    // Outside Click Listener (Does NOT steal focus unexpectedly)
    document.addEventListener('click', (e: MouseEvent) => {
      const target = e.target as HTMLElement;
      if (desktopDropdown && !desktopDropdown.contains(target) && desktopToggle && !desktopToggle.contains(target)) {
        desktopDropdown.classList.add('hidden');
        desktopToggle.setAttribute('aria-expanded', 'false');
      }
    }, { signal });

    // Keydown (Escape) Listener with Focus Restoration
    document.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        // Priority 1: Mobile service submenu
        if (mobileServicesSubmenu && !mobileServicesSubmenu.classList.contains('hidden')) {
          mobileServicesSubmenu.classList.add('hidden');
          if (mobileServicesChevron) mobileServicesChevron.classList.remove('rotate-180');
          if (mobileServicesToggle) {
            mobileServicesToggle.setAttribute('aria-expanded', 'false');
            mobileServicesToggle.focus();
          }
        }
        // Priority 2: Mobile main drawer
        else if (mobileDrawer && mobileMenuToggle && mobileMenuToggle.getAttribute('aria-expanded') === 'true') {
          mobileDrawer.classList.remove('grid-rows-[1fr]', 'opacity-100');
          mobileDrawer.classList.add('grid-rows-[0fr]', 'opacity-0');
          mobileMenuToggle.setAttribute('aria-expanded', 'false');
          mobileMenuToggle.focus();
        }
        // Priority 3: Desktop dropdown
        else if (desktopDropdown && !desktopDropdown.classList.contains('hidden')) {
          desktopDropdown.classList.add('hidden');
          if (desktopToggle) {
            desktopToggle.setAttribute('aria-expanded', 'false');
            desktopToggle.focus();
          }
        }
      }
    }, { signal });

    // Close mobile menu on link click
    const mobileLinks = document.querySelectorAll('.mobile-link');
    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        resetAllMenus();
      }, { signal });
    });
  }

  document.addEventListener('DOMContentLoaded', setupHeaderNav);
  document.addEventListener('astro:page-load', setupHeaderNav);
</script>

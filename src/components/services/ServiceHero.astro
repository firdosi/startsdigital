---
import type { ServiceDefinition } from '../../data/services';
import ServiceBreadcrumbs from './ServiceBreadcrumbs.astro';
import AnimatedGrid from '../motion/AnimatedGrid.astro';
import FloatingOrb from '../motion/FloatingOrb.astro';
import SectionSpark from '../motion/SectionSpark.astro';
import { site } from '../../site.config';
import { ArrowRight, ChevronDown, CheckCircle2, Grid } from '@lucide/astro';

export interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
const contactUrl = `${site.basePath}/contact/?service=${encodeURIComponent(service.contactServiceValue)}`;
---

<section id="service-hero" class="relative overflow-hidden bg-[#061d33] text-white pt-12 sm:pt-16 lg:pt-20 pb-12 sm:pb-16 lg:pb-20 rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl scroll-mt-24">
  <AnimatedGrid opacity={0.10} />
  <FloatingOrb color="orange" size="lg" class="-top-24 -left-24 opacity-60 pointer-events-none" duration="16s" />
  <SectionSpark color="orange" size="md" class="top-10 right-[8%] pointer-events-none" delay="0s" />

  <div class="relative mx-auto max-w-[1280px] px-6 sm:px-8 z-10">
    <div class="max-w-4xl space-y-6 text-left">
      
      <!-- Breadcrumbs -->
      <ServiceBreadcrumbs currentName={service.name} currentSlug={service.slug} />

      <!-- Eyebrow -->
      <div class="inline-flex items-center gap-2">
        <span class="w-7 h-[2px] bg-[#ff762b] shrink-0" aria-hidden="true"></span>
        <span class="font-mono font-semibold text-sm uppercase tracking-[0.08em] text-[#ff762b]">
          {service.eyebrow}
        </span>
      </div>

      <!-- H1 -->
      <h1 class="font-heading font-bold text-[32px] sm:text-[44px] lg:text-[54px] leading-[1.12] tracking-[-0.03em] text-white">
        {service.summary}
      </h1>

      <!-- Overview paragraph >= 16px -->
      <p class="text-base sm:text-lg leading-[1.65] text-slate-200 font-body font-normal max-w-3xl">
        {service.overview}
      </p>

      <!-- Capability Tags -->
      <div class="pt-2 flex flex-wrap gap-2">
        {service.idealFor.slice(0, 4).map((tag) => (
          <span class="inline-flex items-center gap-1.5 rounded-full border border-white/20 bg-white/10 px-3.5 py-1 text-xs font-mono text-[#ddff35]">
            <CheckCircle2 class="size-3 text-[#ff762b]" />
            <span>{tag}</span>
          </span>
        ))}
      </div>

      <!-- Action Buttons -->
      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a
          href={contactUrl}
          data-track="primary-cta"
          data-service={service.slug}
          class="inline-flex items-center gap-2 rounded-full bg-[#ff762b] px-7 py-3.5 font-body font-semibold text-base text-white hover:bg-white hover:text-[#061d33] transition-all shadow-lg group/cta focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
        >
          <span>Discuss {service.name}</span>
          <ArrowRight class="size-4 group-hover/cta:translate-x-1 transition-transform" />
        </a>

        <a
          href="#proof"
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3.5 font-body font-semibold text-base text-white hover:bg-white/15 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
        >
          <span>View Project Proof</span>
          <ChevronDown class="size-4 text-slate-300" />
        </a>

        <a
          href={`${site.basePath}/services/`}
          class="inline-flex items-center gap-2 text-sm font-mono font-semibold text-slate-300 hover:text-[#ddff35] transition-colors ml-auto sm:ml-0 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
        >
          <Grid class="size-4 text-[#ddff35]" />
          <span>All Services</span>
        </a>
      </div>

    </div>
  </div>
</section>

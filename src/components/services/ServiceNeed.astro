---
import type { ServiceDefinition } from '../../data/services';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { CheckCircle2 } from '@lucide/astro';

export interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
---

<section id="when-useful" class="py-16 sm:py-20 lg:py-24 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">
      
      <!-- Header Column -->
      <div class="lg:col-span-5 space-y-4">
        <SectionEyebrow label="WHEN THIS SERVICE IS USEFUL" align="left" delay={0} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
          Situations where this service supports project goals.
        </h2>
        <p class="text-base text-slate-700 font-body leading-relaxed">
          Businesses engage Starts Digital for {service.name.toLowerCase()} when they need structured support across these practical project requirements.
        </p>
      </div>

      <!-- Scenarios List Column -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-8 shadow-xs space-y-4">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 block mb-2">
            Practical Project Scenarios
          </span>
          <div class="space-y-3.5">
            {service.idealFor.map((item, idx) => (
              <div class="flex items-start gap-3.5 pb-3 border-b border-[#061d33]/8 last:border-b-0 last:pb-0">
                <CheckCircle2 class="size-5 text-[#ff762b] shrink-0 mt-0.5" />
                <span class="text-base text-slate-800 font-body leading-relaxed">
                  {item}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

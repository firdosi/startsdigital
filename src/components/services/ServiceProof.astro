---
import type { ServiceDefinition } from '../../data/services';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { site } from '../../site.config';
import { ArrowUpRight, TrendingUp, Award, Layers, ShieldCheck } from '@lucide/astro';

export interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;

const allProofProjects: Record<string, any> = {
  'black-gold-fertilizer': {
    brand: 'Black Gold Fertilizer',
    category: 'Agriculture & E-commerce',
    contribution: 'Strategy, Meta advertising, creative testing, e-commerce growth and website support.',
    result: 'Supported PKR 30M+ in delivered-order revenue, 29,000+ product sales and 22,000+ delivered sales over 24 months.',
    link: `${site.basePath}/work/black-gold-fertilizer/`,
    image: `${site.basePath}/images/black-gold-official.png`,
    icon: TrendingUp
  },
  'wajib-livestock': {
    brand: 'Wajib Livestock',
    category: 'Livestock & Seasonal Campaigns',
    contribution: 'Campaign strategy, paid social, lead generation, creative production and sales support.',
    result: 'Helped sell more than 150 animals and supported PKR 4.2M+ in sales during the Eid Qurbani campaign.',
    link: `${site.basePath}/work/qurbani-campaign/`,
    image: null,
    icon: Award
  },
  'rk-reno-solutions': {
    brand: 'RK Reno Solutions',
    category: 'Renovation & Local Services',
    contribution: 'Website, content and local SEO foundation for renovation and air-conditioning services in Kuala Lumpur and Selangor.',
    result: null,
    link: `${site.basePath}/work/rk-reno-solutions/`,
    image: `${site.basePath}/brands/rk-reno-solutions/screenshot.webp`,
    icon: Layers
  },
  'convortai': {
    brand: 'ConvortAI',
    category: 'Technology Product',
    relationship: 'Technology Partner • Product Development & Growth Partner',
    contribution: 'Starts Digital developed the web application and continues supporting product development, project management, social media, creative production and growth.',
    result: null,
    link: `${site.basePath}/work/convortai/`,
    image: `${site.basePath}/brands/convort-ai/logo.webp`,
    icon: ShieldCheck,
    transparentNote: 'This demonstrates Starts Digital’s technology-product and workflow experience. The final tools and implementation for each AI workflow depend on the specific project requirements.'
  }
};

const proofList = (service.relatedProjectIds || [])
  .map((id) => allProofProjects[id])
  .filter(Boolean);

const isSingle = proofList.length === 1;
---

{
  proofList.length > 0 && (
    <section id="proof" class="py-16 sm:py-20 lg:py-24 bg-[#061d33] text-white border-b border-white/10 scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
        
        <!-- Section Header -->
        <div class="mb-12 text-center max-w-3xl mx-auto space-y-3">
          <SectionEyebrow label="RELEVANT PROJECT EXPERIENCE" align="center" motion={false} />
          <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-white leading-tight tracking-[-0.025em]">
            Verified project proof related to {service.name.toLowerCase()}.
          </h2>
          <p class="text-base sm:text-lg text-slate-200 font-body leading-relaxed font-normal">
            Real work demonstrating how Starts Digital contributes across strategy, creative and technical requirements.
          </p>
        </div>

        <!-- Proof Cards Layout (Centered if 1 project, 2 columns if multiple) -->
        <div class={isSingle ? "max-w-2xl mx-auto" : "grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto"}>
          {proofList.map((p) => {
            const IconComp = p.icon;
            return (
              <div class="rounded-3xl border border-white/15 bg-white/5 backdrop-blur-md p-6 sm:p-8 flex flex-col justify-between shadow-xl group hover:border-[#ff762b]/40 transition-all">
                <div class="space-y-4">
                  
                  <div class="flex items-start justify-between gap-3 pb-4 border-b border-white/10">
                    <div>
                      <span class="inline-block px-2.5 py-0.5 rounded-full border border-white/20 bg-white/10 text-[11px] font-mono font-semibold uppercase tracking-wider text-[#ddff35]">
                        {p.category}
                      </span>
                      <h3 class="font-heading font-bold text-2xl text-white pt-1">{p.brand}</h3>
                      {p.relationship && (
                        <p class="font-mono text-xs text-slate-300">{p.relationship}</p>
                      )}
                    </div>

                    <a
                      href={p.link}
                      aria-label={`View ${p.brand} case study`}
                      class="size-10 rounded-full bg-white/10 text-white flex items-center justify-center group-hover:bg-[#ff762b] transition-colors shrink-0"
                    >
                      <ArrowUpRight class="size-5" />
                    </a>
                  </div>

                  {p.image ? (
                    <div class="overflow-hidden rounded-2xl border border-white/10 bg-slate-900/50 p-4 aspect-16/9 flex items-center justify-center">
                      <img
                        src={p.image}
                        alt={`${p.brand} project proof`}
                        width="400"
                        height="225"
                        loading="lazy"
                        decoding="async"
                        class="max-h-full max-w-full object-contain rounded-lg group-hover:scale-105 transition-transform duration-500"
                      />
                    </div>
                  ) : (
                    <div class="rounded-2xl border border-white/10 bg-white/5 p-5 flex items-center gap-3">
                      <IconComp class="size-6 text-[#ddff35] shrink-0" />
                      <span class="text-xs font-mono text-slate-200">Verified Campaign Performance</span>
                    </div>
                  )}

                  <div class="space-y-2">
                    <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 block">
                      Contribution
                    </span>
                    <p class="text-base text-slate-200 font-body leading-relaxed">
                      {p.contribution}
                    </p>
                  </div>

                  {p.result && (
                    <div class="pt-3 border-t border-white/10 space-y-1">
                      <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[#ddff35] block">
                        Verified Outcome
                      </span>
                      <p class="text-base font-body font-semibold text-white leading-relaxed">
                        {p.result}
                      </p>
                    </div>
                  )}

                  {p.transparentNote && (
                    <div class="pt-3 border-t border-white/10">
                      <p class="text-xs font-mono text-slate-300 leading-relaxed">
                        Note: {p.transparentNote}
                      </p>
                    </div>
                  )}

                </div>

                <div class="pt-4 mt-6 border-t border-white/10">
                  <a
                    href={p.link}
                    class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-[#ff762b] hover:text-white transition-colors"
                  >
                    <span>EXPLORE PROJECT PROOF</span>
                    <ArrowUpRight class="size-3.5" />
                  </a>
                </div>

              </div>
            );
          })}
        </div>

      </div>
    </section>
  )
}

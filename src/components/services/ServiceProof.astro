---
import type { ServiceDefinition } from '../../data/services';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { site } from '../../site.config';
import { ArrowUpRight } from '@lucide/astro';

export interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;

const allProofProjects: Record<string, any> = {
  'black-gold-fertilizer': {
    brand: 'Black Gold Fertilizer',
    category: 'Agriculture & E-commerce',
    contribution: 'Digital marketing, paid Meta advertising, creative testing, WooCommerce optimization and digital sales support.',
    link: `${site.basePath}/work/black-gold-fertilizer/`,
    image: `${site.basePath}/images/black-gold-official.png`
  },
  'wajib-livestock': {
    brand: 'Wajib Livestock',
    category: 'Livestock & Seasonal Campaigns',
    contribution: 'Seasonal Qurbani campaign strategy, paid social advertising, lead generation creative and WhatsApp sales routing.',
    link: `${site.basePath}/work/qurbani-campaign/`,
    image: `${site.basePath}/brands/wajib-livestock/logo.webp`,
    darkImageContainer: true
  },
  'rk-reno-solutions': {
    brand: 'RK Reno Solutions',
    category: 'Renovation & Local Services',
    contribution: 'Website structure, service-page development, location content and technical local SEO for Kuala Lumpur and Selangor.',
    link: `${site.basePath}/work/rk-reno-solutions/`,
    image: `${site.basePath}/brands/rk-reno-solutions/screenshot.webp`
  },
  'convortai': {
    brand: 'ConvortAI',
    category: 'Technology Product',
    relationship: 'Technology Partner',
    contribution: 'Web application development, UI design, project management, social media marketing and ongoing growth support.',
    link: `${site.basePath}/work/convortai/`,
    image: `${site.basePath}/brands/convort-ai/logo.webp`,
    darkImageContainer: true
  }
};

const proofList = (service.relatedProjectIds || [])
  .map((id) => allProofProjects[id])
  .filter(Boolean)
  .slice(0, 2);

const isSingle = proofList.length === 1;
---

{
  proofList.length > 0 && (
    <section id="proof" class="py-16 sm:py-20 bg-[#061d33] text-white border-b border-white/10 scroll-mt-44">
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
        
        <!-- Section Header -->
        <div class="mb-10 text-center max-w-3xl mx-auto space-y-3">
          <SectionEyebrow label="RELATED EXPERIENCE" align="center" motion={false} />
          <h2 class="font-heading font-bold text-[28px] sm:text-[36px] text-white leading-tight tracking-[-0.025em]">
            Relevant client experience.
          </h2>
          <p class="text-base text-slate-200 font-body leading-relaxed font-normal">
            Compact reference showing how our {service.name.toLowerCase()} work supports real business requirements.
          </p>
        </div>

        <!-- Max 2 Compact Cards Layout -->
        <div class={isSingle ? "max-w-xl mx-auto" : "grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto"}>
          {proofList.map((p) => (
            <div class="rounded-3xl border border-white/15 bg-white/5 backdrop-blur-md p-6 flex flex-col justify-between shadow-xl group hover:border-[#ff762b]/40 transition-all">
              <div class="space-y-4">
                
                <div class="flex items-start justify-between gap-3 pb-3 border-b border-white/10">
                  <div>
                    <span class="inline-block px-2.5 py-0.5 rounded-full border border-white/20 bg-white/10 text-[11px] font-mono font-semibold uppercase tracking-wider text-[#ddff35]">
                      {p.category}
                    </span>
                    <h3 class="font-heading font-bold text-2xl text-white pt-1">{p.brand}</h3>
                  </div>

                  <a
                    href={p.link}
                    aria-label={`View ${p.brand} story`}
                    class="size-10 rounded-full bg-white/10 text-white flex items-center justify-center group-hover:bg-[#ff762b] transition-colors shrink-0"
                  >
                    <ArrowUpRight class="size-5" />
                  </a>
                </div>

                {p.image && (
                  <div class={`overflow-hidden rounded-2xl border border-white/10 aspect-[16/9] flex items-center justify-center p-3 ${p.darkImageContainer ? 'bg-[#061d33]' : 'bg-slate-900/50'}`}>
                    <img
                      src={p.image}
                      alt={`${p.brand} reference visual`}
                      width="400"
                      height="225"
                      loading="lazy"
                      decoding="async"
                      class="max-h-full max-w-full object-contain rounded-lg group-hover:scale-105 transition-transform duration-500"
                    />
                  </div>
                )}

                <div class="space-y-1">
                  <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 block">
                    Contribution
                  </span>
                  <p class="text-base text-slate-200 font-body leading-relaxed font-normal">
                    {p.contribution}
                  </p>
                </div>

              </div>

              <div class="pt-4 mt-5 border-t border-white/10">
                <a
                  href={p.link}
                  class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-[#ff762b] hover:text-white transition-colors"
                >
                  <span>READ DETAILED STORY</span>
                  <ArrowUpRight class="size-3.5" />
                </a>
              </div>

            </div>
          ))}
        </div>

      </div>
    </section>
  )
}

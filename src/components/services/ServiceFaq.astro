---
import type { ServiceDefinition } from '../../data/services';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { ChevronDown } from '@lucide/astro';

export interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
---

<section id="faq" class="py-16 sm:py-20 lg:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 text-center max-w-3xl mx-auto space-y-3">
      <SectionEyebrow label="SERVICE FAQ" align="center" delay={0} />
      <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        Frequently asked questions about {service.name.toLowerCase()}.
      </h2>
      <p class="text-base sm:text-lg text-slate-700 font-body leading-relaxed font-normal">
        Clear answers regarding capabilities, process, assets and scope expectations.
      </p>
    </div>

    <!-- Accordion List -->
    <div class="max-w-4xl mx-auto space-y-4">
      {service.faq.map((item, idx) => (
        <div class="rounded-3xl border border-[#061d33]/12 bg-white overflow-hidden shadow-xs transition-all duration-300">
          <button
            type="button"
            class="service-faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 font-heading font-bold text-lg sm:text-xl text-[#061d33] hover:text-[#ff762b] transition-colors focus:outline-none focus:ring-2 focus:ring-[#ff762b]"
            aria-expanded={idx === 0 ? "true" : "false"}
            aria-controls={`faq-content-${idx}`}
          >
            <span>{item.question}</span>
            <ChevronDown class="size-5 text-slate-500 shrink-0 transition-transform duration-300 transform aria-expanded:rotate-180" />
          </button>
          
          <div
            id={`faq-content-${idx}`}
            class={`px-6 pb-6 text-base text-slate-700 font-body leading-relaxed border-t border-[#061d33]/8 pt-4 ${idx === 0 ? 'block' : 'hidden'}`}
          >
            {item.answer}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<script>
  function setupServiceFaqs() {
    const buttons = document.querySelectorAll('.service-faq-toggle');
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const expanded = btn.getAttribute('aria-expanded') === 'true';
        const targetId = btn.getAttribute('aria-controls');
        if (!targetId) return;

        const target = document.getElementById(targetId);
        if (!target) return;

        btn.setAttribute('aria-expanded', String(!expanded));
        if (expanded) {
          target.classList.add('hidden');
          target.classList.remove('block');
        } else {
          target.classList.remove('hidden');
          target.classList.add('block');
        }
      });
    });
  }

  document.addEventListener('DOMContentLoaded', setupServiceFaqs);
</script>

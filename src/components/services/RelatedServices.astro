---
import { servicesData, type ServiceDefinition } from '../../data/services';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { site } from '../../site.config';
import { ArrowRight } from '@lucide/astro';

export interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;

const relatedList = (service.relatedServiceIds || [])
  .map((id) => servicesData.find((s) => s.id === id))
  .filter(Boolean) as ServiceDefinition[];
---

{
  relatedList.length > 0 && (
    <section id="related-services" class="py-16 sm:py-20 lg:py-24 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
        
        <!-- Section Header -->
        <div class="mb-12 text-center max-w-3xl mx-auto space-y-3">
          <SectionEyebrow label="COMPLEMENTARY CAPABILITIES" align="center" motion={false} />
          <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
            Explore related services often combined with {service.shortName.toLowerCase()}.
          </h2>
        </div>

        <!-- Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
          {relatedList.map((rel) => {
            const targetUrl = `${site.basePath}/services/${rel.slug}/`;

            return (
              <div class="rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:border-[#ff762b]/40 transition-all group">
                <div class="space-y-3">
                  <span class="text-xs font-mono font-bold text-[#ff762b] uppercase tracking-wider block">
                    {rel.eyebrow}
                  </span>
                  <h3 class="font-heading font-bold text-xl text-[#061d33]">
                    {rel.name}
                  </h3>
                  <!-- Mandated >= 16px text-base -->
                  <p class="text-base text-slate-700 font-body leading-relaxed">
                    {rel.summary}
                  </p>
                </div>

                <div class="pt-4 mt-6 border-t border-[#061d33]/8">
                  <a
                    href={targetUrl}
                    class="inline-flex items-center gap-2 text-xs font-mono font-semibold text-[#061d33] group-hover:text-[#ff762b] transition-colors"
                  >
                    <span>VIEW SERVICE DETAILS</span>
                    <ArrowRight class="size-3.5 group-hover:translate-x-1 transition-transform" />
                  </a>
                </div>
              </div>
            );
          })}
        </div>

      </div>
    </section>
  )
}

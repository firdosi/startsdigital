---
import type { ServiceDefinition } from '../../data/services';
import SectionEyebrow from '../common/SectionEyebrow.astro';

export interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
---

<section id="process" class="py-16 sm:py-20 lg:py-24 bg-white text-[#061d33] border-b border-[#061d33]/10 scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 text-center max-w-3xl mx-auto space-y-3">
      <SectionEyebrow label="HOW THE WORK IS ORGANISED" align="center" delay={0} />
      <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        A clear working process from discovery to review.
      </h2>
      <p class="text-base sm:text-lg text-slate-700 font-body leading-relaxed font-normal">
        Each step keeps requirements, responsibilities and deliverables transparent throughout execution.
      </p>
    </div>

    <!-- Process Steps Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {service.process.map((step) => (
        <div class="rounded-3xl border border-[#061d33]/12 bg-[#faf9f6] p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:border-[#ff762b]/40 transition-all">
          <div class="space-y-4">
            <span class="font-mono text-xs font-bold text-[#ff762b] bg-[#ff762b]/10 px-3 py-1 rounded-full w-fit block">
              STEP {step.step}
            </span>

            <h3 class="font-heading font-bold text-xl text-[#061d33] leading-snug">
              {step.title}
            </h3>

            <p class="text-base text-slate-700 font-body leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

---
import type { ServiceDefinition } from '../../data/services';
import SectionEyebrow from '../common/SectionEyebrow.astro';

export interface Props {
  service: ServiceDefinition;
}

const { service } = Astro.props;
const total = service.process.length;

function getGridClasses(idx: number, total: number): string {
  const isTabletOddLast = (total % 2 === 1) && (idx === total - 1);
  const mdClass = isTabletOddLast ? 'md:col-span-2 md:col-start-2' : 'md:col-span-2';

  if (total === 4) {
    return `${mdClass} lg:col-span-3`;
  }

  const rem3 = total % 3;
  let lgClass = 'lg:col-span-2';

  if (rem3 === 1 && idx === total - 1) {
    lgClass = 'lg:col-span-2 lg:col-start-3';
  } else if (rem3 === 2 && idx === total - 2) {
    lgClass = 'lg:col-span-2 lg:col-start-2';
  }

  return `${mdClass} ${lgClass}`;
}
---

<section id="process" class="py-16 sm:py-20 lg:py-24 bg-white text-[#061d33] border-b border-[#061d33]/10 scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 text-center max-w-3xl mx-auto space-y-3">
      <SectionEyebrow label="HOW THE WORK IS ORGANISED" align="center" delay={0} />
      <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        A clear working process from discovery to review.
      </h2>
      <p class="text-base sm:text-lg text-slate-700 font-body leading-relaxed font-normal">
        Each step keeps requirements, responsibilities and deliverables transparent throughout execution.
      </p>
    </div>

    <!-- Adaptive Grid Container -->
    <div id="process-grid-container" class="grid grid-cols-1 md:grid-cols-4 lg:grid-cols-6 gap-6">
      {service.process.map((step, idx) => {
        const gridClass = getGridClasses(idx, total);

        return (
          <div
            data-process-card
            data-card-index={idx}
            class={`${gridClass} rounded-3xl border border-[#061d33]/12 bg-[#faf9f6] p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:border-[#ff762b]/40 transition-all duration-300 h-full group`}
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="font-mono text-xs font-bold text-[#ff762b] bg-[#ff762b]/10 px-3 py-1 rounded-full">
                  STEP {step.step}
                </span>
              </div>

              <h3 class="font-heading font-bold text-xl text-[#061d33] leading-snug">
                {step.title}
              </h3>

              <p class="text-base text-slate-700 font-body leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

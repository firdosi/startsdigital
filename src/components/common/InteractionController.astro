---
// InteractionController.astro — Progressive Accordions & Interactive Controls
---

<script>
  let interactionAbortController: AbortController | null = null;

  function initInteractions() {
    if (interactionAbortController) {
      interactionAbortController.abort();
    }
    interactionAbortController = new AbortController();
    const { signal } = interactionAbortController;

    // ------------------------------------------------------------------
    // 1. FAQ ACCORDION CONTROLLER (<details> & <summary> enhanced)
    // ------------------------------------------------------------------
    const faqList = document.getElementById('faq-list');
    const faqItems = faqList ? Array.from(faqList.querySelectorAll<HTMLDetailsElement>('details.faq-item')) : [];

    faqItems.forEach((details) => {
      const summary = details.querySelector<HTMLElement>('summary[data-faq-toggle]');
      if (!summary) return;

      const icon = details.querySelector<HTMLElement>('[data-faq-icon]');
      const plusIcon = details.querySelector<HTMLElement>('.icon-plus');
      const minusIcon = details.querySelector<HTMLElement>('.icon-minus');

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = details.hasAttribute('open');

        // Close all other FAQ items
        faqItems.forEach((other) => {
          if (other === details) return;
          other.removeAttribute('open');
          const otherSummary = other.querySelector<HTMLElement>('summary[data-faq-toggle]');
          const otherIcon = other.querySelector<HTMLElement>('[data-faq-icon]');
          const otherPlus = other.querySelector<HTMLElement>('.icon-plus');
          const otherMinus = other.querySelector<HTMLElement>('.icon-minus');

          otherSummary?.setAttribute('aria-expanded', 'false');
          other.classList.remove('border-[#ff762b]', 'shadow-md');
          other.classList.add('border-slate-200');

          otherIcon?.classList.remove('bg-[#ff762b]', 'text-white', 'rotate-180');
          otherIcon?.classList.add('bg-[#f7f4ed]', 'text-[#061d33]');

          otherPlus?.classList.remove('hidden');
          otherMinus?.classList.add('hidden');
        });

        // Toggle current FAQ item
        if (isOpen) {
          details.removeAttribute('open');
          summary.setAttribute('aria-expanded', 'false');
          details.classList.remove('border-[#ff762b]', 'shadow-md');
          details.classList.add('border-slate-200');

          icon?.classList.remove('bg-[#ff762b]', 'text-white', 'rotate-180');
          icon?.classList.add('bg-[#f7f4ed]', 'text-[#061d33]');

          plusIcon?.classList.remove('hidden');
          minusIcon?.classList.add('hidden');
        } else {
          details.setAttribute('open', '');
          summary.setAttribute('aria-expanded', 'true');
          details.classList.remove('border-slate-200');
          details.classList.add('border-[#ff762b]', 'shadow-md');

          icon?.classList.remove('bg-[#f7f4ed]', 'text-[#061d33]');
          icon?.classList.add('bg-[#ff762b]', 'text-white', 'rotate-180');

          plusIcon?.classList.add('hidden');
          minusIcon?.classList.remove('hidden');
        }
      }, { signal });
    });

    // ------------------------------------------------------------------
    // 2. WORKING METHOD ACCORDION CONTROLLER (<details> & <summary> enhanced)
    // ------------------------------------------------------------------
    const processItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.accordion-item'));
    const progressLine = document.getElementById('process-progress-line');

    const updateProgressLine = (stageIndex: number) => {
      if (!progressLine) return;
      const percentage = Math.min(100, Math.max(25, (stageIndex + 1) * 25));
      progressLine.style.width = `${percentage}%`;
    };

    processItems.forEach((details, index) => {
      const summary = details.querySelector<HTMLElement>('summary.accordion-toggle');
      if (!summary) return;

      const stepNum = details.querySelector<HTMLElement>('.accordion-step-num');
      const subTitle = details.querySelector<HTMLElement>('.accordion-subtitle');
      const icon = details.querySelector<HTMLElement>('.accordion-icon');
      const subPanels = Array.from(details.querySelectorAll<HTMLElement>('.accordion-wrapper .rounded-2xl'));
      const chips = Array.from(details.querySelectorAll<HTMLElement>('.accordion-wrapper span.font-mono'));

      summary.addEventListener('click', (e) => {
        e.preventDefault();
        const isOpen = details.hasAttribute('open');

        // Section 4 rule: Clicking the active stage must not leave all stages closed!
        if (isOpen) {
          // If already open, keep open so at least one stage remains active
          return;
        }

        // Close other stages
        processItems.forEach((other) => {
          if (other === details) return;
          other.removeAttribute('open');
          const otherSummary = other.querySelector<HTMLElement>('summary.accordion-toggle');
          const otherStepNum = other.querySelector<HTMLElement>('.accordion-step-num');
          const otherSubTitle = other.querySelector<HTMLElement>('.accordion-subtitle');
          const otherIcon = other.querySelector<HTMLElement>('.accordion-icon');
          const otherPanels = Array.from(other.querySelectorAll<HTMLElement>('.accordion-wrapper .rounded-2xl'));
          const otherChips = Array.from(other.querySelectorAll<HTMLElement>('.accordion-wrapper span.font-mono'));

          otherSummary?.setAttribute('aria-expanded', 'false');
          other.classList.remove('border-[#ff762b]', 'bg-[#ff762b]', 'text-white');
          other.classList.add('border-slate-300', 'bg-white', 'text-[#061d33]');

          if (otherStepNum) {
            otherStepNum.classList.remove('bg-white', 'text-[#ff762b]');
            otherStepNum.classList.add('bg-[#061d33]', 'text-white');
          }

          if (otherSubTitle) {
            otherSubTitle.classList.remove('text-white/90');
            otherSubTitle.classList.add('text-slate-600');
          }

          if (otherIcon) {
            otherIcon.classList.remove('bg-white/20', 'text-white', 'rotate-180');
            otherIcon.classList.add('bg-slate-100', 'text-[#061d33]');
          }

          otherPanels.forEach(p => {
            p.classList.remove('bg-white', 'text-[#061d33]', 'border-white/20');
            p.classList.add('bg-[#f7f4ed]', 'text-[#061d33]', 'border-slate-200');
          });

          otherChips.forEach(c => {
            if (c.innerText.startsWith('FOCUS AREAS:')) return;
            c.classList.remove('bg-white', 'text-[#061d33]');
            c.classList.add('bg-[#061d33]', 'text-white');
          });
        });

        // Open clicked stage
        details.setAttribute('open', '');
        summary.setAttribute('aria-expanded', 'true');
        details.classList.remove('border-slate-300', 'bg-white', 'text-[#061d33]');
        details.classList.add('border-[#ff762b]', 'bg-[#ff762b]', 'text-white');

        if (stepNum) {
          stepNum.classList.remove('bg-[#061d33]', 'text-white');
          stepNum.classList.add('bg-white', 'text-[#ff762b]');
        }

        if (subTitle) {
          subTitle.classList.remove('text-slate-600');
          subTitle.classList.add('text-white/90');
        }

        if (icon) {
          icon.classList.remove('bg-slate-100', 'text-[#061d33]');
          icon.classList.add('bg-white/20', 'text-white', 'rotate-180');
        }

        subPanels.forEach(p => {
          p.classList.remove('bg-[#f7f4ed]', 'text-[#061d33]', 'border-slate-200');
          p.classList.add('bg-white', 'text-[#061d33]', 'border-white/20');
        });

        chips.forEach(c => {
          if (c.innerText.startsWith('FOCUS AREAS:')) return;
          c.classList.remove('bg-[#061d33]', 'text-white');
          c.classList.add('bg-white', 'text-[#061d33]');
        });

        updateProgressLine(index);
      }, { signal });
    });
  }

  function cleanupInteractions() {
    if (interactionAbortController) {
      interactionAbortController.abort();
      interactionAbortController = null;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initInteractions);
  } else {
    initInteractions();
  }

  document.addEventListener('astro:before-swap', cleanupInteractions);
  document.addEventListener('astro:page-load', initInteractions);
</script>

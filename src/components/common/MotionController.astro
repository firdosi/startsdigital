---
// MotionController.astro — Idempotent Progressive Motion & Lifecycle Controller
---

<script>
  import { motionTokens } from '../../data/motion';

  let activeObservers: IntersectionObserver[] = [];
  let headerScrollBound = false;

  function cleanupMotionSystem() {
    activeObservers.forEach((obs) => obs.disconnect());
    activeObservers = [];
  }

  function handleHashTarget() {
    const hash = window.location.hash;
    if (!hash || hash.length < 2) return;

    try {
      const target = document.querySelector<HTMLElement>(hash);
      if (target) {
        // Force immediate visibility for target and its children
        target.setAttribute('data-motion-revealed', 'true');
        target.querySelectorAll<HTMLElement>('[data-motion]').forEach((el) => {
          el.setAttribute('data-motion-revealed', 'true');
          el.removeAttribute('data-motion-active');
        });

        // Sticky header clearance scroll
        const headerOffset = 80;
        const elementPosition = target.getBoundingClientRect().top + window.scrollY;
        const offsetPosition = Math.max(0, elementPosition - headerOffset);

        window.scrollTo({
          top: offsetPosition,
          behavior: 'auto'
        });
      }
    } catch (e) {
      // Ignore invalid CSS selector hash
    }
  }

  function isEssentialElement(el: HTMLElement): boolean {
    // Section 5 Essential Content Policy: NEVER hide-first
    if (el.matches('h1, form, #contact-form, #case-study-context-note, input, textarea, label, header, footer, [data-essential="true"]')) {
      return true;
    }
    if (el.closest('h1, form, #contact-form, #case-study-context-note, header, footer, [data-essential="true"]')) {
      return true;
    }
    return false;
  }

  function initMotionSystem() {
    cleanupMotionSystem();
    document.documentElement.classList.add('motion-initialized');

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Handle direct hash navigation first
    handleHashTarget();

    if (prefersReducedMotion) {
      // Reduced-motion users receive 100% visible, stable content immediately
      document.querySelectorAll<HTMLElement>('[data-motion]').forEach((el) => {
        el.setAttribute('data-motion-revealed', 'true');
        el.removeAttribute('data-motion-active');
      });
      return;
    }

    const allMotionElements = Array.from(document.querySelectorAll<HTMLElement>('[data-motion]'));

    if ('IntersectionObserver' in window) {
      const windowHeight = window.innerHeight;

      const motionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const el = entry.target as HTMLElement;
              el.setAttribute('data-motion-revealed', 'true');
              el.removeAttribute('data-motion-active');
              motionObserver.unobserve(el);
            }
          });
        },
        { threshold: 0.05, rootMargin: '50px 0px 50px 0px' }
      );

      allMotionElements.forEach((el) => {
        // Skip essential elements or elements already above the fold
        if (isEssentialElement(el)) {
          el.setAttribute('data-motion-revealed', 'true');
          return;
        }

        const rect = el.getBoundingClientRect();
        if (rect.top < windowHeight + 50 && rect.bottom > -50) {
          // Already in viewport: reveal immediately
          el.setAttribute('data-motion-revealed', 'true');
        } else {
          // Below the fold: activate progressive motion enhancement
          const duration = el.dataset.motionDuration || 'standard';
          const durMs = motionTokens.durations[duration as keyof typeof motionTokens.durations] || 320;
          el.style.setProperty('--motion-dur', `${durMs}ms`);

          const delay = el.dataset.motionDelay || '0';
          el.style.setProperty('--motion-del', `${delay}ms`);

          el.setAttribute('data-motion-active', 'true');
          motionObserver.observe(el);
        }
      });

      activeObservers.push(motionObserver);

      // Section visibility observer for continuous decorative pause
      const sections = document.querySelectorAll<HTMLElement>('section, footer');
      const sectionObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const sec = entry.target as HTMLElement;
            if (entry.isIntersecting) {
              sec.classList.add('is-section-visible');
            } else {
              sec.classList.remove('is-section-visible');
            }
          });
        },
        { threshold: 0.05, rootMargin: '0px' }
      );

      sections.forEach((sec) => sectionObserver.observe(sec));
      activeObservers.push(sectionObserver);
    } else {
      // Fallback if IntersectionObserver not supported
      allMotionElements.forEach((el) => {
        el.setAttribute('data-motion-revealed', 'true');
      });
    }

    // Header Scroll Shadow Controller (Idempotent)
    if (!headerScrollBound) {
      headerScrollBound = true;
      let ticked = false;
      window.addEventListener(
        'scroll',
        () => {
          if (!ticked) {
            requestAnimationFrame(() => {
              const currentHeader = document.getElementById('main-header');
              if (currentHeader) {
                if (window.scrollY > 20) {
                  currentHeader.classList.add('shadow-xl', 'bg-[#061d33]/95', 'backdrop-blur-md');
                } else {
                  currentHeader.classList.remove('shadow-xl', 'bg-[#061d33]/95', 'backdrop-blur-md');
                }
              }
              ticked = false;
            });
            ticked = true;
          }
        },
        { passive: true }
      );
    }

    // Mobile Menu Toggle (Idempotent)
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const drawer = document.getElementById('mobile-menu-drawer');
    const mobileLinks = document.querySelectorAll<HTMLElement>('.mobile-link');

    if (toggleBtn && !toggleBtn.dataset.bound) {
      toggleBtn.dataset.bound = 'true';
      toggleBtn.addEventListener('click', () => {
        const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
        toggleBtn.setAttribute('aria-expanded', String(!isExpanded));

        if (!isExpanded) {
          drawer?.classList.remove('grid-rows-[0fr]', 'opacity-0');
          drawer?.classList.add('grid-rows-[1fr]', 'opacity-100');
        } else {
          drawer?.classList.remove('grid-rows-[1fr]', 'opacity-100');
          drawer?.classList.add('grid-rows-[0fr]', 'opacity-0');
        }
      });

      mobileLinks.forEach((link) => {
        link.addEventListener('click', () => {
          toggleBtn?.setAttribute('aria-expanded', 'false');
          drawer?.classList.remove('grid-rows-[1fr]', 'opacity-100');
          drawer?.classList.add('grid-rows-[0fr]', 'opacity-0');
        });
      });
    }
  }

  // Bind to lifecycle events
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMotionSystem);
  } else {
    initMotionSystem();
  }

  document.addEventListener('astro:before-swap', cleanupMotionSystem);
  document.addEventListener('astro:page-load', initMotionSystem);
</script>

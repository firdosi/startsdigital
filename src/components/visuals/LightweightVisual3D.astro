---
import { 
  Globe, 
  Megaphone, 
  Search, 
  Video, 
  Share2, 
  Bot, 
  ShoppingBag, 
  Calendar, 
  Wrench, 
  Cpu, 
  MessageSquare, 
  Mail, 
  FileText, 
  Layers,
  Sparkles,
  BarChart2,
  Code
} from '@lucide/astro';

interface Props {
  type: 'hero-3d' | 'work-dashboard' | 'service-ad' | 'service-web' | 'service-seo' | 'service-creative' | 'service-social' | 'service-ai' | 'industry-ecommerce' | 'industry-seasonal' | 'industry-local' | 'industry-tech' | 'about-collaboration' | 'contact-flow';
  class?: string;
}

const { type, class: className = '' } = Astro.props;
---

<div class={`relative select-none pointer-events-none ${className}`}>
  {type === 'hero-3d' && (
    <div class="relative w-full max-w-[540px] aspect-[4/3] mx-auto perspective-1000">
      <!-- Ambient Gradient Backlight -->
      <div class="absolute -inset-4 bg-gradient-to-tr from-[#ff762b]/20 via-[#ddff35]/15 to-[#38bdf8]/20 rounded-full blur-2xl opacity-70"></div>

      <!-- Glass Browser Window Mockup -->
      <div class="absolute inset-x-4 top-4 bottom-8 rounded-2xl border border-white/20 bg-[#061d33]/80 backdrop-blur-md p-4 shadow-2xl transform rotate-x-6 -rotate-y-6 hover:rotate-0 transition-transform duration-700 space-y-3">
        <!-- Browser Top Bar -->
        <div class="flex items-center justify-between border-b border-white/10 pb-3">
          <div class="flex items-center gap-1.5">
            <span class="size-2.5 rounded-full bg-red-400"></span>
            <span class="size-2.5 rounded-full bg-yellow-400"></span>
            <span class="size-2.5 rounded-full bg-green-400"></span>
          </div>
          <div class="h-4 w-40 rounded-full bg-white/10 text-[9px] font-mono text-slate-300 flex items-center justify-center">
            Starts Digital
          </div>
          <Sparkles class="size-3.5 text-[#ddff35]" />
        </div>

        <!-- Inner Composition Grid -->
        <div class="grid grid-cols-2 gap-3 h-[calc(100%-36px)]">
          <div class="rounded-xl border border-white/10 bg-white/5 p-3 space-y-2 flex flex-col justify-between">
            <div class="flex items-center gap-2 text-[#ff762b]">
              <Megaphone class="size-4" />
              <span class="font-mono text-[10px] text-white font-bold uppercase">Meta & TikTok Ads</span>
            </div>
            <div class="space-y-1">
              <div class="h-2 w-3/4 rounded bg-white/20"></div>
              <div class="h-2 w-1/2 rounded bg-white/10"></div>
            </div>
            <div class="h-6 rounded-lg bg-[#ff762b]/20 border border-[#ff762b]/30 flex items-center justify-center font-mono text-[9px] text-[#ff762b]">
              Paid Advertising
            </div>
          </div>

          <div class="rounded-xl border border-white/10 bg-white/5 p-3 space-y-2 flex flex-col justify-between">
            <div class="flex items-center gap-2 text-[#38bdf8]">
              <Globe class="size-4" />
              <span class="font-mono text-[10px] text-white font-bold uppercase">Astro Web Platform</span>
            </div>
            <div class="flex items-end justify-between h-12 pt-2">
              <div class="w-2 h-6 bg-sky-400/40 rounded-t"></div>
              <div class="w-2 h-9 bg-sky-400/60 rounded-t"></div>
              <div class="w-2 h-12 bg-[#38bdf8] rounded-t"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Floating 3D Badge 1: AI Workflow Node -->
      <div class="absolute -bottom-2 -left-2 rounded-2xl border border-white/20 bg-[#0c2a4a]/90 backdrop-blur-md p-3 shadow-xl flex items-center gap-3 transform translate-z-12 hover:scale-105 transition-transform duration-300">
        <div class="size-9 rounded-xl bg-[#ddff35] text-[#061d33] flex items-center justify-center font-bold">
          <Bot class="size-5" />
        </div>
        <div>
          <span class="font-mono text-[10px] uppercase text-slate-300 block">AI Avatar Node</span>
          <span class="font-heading text-xs font-bold text-white">27+ AI Characters Created</span>
        </div>
      </div>

      <!-- Floating 3D Badge 2: Local Search Card -->
      <div class="absolute -top-3 -right-2 rounded-2xl border border-white/20 bg-[#0c2a4a]/90 backdrop-blur-md p-3 shadow-xl flex items-center gap-3 transform translate-z-12 hover:scale-105 transition-transform duration-300">
        <div class="size-9 rounded-xl bg-[#39c98a] text-white flex items-center justify-center font-bold">
          <Search class="size-5" />
        </div>
        <div>
          <span class="font-mono text-[10px] uppercase text-slate-300 block">Local SEO Rank</span>
          <span class="font-heading text-xs font-bold text-white">SEO & Local Search</span>
        </div>
      </div>
    </div>
  )}

  {type === 'work-dashboard' && (
    <div class="relative w-full max-w-[500px] aspect-[16/10] mx-auto rounded-3xl border border-white/15 bg-white/5 p-6 backdrop-blur-md shadow-2xl flex flex-col justify-between">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <div class="flex items-center gap-3">
          <div class="size-8 rounded-xl bg-[#ff762b] text-white flex items-center justify-center">
            <BarChart2 class="size-4" />
          </div>
          <div>
            <div class="font-heading text-sm font-bold text-white">Combined Performance Hub</div>
            <span class="font-mono text-[10px] text-slate-400">Aggregate Client Results</span>
          </div>
        </div>
        <span class="font-mono text-xs px-2.5 py-1 rounded-full bg-[#ddff35]/20 text-[#ddff35] border border-[#ddff35]/30">
          Active System
        </span>
      </div>

      <div class="grid grid-cols-3 gap-3 my-4">
        <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
          <span class="font-mono text-[9px] uppercase text-slate-400 block">Units Sold</span>
          <span class="font-heading font-bold text-lg text-white">5,000+</span>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
          <span class="font-mono text-[9px] uppercase text-slate-400 block">Campaign Sales</span>
          <span class="font-heading font-bold text-lg text-[#ff762b]">PKR 5.9M+</span>
        </div>
        <div class="rounded-xl border border-white/10 bg-white/5 p-3 text-center">
          <span class="font-mono text-[9px] uppercase text-slate-400 block">Avg Lead Cost</span>
          <span class="font-heading font-bold text-lg text-[#39c98a]">AED 0.10</span>
        </div>
      </div>

      <div class="h-2 rounded-full bg-white/10 overflow-hidden">
        <div class="h-full w-4/5 bg-gradient-to-r from-[#ff762b] via-[#ddff35] to-[#39c98a] rounded-full"></div>
      </div>
    </div>
  )}

  {type === 'service-ad' && (
    <div class="size-14 rounded-2xl bg-gradient-to-tr from-[#ff762b] to-[#ff985c] text-white flex items-center justify-center shadow-lg transform hover:scale-105 transition-transform">
      <Megaphone class="size-7" />
    </div>
  )}

  {type === 'service-web' && (
    <div class="size-14 rounded-2xl bg-gradient-to-tr from-[#38bdf8] to-[#0284c7] text-white flex items-center justify-center shadow-lg transform hover:scale-105 transition-transform">
      <Globe class="size-7" />
    </div>
  )}

  {type === 'service-seo' && (
    <div class="size-14 rounded-2xl bg-gradient-to-tr from-[#39c98a] to-[#059669] text-white flex items-center justify-center shadow-lg transform hover:scale-105 transition-transform">
      <Search class="size-7" />
    </div>
  )}

  {type === 'service-creative' && (
    <div class="size-14 rounded-2xl bg-gradient-to-tr from-[#a855f7] to-[#7e22ce] text-white flex items-center justify-center shadow-lg transform hover:scale-105 transition-transform">
      <Video class="size-7" />
    </div>
  )}

  {type === 'service-social' && (
    <div class="size-14 rounded-2xl bg-gradient-to-tr from-[#ec4899] to-[#be185d] text-white flex items-center justify-center shadow-lg transform hover:scale-105 transition-transform">
      <Share2 class="size-7" />
    </div>
  )}

  {type === 'service-ai' && (
    <div class="size-14 rounded-2xl bg-gradient-to-tr from-[#ddff35] to-[#84cc16] text-[#061d33] flex items-center justify-center shadow-lg transform hover:scale-105 transition-transform">
      <Bot class="size-7" />
    </div>
  )}

  {type === 'industry-ecommerce' && (
    <div class="size-16 rounded-3xl bg-[#ff762b]/15 border-2 border-[#ff762b] text-[#ff762b] flex items-center justify-center shadow-xl">
      <ShoppingBag class="size-8" />
    </div>
  )}

  {type === 'industry-seasonal' && (
    <div class="size-16 rounded-3xl bg-[#ddff35]/15 border-2 border-[#ddff35] text-[#ddff35] flex items-center justify-center shadow-xl">
      <Calendar class="size-8" />
    </div>
  )}

  {type === 'industry-local' && (
    <div class="size-16 rounded-3xl bg-[#39c98a]/15 border-2 border-[#39c98a] text-[#39c98a] flex items-center justify-center shadow-xl">
      <Wrench class="size-8" />
    </div>
  )}

  {type === 'industry-tech' && (
    <div class="size-16 rounded-3xl bg-[#38bdf8]/15 border-2 border-[#38bdf8] text-[#38bdf8] flex items-center justify-center shadow-xl">
      <Cpu class="size-8" />
    </div>
  )}

  {type === 'about-collaboration' && (
    <div class="relative w-full max-w-[480px] aspect-[4/3] mx-auto rounded-3xl border border-slate-200 bg-white p-6 shadow-xl space-y-4">
      <div class="flex items-center gap-3 border-b pb-4">
        <div class="size-10 rounded-2xl bg-[#061d33] text-white flex items-center justify-center">
          <Layers class="size-5" />
        </div>
        <div>
          <div class="font-heading font-bold text-base text-[#061d33]">Integrated Agency Model</div>
          <span class="text-xs text-slate-500 font-mono">Strategy • Creative • Web • AI</span>
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div class="rounded-2xl border p-4 bg-slate-50">
          <span class="text-xs font-mono font-bold text-[#ff762b] block">CREATIVE LAB</span>
          <span class="text-sm font-heading font-semibold text-[#061d33]">Video & Graphics</span>
        </div>
        <div class="rounded-2xl border p-4 bg-slate-50">
          <span class="text-xs font-mono font-bold text-[#38bdf8] block">ENGINEERING</span>
          <span class="text-sm font-heading font-semibold text-[#061d33]">Astro & AI Apps</span>
        </div>
      </div>
    </div>
  )}

  {type === 'contact-flow' && (
    <div class="relative w-full max-w-[420px] aspect-square mx-auto rounded-3xl border border-[#061d33]/15 bg-white p-6 shadow-2xl flex flex-col justify-between">
      <div class="flex items-center gap-3">
        <div class="size-10 rounded-2xl bg-[#39c98a] text-white flex items-center justify-center">
          <MessageSquare class="size-5" />
        </div>
        <div>
          <div class="font-heading font-bold text-base text-[#061d33]">Direct Inquiry Routing</div>
          <span class="text-xs text-slate-500 font-mono">WhatsApp & Email Dispatch</span>
        </div>
      </div>
      <div class="space-y-3 my-4">
        <div class="rounded-2xl border border-slate-200 p-3 flex items-center gap-3 bg-slate-50">
          <Mail class="size-4 text-[#ff762b]" />
          <span class="text-xs font-mono text-slate-700">Project Brief Document</span>
        </div>
        <div class="rounded-2xl border border-slate-200 p-3 flex items-center gap-3 bg-slate-50">
          <FileText class="size-4 text-[#39c98a]" />
          <span class="text-xs font-mono text-slate-700">Service Goal Allowlist</span>
        </div>
      </div>
      <div class="h-10 rounded-2xl bg-[#061d33] text-white flex items-center justify-center font-mono text-xs uppercase tracking-wider font-bold">
        Send Brief
      </div>
    </div>
  )}
</div>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
  .rotate-x-6 {
    transform: rotateX(6deg);
  }
  .-rotate-y-6 {
    transform: rotateY(-6deg);
  }
  .translate-z-12 {
    transform: translateZ(12px);
  }

  @media (prefers-reduced-motion: reduce) {
    div {
      transform: none !important;
      transition: none !important;
    }
  }
</style>

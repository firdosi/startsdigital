---
import { ShoppingBag, Package, Tag, Calendar, Clock, Award, MapPin, Wrench, Search, Laptop, Cpu, Layers, Sparkles, Home, CreditCard, Compass } from '@lucide/astro';
---

<div class="relative w-full max-w-[500px] aspect-square mx-auto perspective-1000 select-none py-4" id="industries-3d-composition">
  <!-- Ambient Backlight -->
  <div class="absolute inset-6 bg-radial-gradient from-[#ff762b]/20 via-[#39c98a]/15 to-transparent rounded-full blur-3xl opacity-70"></div>

  <!-- Central Core Object -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 size-28 sm:size-36 rounded-3xl border-2 border-white/25 bg-gradient-to-br from-[#0c2a4a] to-[#061d33] backdrop-blur-xl shadow-2xl p-4 flex flex-col items-center justify-center text-center space-y-1.5 z-10 transform hover:scale-110 transition-transform duration-300">
    <div class="size-10 rounded-2xl bg-[#ff762b]/20 border border-[#ff762b]/40 flex items-center justify-center">
      <Sparkles class="size-6 text-[#ff762b]" />
    </div>
    <span class="font-heading font-bold text-sm sm:text-base text-white leading-tight">Industry Models</span>
    <span class="font-mono text-[10px] text-slate-300">4 Sector Compositions</span>
  </div>

  <!-- 4 Distinct Physical 3D Sector Objects -->

  <!-- 1. E-Commerce Sector: Product Box, Shopping Bag, Storefront Tag & Checkout -->
  <div class="absolute top-2 left-2 sm:top-4 sm:left-4 z-20 group">
    <div class="relative p-3.5 sm:p-4 rounded-3xl border-2 border-[#ff762b]/40 bg-[#0a233c]/95 backdrop-blur-xl shadow-2xl transform transition-transform duration-300 group-hover:-translate-y-1.5 group-hover:scale-105">
      <div class="flex items-center gap-3">
        <div class="relative size-14 shrink-0 rounded-2xl bg-gradient-to-br from-[#ff762b] to-[#e56017] p-2.5 shadow-lg flex items-center justify-center transform -rotate-6">
          <Package class="size-8 text-white stroke-[2]" />
          <div class="absolute -top-2 -right-2 size-6 rounded-xl bg-[#061d33] border-2 border-[#ff762b] flex items-center justify-center shadow-md">
            <ShoppingBag class="size-3 text.white" />
          </div>
          <div class="absolute -bottom-2 -left-2 size-6 rounded-xl bg-[#ddff35] text-[#061d33] flex items-center justify-center shadow-sm">
            <Tag class="size-3.5 stroke-[2.5]" />
          </div>
          <div class="absolute -bottom-1 -right-2 size-5 rounded-lg bg-[#061d33] border border-white/30 text-[#38bdf8] flex items-center justify-center">
            <CreditCard class="size-3" />
          </div>
        </div>
        <div>
          <span class="font-heading text-xs font-bold text-white block">E-Commerce</span>
          <span class="font-mono text-[10px] text-[#ff762b] block mt-0.5">Storefront & Checkout</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 2. Seasonal Campaigns: Calendar Block, Countdown Dial & Promo Badge -->
  <div class="absolute top-2 right-2 sm:top-4 sm:right-4 z-20 group">
    <div class="relative p-3.5 sm:p-4 rounded-3xl border-2 border-[#ddff35]/40 bg-[#0a233c]/95 backdrop-blur-xl shadow-2xl transform transition-transform duration-300 group-hover:-translate-y-1.5 group-hover:scale-105">
      <div class="flex items-center gap-3">
        <div class="relative size-14 shrink-0 rounded-2xl bg-gradient-to-br from-[#ddff35] to-[#bce600] p-2.5 shadow-lg flex items-center justify-center transform rotate-6">
          <Calendar class="size-8 text-[#061d33] stroke-[2]" />
          <div class="absolute -top-2 -right-2 size-6 rounded-xl bg-[#061d33] border-2 border-[#ddff35] flex items-center justify-center shadow-md">
            <Clock class="size-3 text-[#ddff35]" />
          </div>
          <div class="absolute -bottom-2 -left-2 size-6 rounded-xl bg-[#ff762b] text-white flex items-center justify-center shadow-sm">
            <Award class="size-3.5 stroke-[2.5]" />
          </div>
        </div>
        <div>
          <span class="font-heading text-xs font-bold text-white block">Seasonal Campaigns</span>
          <span class="font-mono text-[10px] text-[#ddff35] block mt-0.5">Promotional Windows</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. Local Services: Property Visual, Map Pin & Contractor Tools -->
  <div class="absolute bottom-2 left-2 sm:bottom-4 sm:left-4 z-20 group">
    <div class="relative p-3.5 sm:p-4 rounded-3xl border-2 border-[#39c98a]/40 bg-[#0a233c]/95 backdrop-blur-xl shadow-2xl transform transition-transform duration-300 group-hover:-translate-y-1.5 group-hover:scale-105">
      <div class="flex items-center gap-3">
        <div class="relative size-14 shrink-0 rounded-2xl bg-gradient-to-br from-[#39c98a] to-[#2ea06d] p-2.5 shadow-lg flex items-center justify-center transform rotate-3">
          <MapPin class="size-8 text-white stroke-[2]" />
          <div class="absolute -top-2 -right-2 size-6 rounded-xl bg-[#061d33] border-2 border-[#39c98a] flex items-center justify-center shadow-md">
            <Wrench class="size-3 text-[#39c98a]" />
          </div>
          <div class="absolute -bottom-2 -left-2 size-6 rounded-xl bg-[#061d33] border border-white/30 text-[#ddff35] flex items-center justify-center shadow-sm">
            <Home class="size-3.5 stroke-[2]" />
          </div>
        </div>
        <div>
          <span class="font-heading text-xs font-bold text-white block">Local Services</span>
          <span class="font-mono text-[10px] text-[#39c98a] block mt-0.5">Map & Location Radius</span>
        </div>
      </div>
    </div>
  </div>

  <!-- 4. Technology & SaaS: Laptop, App Modules & Connected Nodes -->
  <div class="absolute bottom-2 right-2 sm:bottom-4 sm:right-4 z-20 group">
    <div class="relative p-3.5 sm:p-4 rounded-3xl border-2 border-[#38bdf8]/40 bg-[#0a233c]/95 backdrop-blur-xl shadow-2xl transform transition-transform duration-300 group-hover:-translate-y-1.5 group-hover:scale-105">
      <div class="flex items-center gap-3">
        <div class="relative size-14 shrink-0 rounded-2xl bg-gradient-to-br from-[#38bdf8] to-[#0284c7] p-2.5 shadow-lg flex items-center justify-center transform -rotate-3">
          <Laptop class="size-8 text-white stroke-[2]" />
          <div class="absolute -top-2 -right-2 size-6 rounded-xl bg-[#061d33] border-2 border-[#38bdf8] flex items-center justify-center shadow-md">
            <Cpu class="size-3 text-[#38bdf8]" />
          </div>
          <div class="absolute -bottom-2 -left-2 size-6 rounded-xl bg-[#061d33] border border-white/30 text-[#38bdf8] flex items-center justify-center shadow-sm">
            <Layers class="size-3.5 stroke-[2]" />
          </div>
        </div>
        <div>
          <span class="font-heading text-xs font-bold text-white block">Technology & SaaS</span>
          <span class="font-mono text-[10px] text-[#38bdf8] block mt-0.5">Product Modules & Apps</span>
        </div>
      </div>
    </div>
  </div>

</div>

<style>
  .perspective-1000 {
    perspective: 1000px;
  }
</style>

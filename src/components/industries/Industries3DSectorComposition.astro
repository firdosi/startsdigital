---
import { ShoppingBag, Package, Tag, Calendar, Clock, Award, MapPin, Wrench, Laptop, Cpu, Layers, Home, CreditCard } from '@lucide/astro';
import { site } from '../../site.config';
---

<div class="w-full max-w-[480px] mx-auto select-none py-4" id="industries-3d-composition">
  <!-- 2x2 Sector Visual Object Grid -->
  <div class="grid grid-cols-2 gap-4 sm:gap-5">

    <!-- 1. E-Commerce Sector: Product Box, Shopping Bag, Storefront Tag & Checkout -->
    <a
      href={`${site.basePath}/industries/ecommerce-product-brands/`}
      class="group block p-4 sm:p-5 rounded-3xl border border-[#ff762b]/30 bg-[#0a233c]/90 backdrop-blur-xl shadow-xl hover:border-[#ff762b] hover:bg-[#0c2a4a] hover:-translate-y-1 transition-all duration-300"
    >
      <div class="flex flex-col items-center text-center space-y-3">
        <!-- 3D Physical Assembly -->
        <div class="relative size-16 rounded-2xl bg-gradient-to-br from-[#ff762b] to-[#e56017] p-3 shadow-lg flex items-center justify-center transform -rotate-3 group-hover:rotate-0 transition-transform duration-300">
          <Package class="size-9 text-white stroke-[2]" />
          <div class="absolute -top-2 -right-2 size-6 rounded-xl bg-[#061d33] border border-[#ff762b] flex items-center justify-center shadow-md">
            <ShoppingBag class="size-3 text-white" />
          </div>
          <div class="absolute -bottom-2 -left-2 size-6 rounded-xl bg-[#ddff35] text-[#061d33] flex items-center justify-center shadow-sm">
            <Tag class="size-3.5 stroke-[2.5]" />
          </div>
          <div class="absolute -bottom-1 -right-2 size-5 rounded-lg bg-[#061d33] border border-white/30 text-[#38bdf8] flex items-center justify-center">
            <CreditCard class="size-3" />
          </div>
        </div>
        <div>
          <span class="font-heading text-sm font-bold text-white block group-hover:text-[#ff762b] transition-colors">E-Commerce</span>
          <span class="font-mono text-[11px] text-[#ff762b] block mt-0.5 font-medium">Storefront & Checkout</span>
        </div>
      </div>
    </a>

    <!-- 2. Seasonal Campaigns: Calendar Block, Countdown Dial & Promo Badge -->
    <a
      href={`${site.basePath}/industries/seasonal-campaigns/`}
      class="group block p-4 sm:p-5 rounded-3xl border border-[#ddff35]/30 bg-[#0a233c]/90 backdrop-blur-xl shadow-xl hover:border-[#ddff35] hover:bg-[#0c2a4a] hover:-translate-y-1 transition-all duration-300"
    >
      <div class="flex flex-col items-center text-center space-y-3">
        <!-- 3D Physical Assembly -->
        <div class="relative size-16 rounded-2xl bg-gradient-to-br from-[#ddff35] to-[#bce600] p-3 shadow-lg flex items-center justify-center transform rotate-3 group-hover:rotate-0 transition-transform duration-300">
          <Calendar class="size-9 text-[#061d33] stroke-[2]" />
          <div class="absolute -top-2 -right-2 size-6 rounded-xl bg-[#061d33] border border-[#ddff35] flex items-center justify-center shadow-md">
            <Clock class="size-3 text-[#ddff35]" />
          </div>
          <div class="absolute -bottom-2 -left-2 size-6 rounded-xl bg-[#ff762b] text-white flex items-center justify-center shadow-sm">
            <Award class="size-3.5 stroke-[2.5]" />
          </div>
        </div>
        <div>
          <span class="font-heading text-sm font-bold text-white block group-hover:text-[#ddff35] transition-colors">Seasonal Campaigns</span>
          <span class="font-mono text-[11px] text-[#ddff35] block mt-0.5 font-medium">Promotional Windows</span>
        </div>
      </div>
    </a>

    <!-- 3. Local Services: Property Visual, Map Pin & Contractor Tools -->
    <a
      href={`${site.basePath}/industries/local-service-businesses/`}
      class="group block p-4 sm:p-5 rounded-3xl border border-[#39c98a]/30 bg-[#0a233c]/90 backdrop-blur-xl shadow-xl hover:border-[#39c98a] hover:bg-[#0c2a4a] hover:-translate-y-1 transition-all duration-300"
    >
      <div class="flex flex-col items-center text-center space-y-3">
        <!-- 3D Physical Assembly -->
        <div class="relative size-16 rounded-2xl bg-gradient-to-br from-[#39c98a] to-[#2ea06d] p-3 shadow-lg flex items-center justify-center transform rotate-3 group-hover:rotate-0 transition-transform duration-300">
          <MapPin class="size-9 text-white stroke-[2]" />
          <div class="absolute -top-2 -right-2 size-6 rounded-xl bg-[#061d33] border border-[#39c98a] flex items-center justify-center shadow-md">
            <Wrench class="size-3 text-[#39c98a]" />
          </div>
          <div class="absolute -bottom-2 -left-2 size-6 rounded-xl bg-[#061d33] border border-white/30 text-[#ddff35] flex items-center justify-center shadow-sm">
            <Home class="size-3.5 stroke-[2]" />
          </div>
        </div>
        <div>
          <span class="font-heading text-sm font-bold text-white block group-hover:text-[#39c98a] transition-colors">Local Services</span>
          <span class="font-mono text-[11px] text-[#39c98a] block mt-0.5 font-medium">Location Radius & Maps</span>
        </div>
      </div>
    </a>

    <!-- 4. Technology & SaaS: Laptop, App Modules & Connected Nodes -->
    <a
      href={`${site.basePath}/industries/technology-products/`}
      class="group block p-4 sm:p-5 rounded-3xl border border-[#38bdf8]/30 bg-[#0a233c]/90 backdrop-blur-xl shadow-xl hover:border-[#38bdf8] hover:bg-[#0c2a4a] hover:-translate-y-1 transition-all duration-300"
    >
      <div class="flex flex-col items-center text-center space-y-3">
        <!-- 3D Physical Assembly -->
        <div class="relative size-16 rounded-2xl bg-gradient-to-br from-[#38bdf8] to-[#0284c7] p-3 shadow-lg flex items-center justify-center transform -rotate-3 group-hover:rotate-0 transition-transform duration-300">
          <Laptop class="size-9 text-white stroke-[2]" />
          <div class="absolute -top-2 -right-2 size-6 rounded-xl bg-[#061d33] border border-[#38bdf8] flex items-center justify-center shadow-md">
            <Cpu class="size-3 text-[#38bdf8]" />
          </div>
          <div class="absolute -bottom-2 -left-2 size-6 rounded-xl bg-[#061d33] border border-white/30 text-[#38bdf8] flex items-center justify-center shadow-sm">
            <Layers class="size-3.5 stroke-[2]" />
          </div>
        </div>
        <div>
          <span class="font-heading text-sm font-bold text-white block group-hover:text-[#38bdf8] transition-colors">Technology & SaaS</span>
          <span class="font-mono text-[11px] text-[#38bdf8] block mt-0.5 font-medium">Product Modules & Apps</span>
        </div>
      </div>
    </a>

  </div>
</div>

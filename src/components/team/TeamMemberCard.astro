---
import type { TeamMember } from '../../data/team';
import { ExternalLink } from '@lucide/astro';

export interface Props {
  member: TeamMember;
  variant?: 'homepage' | 'about';
  showResponsibilities?: boolean;
  showLinkedIn?: boolean;
  showMemberLabel?: boolean;
  class?: string;
}

const {
  member,
  variant = 'homepage',
  showResponsibilities = true,
  showLinkedIn = true,
  showMemberLabel = false,
  class: className = ''
} = Astro.props;

const isAbout = variant === 'about';
---

<article
  class={`rounded-3xl border border-[#061d33]/12 bg-white p-4 sm:p-7 shadow-xs flex flex-col justify-between group hover:border-[#ff762b]/40 transition-all duration-300 ${className}`}
>
  <div class="space-y-3 sm:space-y-4">
    
    <!-- Render Photograph ONLY if member.image exists and member.imageApproved is true -->
    {member.image && member.imageApproved && (
      <div class="mb-3 sm:mb-4 overflow-hidden rounded-2xl border border-[#061d33]/10 bg-slate-100 aspect-4/3">
        <img
          src={member.image}
          alt={`${member.name} - ${member.role} at Starts Digital`}
          width="400"
          height="300"
          loading="lazy"
          decoding="async"
          class="size-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      </div>
    )}

    <!-- Identity & Social Link Header -->
    <div class="space-y-1.5 sm:space-y-2">
      {showMemberLabel && (
        <span class="text-[10px] sm:text-xs font-mono font-bold text-[#ff762b] uppercase tracking-wider block">
          TEAM MEMBER
        </span>
      )}

      <!-- Name and Role / Social Control Layout -->
      <div class={isAbout ? "space-y-2 sm:space-y-3" : "space-y-2 lg:space-y-0 lg:flex lg:items-start lg:justify-between lg:gap-3"}>
        <div>
          <h3 class={`font-heading font-bold text-[#061d33] ${isAbout ? 'text-xl sm:text-3xl' : 'text-xl sm:text-2xl'}`}>
            {member.name}
          </h3>
          <p class="font-mono text-[11px] sm:text-xs text-[#ff762b] font-semibold uppercase tracking-wider mt-0.5 sm:mt-1">
            {member.role}
          </p>
        </div>

        {showLinkedIn && member.linkedin && (
          <div class={isAbout ? "pt-0.5 sm:pt-1" : "pt-1 lg:pt-0 shrink-0"}>
            <a
              href={member.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`View ${member.name} on LinkedIn`}
              class={
                isAbout
                  ? "inline-flex items-center gap-1.5 min-h-[44px] rounded-full bg-[#0077b5] px-3 py-1 text-xs font-body font-semibold text-white hover:bg-[#006097] transition-all shadow-xs"
                  : "inline-flex items-center gap-1.5 min-h-[44px] rounded-full bg-[#f7f4ed] px-3 py-1 text-xs font-mono font-semibold text-[#061d33] hover:bg-[#061d33] hover:text-white transition-colors border border-[#061d33]/10"
              }
            >
              <svg class={`size-3.5 ${isAbout ? 'fill-white' : 'fill-[#0077b5] group-hover:fill-white'}`} viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
              </svg>
              <span>{isAbout ? `View ${member.name} on LinkedIn` : 'LinkedIn'}</span>
              <ExternalLink class="size-3" />
            </a>
          </div>
        )}
      </div>
    </div>

    <!-- Biography (Approved Bio) -->
    <p class="text-sm sm:text-base text-slate-700 font-body leading-relaxed">
      {!isAbout && member.homepageBio ? member.homepageBio : member.shortBio}
    </p>

  </div>

  <!-- Responsibilities Tags -->
  {showResponsibilities && member.responsibilities && member.responsibilities.length > 0 && (
    <div class="pt-2.5 mt-3 sm:pt-4 sm:mt-6 border-t border-[#061d33]/8">
      <span class="text-[10px] sm:text-[11px] font-mono font-semibold text-slate-400 uppercase tracking-wider block mb-1.5 sm:mb-2">
        Primary Focus
      </span>
      <div class="flex flex-wrap gap-1.5">
        {member.responsibilities.map((r) => (
          <span class="text-xs font-mono bg-[#f7f4ed] text-[#061d33] px-2.5 py-1 rounded-lg border border-[#061d33]/10 font-medium">
            {r}
          </span>
        ))}
      </div>
    </div>
  )}
</article>

---
import { site } from '../../site.config';
import { getSeoForPath, getCanonicalUrl } from '../../data/seo';
import { services } from '../../data/services';
import { projectRecords } from '../../data/projects';
import { teamMembers } from '../../data/team';
import { companyProfile } from '../../data/company';

interface Props {
  schemaType?: string;
}

const pathname = Astro.url.pathname;
const seoConfig = getSeoForPath(pathname);

const resolvedSchemaType = Astro.props.schemaType || seoConfig.schemaType || 'page';
const canonicalUrl = getCanonicalUrl(pathname);

// 1. Organization Schema
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.siteUrl}/#organization`,
  name: companyProfile.name,
  foundingDate: '2025',
  description: companyProfile.locationStatement,
  url: `${site.siteUrl}/`,
  logo: `${site.siteUrl}/favicon.svg`,
  email: site.email,
  telephone: site.phone,
  areaServed: ['Pakistan', 'International'],
  knowsAbout: companyProfile.services,
};

// 2. WebSite Schema
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${site.siteUrl}/#website`,
  url: `${site.siteUrl}/`,
  name: companyProfile.name,
  description: site.defaultDescription,
  publisher: {
    '@id': `${site.siteUrl}/#organization`,
  },
};

// 3. Breadcrumb Schema (with exact central labels)
function buildBreadcrumbs() {
  const items = [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: `${site.siteUrl}/`,
    },
  ];

  if (pathname === '/' || pathname === site.basePath || pathname === `${site.basePath}/`) {
    return items;
  }

  const cleanPath = pathname.replace(site.basePath, '').replace(/^\/+|\/+$/g, '');
  const segments = cleanPath.split('/').filter(Boolean);

  if (segments.length === 1) {
    items.push({
      '@type': 'ListItem',
      position: 2,
      name: seoConfig.breadcrumbLabel || 'Page',
      item: canonicalUrl,
    });
  } else if (segments.length === 2) {
    const parentPath = `/${segments[0]}/`;
    const parentSeo = getSeoForPath(parentPath);
    items.push({
      '@type': 'ListItem',
      position: 2,
      name: parentSeo.breadcrumbLabel || segments[0],
      item: getCanonicalUrl(parentPath),
    });
    items.push({
      '@type': 'ListItem',
      position: 3,
      name: seoConfig.breadcrumbLabel || segments[1],
      item: canonicalUrl,
    });
  }

  return items;
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: buildBreadcrumbs(),
};

// Assemble schemas based on route schemaType
const schemas: any[] = [];

if (resolvedSchemaType === 'homepage') {
  schemas.push(orgSchema, websiteSchema, {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${canonicalUrl}#webpage`,
    url: canonicalUrl,
    name: seoConfig.title,
    description: seoConfig.description,
    publisher: { '@id': `${site.siteUrl}/#organization` },
  });
} else if (resolvedSchemaType === 'about') {
  const persons = teamMembers.map((m) => ({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: m.name,
    jobTitle: m.role,
    worksFor: { '@id': `${site.siteUrl}/#organization` },
    ...(m.linkedin ? { sameAs: [m.linkedin] } : {}),
  }));

  schemas.push(
    orgSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'AboutPage',
      '@id': `${canonicalUrl}#aboutpage`,
      url: canonicalUrl,
      name: seoConfig.title,
      description: seoConfig.description,
      publisher: { '@id': `${site.siteUrl}/#organization` },
    },
    breadcrumbSchema,
    ...persons
  );
} else if (resolvedSchemaType === 'contact') {
  schemas.push(
    orgSchema,
    {
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      '@id': `${canonicalUrl}#contactpage`,
      url: canonicalUrl,
      name: seoConfig.title,
      description: seoConfig.description,
      publisher: { '@id': `${site.siteUrl}/#organization` },
    },
    breadcrumbSchema
  );
} else if (resolvedSchemaType === 'services-index') {
  schemas.push(
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#collection`,
      url: canonicalUrl,
      name: seoConfig.title,
      description: seoConfig.description,
      publisher: { '@id': `${site.siteUrl}/#organization` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: services.map((s, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: s.name,
          url: getCanonicalUrl(`/services/${s.slug}/`),
        })),
      },
    },
    breadcrumbSchema
  );
} else if (resolvedSchemaType === 'service') {
  const currentService = services.find((s) => s.id === seoConfig.serviceId);
  schemas.push(
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: currentService ? currentService.name : seoConfig.title,
      description: seoConfig.description,
      provider: { '@id': `${site.siteUrl}/#organization` },
      url: canonicalUrl,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: seoConfig.title,
      description: seoConfig.description,
    },
    breadcrumbSchema
  );
} else if (resolvedSchemaType === 'work-index') {
  const stories = projectRecords.filter((p) => p.isDetailedStory);
  schemas.push(
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#collection`,
      url: canonicalUrl,
      name: seoConfig.title,
      description: seoConfig.description,
      publisher: { '@id': `${site.siteUrl}/#organization` },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: stories.map((p, idx) => ({
          '@type': 'ListItem',
          position: idx + 1,
          name: p.publicName,
          url: getCanonicalUrl(p.detailPath),
        })),
      },
    },
    breadcrumbSchema
  );
} else if (resolvedSchemaType === 'case-study') {
  schemas.push(
    {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      '@id': `${canonicalUrl}#creativework`,
      headline: seoConfig.title,
      description: seoConfig.description,
      url: canonicalUrl,
      creator: { '@id': `${site.siteUrl}/#organization` },
      publisher: { '@id': `${site.siteUrl}/#organization` },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: seoConfig.title,
      description: seoConfig.description,
    },
    breadcrumbSchema
  );
} else {
  schemas.push(
    {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: seoConfig.title,
      description: seoConfig.description,
      publisher: { '@id': `${site.siteUrl}/#organization` },
    },
    breadcrumbSchema
  );
}
---

{schemas.map((s) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(s)} />
))}

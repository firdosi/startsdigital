---
import { site } from '../../site.config';
import { getSeoForPath, getCanonicalUrl } from '../../data/seo';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  robots?: string;
}

const pathname = Astro.url.pathname;
const registeredSeo = getSeoForPath(pathname);

const {
  title = registeredSeo.title,
  description = registeredSeo.description,
  canonicalUrl,
  ogType = registeredSeo.ogType || 'website',
  ogImage = registeredSeo.ogImage,
  noindex = false,
  robots = noindex ? 'noindex, follow' : (registeredSeo.robots || 'index, follow'),
} = Astro.props;

const pageTitle = title;
const pageDescription = description;
const computedCanonical = canonicalUrl || getCanonicalUrl(pathname);

const rawOgImage = ogImage || registeredSeo.ogImage || '/og/default-og.png';
const computedOgImage = rawOgImage.startsWith('http')
  ? rawOgImage
  : `${site.siteUrl}${rawOgImage.startsWith('/') ? rawOgImage : '/' + rawOgImage}`;

const ogImageAlt = registeredSeo.ogImageAlt || pageTitle;
const ogImageWidth = registeredSeo.ogImageWidth || 1200;
const ogImageHeight = registeredSeo.ogImageHeight || 630;
---

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />
<link rel="canonical" href={computedCanonical} />
<meta name="robots" content={robots} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={computedCanonical} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:image" content={computedOgImage} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:site_name" content={site.businessName} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={computedCanonical} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={computedOgImage} />
<meta name="twitter:image:alt" content={ogImageAlt} />

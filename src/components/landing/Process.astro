---
import { ChevronDown } from '@lucide/astro';
import SectionEyebrow from '../common/SectionEyebrow.astro';

const stages = [
  {
    id: '01',
    title: 'Understand Your Business',
    subtitle: 'Comprehensive discovery, market analysis, and commercial alignment before launching any campaign spend.',
    isDefaultOpen: true,
    subPanels: [
      {
        tag: 'DISCOVERY',
        title: 'Commercial Goal Alignment',
        desc: 'We evaluate your business goals, target customer profiles, pricing strategy, and current channels to establish clear project priorities.',
      },
      {
        tag: 'STRATEGY',
        title: 'Market & Offer Analysis',
        desc: 'Evaluation of your product offer, pricing strategy, checkout experience, and competitive positioning across target markets.',
      },
      {
        tag: 'SOLUTION',
        title: 'Growth Roadmap Design',
        desc: 'Structuring media budget allocation, creative angles, website optimizations, and conversion tracking before launch.',
      },
    ],
    chips: ['AUDIT', 'MARKET FIT', 'COMMERCIAL TARGETS', 'TARGET PROFILES', 'ATTRIBUTION SETUP'],
  },
  {
    id: '02',
    title: 'Strategic Planning and Creative Execution',
    subtitle: 'Deploying structured ad creatives, optimized web pages, and technical lead funnels.',
    isDefaultOpen: false,
    subPanels: [
      {
        tag: 'CREATIVE',
        title: 'Ad Creative Development',
        desc: 'Designing direct-response image and video ad variations tailored for digital advertising feeds.',
      },
      {
        tag: 'ARCHITECTURE',
        title: 'High-Converting Web Pages',
        desc: 'Building fast-loading landing pages and e-commerce stores optimized for mobile conversion velocity.',
      },
      {
        tag: 'TECH STACK',
        title: 'Tracking & Pixel Setup',
        desc: 'Implementing analytics and event tracking for verified performance measurement.',
      },
    ],
    chips: ['PAID ADS', 'CREATIVE TESTING', 'LANDING PAGES', 'CONVERSION TRACKING'],
  },
  {
    id: '03',
    title: 'Collaboration and Optimisation',
    subtitle: 'Continuous campaign management, budget allocation, and iterative creative testing.',
    isDefaultOpen: false,
    subPanels: [
      {
        tag: 'MEDIA BUYING',
        title: 'Campaign Management',
        desc: 'Regular monitoring of ad spend, bid strategies, placements, and acquisition metrics.',
      },
      {
        tag: 'CRO',
        title: 'Conversion Rate Optimization',
        desc: 'Testing headlines, offer copy, CTA placement, and checkout steps to maximize conversion volume.',
      },
      {
        tag: 'REPORTING',
        title: 'Performance Reviews',
        desc: 'Regular review calls discussing verified results, lead counts, and next-phase scaling plans.',
      },
    ],
    chips: ['A/B TESTING', 'CAMPAIGN OPTIMIZATION', 'SCALE MANAGEMENT', 'DIRECT REPORTING'],
  },
  {
    id: '04',
    title: 'Delivery, Measurement and Improvement',
    subtitle: 'Long-term brand building, organic search indexation, and practical workflows.',
    isDefaultOpen: false,
    subPanels: [
      {
        tag: 'SCALING',
        title: 'Growth & Expansion',
        desc: 'Expanding winning ad angles and scaling budget across proven marketing channels.',
      },
      {
        tag: 'SEO ENGINE',
        title: 'Organic Search Authority',
        desc: 'Building search rankings and localized schema to capture organic demand.',
      },
      {
        tag: 'AUTOMATION',
        title: 'Practical AI Workflows',
        desc: 'Automating lead routing, customer follow-ups, and re-engagement to improve operational speed.',
      },
    ],
    chips: ['LONG-TERM GROWTH', 'SEO RANKINGS', 'AI WORKFLOWS', 'RETENTION'],
  },
];
---

<section id="process" class="py-16 sm:py-20 lg:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px] sm:scroll-mt-[112px] lg:scroll-mt-[104px]">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header (NO data-motion) -->
    <div class="max-w-3xl mb-12 text-center mx-auto space-y-3">
      <SectionEyebrow
        label="WORKING METHOD"
        align="center"
        motion={false}
      />
      <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[44px] text-[#061d33] leading-[1.15] tracking-[-0.025em]">
        A clear path from business requirement to active execution.
      </h2>
      <p class="text-base sm:text-lg text-slate-700 font-body leading-[1.65] font-normal max-w-2xl mx-auto">
        The exact scope varies by project, but the work is organised around discovery, planning, production, launch and ongoing review.
      </p>
    </div>

    <!-- Stage Progress Connector Bar (NO data-motion) -->
    <div class="relative max-w-5xl mx-auto mb-10 hidden md:block">
      <div class="h-1.5 w-full bg-slate-200 rounded-full overflow-hidden">
        <div id="process-progress-line" class="h-full bg-gradient-to-r from-[#ff762b] via-[#9a83f5] to-[#39c98a] w-1/4 transition-all duration-300 ease-out rounded-full"></div>
      </div>
    </div>

    <!-- Accordion Stack (NO data-motion) -->
    <div class="space-y-6 max-w-5xl mx-auto">
      {
        stages.map((stage) => (
          <details
            open={stage.isDefaultOpen}
            class:list={[
              'accordion-item rounded-3xl border-2 transition-colors duration-300 overflow-hidden shadow-lg group',
              stage.isDefaultOpen ? 'border-[#ff762b] bg-[#ff762b] text-white' : 'border-slate-300 bg-white text-[#061d33] hover:border-[#ff762b]'
            ]}
            data-accordion-id={stage.id}
          >
            <!-- Accordion Header Summary (Responsive layout) -->
            <summary
              class="accordion-toggle w-full px-6 sm:px-8 py-6 sm:py-7 flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-6 text-left focus:outline-none cursor-pointer select-none min-h-[44px] list-none [&::-webkit-details-marker]:hidden focus-visible:ring-2 focus-visible:ring-white"
            >
              <!-- Top Row: Step badge, Stage Title, Chevron (Full width on mobile) -->
              <div class="flex items-center justify-between gap-4 w-full">
                <div class="flex items-center gap-4 sm:gap-6 min-w-0">
                  <span class:list={[
                    'accordion-step-num font-mono font-medium text-lg sm:text-2xl size-11 sm:size-12 rounded-2xl flex items-center justify-center shrink-0 transition-colors duration-300',
                    stage.isDefaultOpen ? 'bg-white text-[#ff762b]' : 'bg-[#061d33] text-white'
                  ]}>
                    {stage.id}
                  </span>
                  <h3 class="font-heading font-semibold text-[18px] sm:text-[21px] leading-[1.25] break-words">
                    {stage.title}
                  </h3>
                </div>

                <div class:list={[
                  'accordion-icon size-10 rounded-full flex items-center justify-center shrink-0 ml-2 sm:ml-4 transition-transform duration-300',
                  stage.isDefaultOpen ? 'bg-white/20 text-white rotate-180' : 'bg-slate-100 text-[#061d33]'
                ]}>
                  <ChevronDown class="size-6" />
                </div>
              </div>

              <!-- Subtitle: Full width below top row on mobile -->
              <p class:list={[
                'accordion-subtitle text-sm sm:text-base font-body font-normal leading-[1.6] transition-colors duration-300 sm:pl-[72px] sm:-mt-1 w-full',
                stage.isDefaultOpen ? 'text-white/90' : 'text-slate-600'
              ]}>
                {stage.subtitle}
              </p>
            </summary>

            <!-- Stage Body Wrapper (Readable without JS) -->
            <div class="accordion-wrapper px-6 sm:px-8 pb-8 pt-2 space-y-6">
              <!-- 3 Sub-Panels -->
              <div class="grid gap-6 sm:grid-cols-3 mt-2 sm:mt-4">
                {stage.subPanels.map((sub) => (
                  <div class:list={[
                    'rounded-2xl p-5 sm:p-6 shadow-sm border transition-all duration-300',
                    stage.isDefaultOpen ? 'bg-white text-[#061d33] border-white/20' : 'bg-[#f7f4ed] text-[#061d33] border-slate-200'
                  ]}>
                    <span class="text-[11px] font-mono font-medium uppercase tracking-[0.05em] text-[#ff762b] bg-[#ff762b]/10 px-2.5 py-0.5 rounded block w-fit mb-3">
                      {sub.tag}
                    </span>
                    <h4 class="font-heading font-semibold text-[16px] sm:text-[17px] mb-2 text-[#061d33] leading-[1.25]">
                      {sub.title}
                    </h4>
                    <p class="text-sm sm:text-base font-body leading-[1.6] text-slate-700 font-normal">
                      {sub.desc}
                    </p>
                  </div>
                ))}
              </div>

              <!-- Topic Chips -->
              <div class="pt-4 border-t border-current/20 flex flex-wrap items-center gap-2 font-mono">
                <span class="text-xs font-medium uppercase mr-2 opacity-80 shrink-0">FOCUS AREAS:</span>
                {stage.chips.map((chip) => (
                  <span class:list={[
                    'text-[11px] sm:text-[13px] font-mono font-medium px-3 py-1 rounded-full uppercase tracking-[0.05em] transition-all',
                    stage.isDefaultOpen ? 'bg-white text-[#061d33]' : 'bg-[#061d33] text-white'
                  ]}>
                    {chip}
                  </span>
                ))}
              </div>
            </div>
          </details>
        ))
      }
    </div>

  </div>
</section>

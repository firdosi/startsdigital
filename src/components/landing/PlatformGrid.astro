---
import { toolEcosystem } from '../../data/tool-ecosystem';
import { site } from '../../site.config';
import SectionEyebrow from '../common/SectionEyebrow.astro';

const logoSrc = (asset: string | null) => asset ? (asset.startsWith('http') ? asset : `${site.basePath}${asset}`) : '';

const categories = [
  'Advertising & Social Platforms',
  'Analytics, Search & Tracking',
  'Websites, Development & Commerce',
  'Design, Content & Video',
  'Communication & Business Operations',
  'AI & Automation'
] as const;
---

<section id="platforms" class="py-16 sm:py-20 lg:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px] sm:scroll-mt-[112px] lg:scroll-mt-[104px]">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="max-w-3xl text-center mx-auto space-y-3">
      <SectionEyebrow
        label="TECH STACK & ECOSYSTEM"
        align="center"
        delay={0}
      />
      <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[31px] sm:text-[36px] lg:text-[44px] text-[#061d33] leading-[1.15] tracking-[-0.025em]">
        Platforms and tools we work with
      </h2>
      <p data-motion="fade-up" data-motion-delay="200" class="text-base sm:text-lg text-slate-700 font-body leading-[1.65] font-normal max-w-2xl mx-auto">
        Engineered integration across advertising networks, analytics engines, CMS platforms, design suites, operations tools and AI automation.
      </p>
    </div>

    <!-- Categorized Tool Ecosystem Grid -->
    <div class="space-y-12">
      {categories.map((catGroup) => {
        const groupTools = toolEcosystem.filter(t => t.category === catGroup);

        return (
          <div class="space-y-5">
            <!-- Category Header Badge -->
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-3 py-1.5 rounded-full">
                {catGroup}
              </span>
              <div class="h-px bg-[#061d33]/10 flex-1" aria-hidden="true"></div>
            </div>

            <!-- Group Grid (2 cols mobile, 3-4 cols tablet, 6 cols desktop) -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-5">
              {groupTools.map((t) => (
                <div
                  data-tool-logo
                  data-tool-id={t.id}
                  data-tool-category={t.category}
                  data-render-type={t.renderType}
                  style="background-color: #ffffff;"
                  class="rounded-2xl border border-[#061d33]/12 bg-white p-4 sm:p-5 flex flex-col items-center justify-between text-center shadow-xs hover:shadow-md hover:border-[#ff762b]/40 hover:-translate-y-0.5 transition-all duration-300 h-full group relative"
                >
                  <div class="h-14 w-full mb-3 flex items-center justify-center rounded-xl bg-[#061d33]/5 p-2 group-hover:scale-105 transition-transform duration-300">
                    {t.localAsset ? (
                      <img
                        src={logoSrc(t.localAsset)}
                        alt={t.alt}
                        width="48"
                        height="48"
                        loading="lazy"
                        decoding="async"
                        style={`max-width: ${t.maxWidth || '44px'}; max-height: ${t.maxHeight || '44px'}; transform: scale(${t.displayScale || 1.0});`}
                        class="object-contain"
                      />
                    ) : (
                      <div class="flex flex-col items-center justify-center space-y-0.5">
                        <span class="font-mono text-[9px] font-bold text-[#061d33]/60 uppercase tracking-widest bg-[#061d33]/10 px-2 py-0.5 rounded">
                          Capability
                        </span>
                      </div>
                    )}
                  </div>

                  <div class="space-y-1.5 w-full">
                    <h3 class="font-heading font-bold text-sm text-[#061d33] leading-snug group-hover:text-[#ff762b] transition-colors">
                      {t.name}
                    </h3>

                    {/* Sub-product capability chips if present */}
                    {t.capabilities && (
                      <div class="pt-1.5 flex flex-wrap justify-center gap-1">
                        {t.capabilities.slice(0, 2).map((cap) => (
                          <span class="font-mono text-[10px] text-[#ff762b] font-medium bg-[#ff762b]/8 px-1.5 py-0.5 rounded">
                            {cap}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

---
import { toolEcosystem } from '../../data/tool-ecosystem';
import { site } from '../../site.config';
import SectionEyebrow from '../common/SectionEyebrow.astro';

const logoSrc = (asset: string | null) => asset ? (asset.startsWith('http') ? asset : `${site.basePath}${asset}`) : '';

const categories = [
  'Advertising & Social Platforms',
  'Analytics, Search & Tracking',
  'Websites, Development & Commerce',
  'Design, Content & Video',
  'Communication & Business Operations',
  'AI & Automation'
] as const;
---

<section id="platforms" class="py-16 sm:py-20 lg:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px] sm:scroll-mt-[112px] lg:scroll-mt-[104px]">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8 space-y-12">
    
    <!-- Section Header -->
    <div class="max-w-3xl text-center mx-auto space-y-3">
      <SectionEyebrow
        label="TECH STACK & ECOSYSTEM"
        align="center"
        delay={0}
      />
      <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[31px] sm:text-[36px] lg:text-[44px] text-[#061d33] leading-[1.15] tracking-[-0.025em]">
        Platforms and tools we work with
      </h2>
      <p data-motion="fade-up" data-motion-delay="200" class="text-base sm:text-lg text-slate-700 font-body leading-[1.65] font-normal max-w-2xl mx-auto">
        Engineered integration across advertising networks, analytics engines, CMS platforms, design suites, operations tools and AI automation.
      </p>
    </div>

    <!-- Categorized Tool Ecosystem -->
    <div class="space-y-10">
      {categories.map((catGroup) => {
        const groupTools = toolEcosystem.filter(t => t.category === catGroup);
        const logoTools = groupTools.filter(t => t.renderType === 'logo');
        const capTextTools = groupTools.filter(t => t.renderType === 'capability-text');
        const toolsWithCapabilities = groupTools.filter(t => t.capabilities && t.capabilities.length > 0 && t.renderType === 'logo');

        return (
          <div class="space-y-5 bg-white/40 border border-[#061d33]/8 rounded-3xl p-5 sm:p-6 lg:p-7 shadow-xs">
            <!-- Category Header Badge -->
            <div class="flex items-center gap-3">
              <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-3 py-1.5 rounded-full">
                {catGroup}
              </span>
              <div class="h-px bg-[#061d33]/10 flex-1" aria-hidden="true"></div>
            </div>

            <!-- Centered Responsive Flex Grid for Verified Logo Cards -->
            <div class="flex flex-wrap justify-center gap-3 sm:gap-4">
              {logoTools.map((t) => (
                <div
                  data-tool-logo
                  data-tool-id={t.id}
                  data-tool-category={t.category}
                  data-render-type={t.renderType}
                  style="background-color: #ffffff;"
                  class="w-[calc(50%-0.375rem)] sm:w-[calc(25%-0.75rem)] lg:w-[calc(16.666%-0.833rem)] xl:w-[calc(12.5%-0.875rem)] rounded-2xl border border-[#061d33]/12 bg-white p-3 sm:p-4 flex flex-col items-center justify-center text-center shadow-xs hover:shadow-md hover:border-[#ff762b]/40 hover:-translate-y-0.5 transition-all duration-300 h-[140px] sm:h-[150px] group relative overflow-hidden shrink-0"
                >
                  <div class="h-14 sm:h-16 w-full flex items-center justify-center p-1 group-hover:scale-105 transition-transform duration-300">
                    <img
                      src={logoSrc(t.localAsset)}
                      alt={t.alt}
                      width="64"
                      height="64"
                      loading="lazy"
                      decoding="async"
                      style={`max-width: ${t.maxWidth || '52px'}; max-height: ${t.maxHeight || '52px'}; transform: scale(${t.displayScale || 1.0});`}
                      class="object-contain w-auto h-auto"
                    />
                  </div>

                  <div class="mt-2 w-full px-1">
                    <h3 class="font-heading font-bold text-xs sm:text-sm text-[#061d33] leading-tight group-hover:text-[#ff762b] transition-colors break-words line-clamp-2">
                      {t.name}
                    </h3>
                  </div>
                </div>
              ))}
            </div>

            <!-- Additional Tools & Capabilities Row (for text-only capability items in this category) -->
            {capTextTools.length > 0 && (
              <div class="pt-3 border-t border-[#061d33]/10 space-y-2">
                <div class="text-[11px] font-mono font-bold text-[#061d33]/70 uppercase tracking-wider text-center">
                  Additional Tools &amp; Capabilities
                </div>
                <div class="flex flex-wrap justify-center gap-2 sm:gap-3">
                  {capTextTools.map((t) => (
                    <div
                      data-tool-logo
                      data-tool-id={t.id}
                      data-tool-category={t.category}
                      data-render-type={t.renderType}
                      class="bg-white border border-[#061d33]/15 px-3 py-1.5 sm:px-4 sm:py-2 rounded-xl flex items-center gap-2 shadow-xs hover:border-[#ff762b] transition-all text-xs font-semibold text-[#061d33]"
                    >
                      <span class="w-2 h-2 rounded-full bg-[#ff762b] shrink-0"></span>
                      <span>{t.name}</span>
                      {t.capabilities && t.capabilities.length > 0 && (
                        <span class="text-[10px] text-slate-500 font-normal">
                          ({t.capabilities.map((cap, capIdx) => (
                            <span data-capability-chip={cap}>{cap}{capIdx < t.capabilities!.length - 1 ? ' · ' : ''}</span>
                          ))})
                        </span>
                      )}
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Secondary Capability Strip (for sub-product capability chips in this category) -->
            {toolsWithCapabilities.length > 0 && (
              <div class="pt-3 border-t border-[#061d33]/10 bg-[#061d33]/3 rounded-2xl p-3 sm:p-4 space-y-2">
                <div class="text-[10px] font-mono font-bold text-[#061d33]/60 uppercase tracking-wider">
                  Platform Capabilities &amp; Integrations
                </div>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2.5 text-xs">
                  {toolsWithCapabilities.map((t) => (
                    <div data-tool-id={t.id} class="flex flex-wrap items-center gap-1.5">
                      <span class="font-bold text-[#061d33] text-[11px] sm:text-xs">{t.name}:</span>
                      {t.capabilities!.map((cap) => (
                        <span
                          data-capability-chip={cap}
                          class="font-mono text-[10px] sm:text-[11px] text-slate-700 font-medium bg-white px-2 py-0.5 rounded-md border border-[#061d33]/12 shadow-2xs"
                        >
                          {cap}
                        </span>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            )}

          </div>
        );
      })}
    </div>

  </div>
</section>

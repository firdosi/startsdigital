---
import { Bot, Sparkles, Layers, ArrowRight, TrendingUp, Users, DollarSign, Cpu } from '@lucide/astro';

const timelineSteps = [
  {
    phase: '01. INFRASTRUCTURE BUILD (2025)',
    title: 'Private Consistent-Character Workflow',
    description: 'Built a private in-house character generation pipeline when commercial online tools lacked reliable character consistency across different campaign scenes and poses.',
    stat: 'Private VPS Pipeline',
    icon: Cpu,
    color: 'text-[#ff762b] bg-[#ff762b]/10 border-[#ff762b]/30'
  },
  {
    phase: '02. CHARACTER IDENTITY MATRIX',
    title: '27+ Original Character Identities',
    description: 'Developed an initial core registry of over 27 distinct male and female marketing character identities with consistent facial features, expressions and brand styling.',
    stat: '27+ Initial Identities',
    icon: Bot,
    color: 'text-[#ddff35] bg-[#ddff35]/10 border-[#ddff35]/30'
  },
  {
    phase: '03. SCALE ASSET PRODUCTION',
    title: 'Thousands of AI Character Assets',
    description: 'Expanded the generation infrastructure to produce thousands of unique video ad frames, static creative variations, and promotional assets for ongoing multi-platform ad testing.',
    stat: '1,000s of Character Assets',
    icon: Layers,
    color: 'text-purple-400 bg-purple-500/10 border-purple-500/30'
  },
  {
    phase: '04. COMMERCIAL CONVERSION OUTCOMES',
    title: '140+ Conversions & AED 1.4M+ Revenue',
    description: 'AI-generated campaign creative directly contributed to over 140 client conversions and generated more than AED 1.4M in total campaign sales revenue across regional markets.',
    stat: '140+ Conversions | AED 1.4M+',
    icon: TrendingUp,
    color: 'text-[#39c98a] bg-[#39c98a]/10 border-[#39c98a]/30'
  }
];
---

<section id="ai-story" class="py-16 sm:py-24 bg-[#061d33] text-white relative overflow-hidden border-t border-b border-white/10">
  <!-- Ambient background glow -->
  <div class="absolute inset-0 bg-radial-gradient from-[#ff762b]/10 via-transparent to-transparent pointer-events-none"></div>

  <div class="max-w-[1280px] mx-auto px-6 sm:px-8 relative z-10">
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#ddff35]/30 bg-[#ddff35]/10 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-[0.08em] text-[#ddff35]">
        <Sparkles class="size-3.5 text-[#ddff35]" />
        <span>AI CREATIVE INNOVATION</span>
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight">
        From Early AI Character Systems to Large-Scale Creative Production
      </h2>
      <p class="font-body text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        How Starts Digital built private consistent-character generation infrastructure to power high-converting video and graphic advertising campaigns.
      </p>
    </div>

    <!-- 4-Step Visual Timeline Progression Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 mb-16">
      {timelineSteps.map((step, idx) => {
        const IconComp = step.icon;
        return (
          <div class="rounded-3xl border border-white/15 bg-white/5 p-6 flex flex-col justify-between space-y-6 hover:border-white/30 hover:bg-white/10 transition-all duration-300">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] uppercase tracking-wider text-slate-400">
                  {step.phase}
                </span>
                <div class={`size-10 rounded-2xl border flex items-center justify-center ${step.color}`}>
                  <IconComp class="size-5" />
                </div>
              </div>
              <h3 class="font-heading font-bold text-xl text-white leading-snug">
                {step.title}
              </h3>
              <p class="font-body text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">
                {step.description}
              </p>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-[#ddff35]">
                {step.stat}
              </span>
              <ArrowRight class="size-4 text-slate-400" />
            </div>
          </div>
        );
      })}
    </div>

    <!-- Visual Progression Frame: Character Identity to Conversion Nodes -->
    <div class="rounded-3xl border border-white/15 bg-white/5 p-6 sm:p-8 backdrop-blur-xl max-w-4xl mx-auto space-y-6">
      <div class="flex items-center justify-between border-b border-white/10 pb-4">
        <div class="flex items-center gap-3">
          <div class="size-10 rounded-2xl bg-[#ddff35] text-[#061d33] flex items-center justify-center font-bold">
            <Bot class="size-6" />
          </div>
          <div>
            <h4 class="font-heading font-bold text-base text-white">Consistent Character Pipeline Progression</h4>
            <span class="font-mono text-xs text-slate-400">Private Custom Asset Architecture</span>
          </div>
        </div>
        <span class="font-mono text-xs px-3 py-1 rounded-full bg-[#39c98a]/20 text-[#39c98a] border border-[#39c98a]/30">
          Scale Production
        </span>
      </div>

      <!-- Character Portrait Tiles & Campaign Creative Visual Bridge -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center space-y-2">
          <div class="size-12 rounded-xl bg-purple-500/20 border border-purple-400/30 mx-auto flex items-center justify-center font-mono font-bold text-purple-300 text-sm">
            ID-01
          </div>
          <span class="font-mono text-[10px] uppercase text-slate-400 block">Base Character</span>
          <span class="font-heading text-xs font-bold text-white">Original Identity</span>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center space-y-2">
          <div class="size-12 rounded-xl bg-[#ff762b]/20 border border-[#ff762b]/30 mx-auto flex items-center justify-center font-mono font-bold text-[#ff762b] text-sm">
            27+
          </div>
          <span class="font-mono text-[10px] uppercase text-slate-400 block">Core Registry</span>
          <span class="font-heading text-xs font-bold text-white">Identity Matrix</span>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center space-y-2">
          <div class="size-12 rounded-xl bg-sky-500/20 border border-sky-400/30 mx-auto flex items-center justify-center font-mono font-bold text-sky-300 text-sm">
            1,000s
          </div>
          <span class="font-mono text-[10px] uppercase text-slate-400 block">Ad Creatives</span>
          <span class="font-heading text-xs font-bold text-white">Generated Assets</span>
        </div>

        <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-center space-y-2">
          <div class="size-12 rounded-xl bg-[#39c98a]/20 border border-[#39c98a]/30 mx-auto flex items-center justify-center font-mono font-bold text-[#39c98a] text-sm">
            140+
          </div>
          <span class="font-mono text-[10px] uppercase text-slate-400 block">Conversions</span>
          <span class="font-heading text-xs font-bold text-white">Client Sales</span>
        </div>
      </div>
    </div>
  </div>
</section>

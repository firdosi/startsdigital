---
import { site } from '../../site.config';
import { homepageContent } from '../../data/homepage';
import AnimatedGrid from '../motion/AnimatedGrid.astro';
import FloatingOrb from '../motion/FloatingOrb.astro';
import SectionSpark from '../motion/SectionSpark.astro';
import { ArrowRight, Sparkles, Megaphone, Layout, Search, Video, Share2, Cpu } from '@lucide/astro';
import LightweightVisual3D from '../visuals/LightweightVisual3D.astro';

const { hero } = homepageContent;

const serviceHighlights = [
  { title: 'Paid Advertising', icon: Megaphone, color: 'text-[#ff762b]', bg: 'bg-[#ff762b]/15 border-[#ff762b]/30' },
  { title: 'Website Design & Dev', icon: Layout, color: 'text-[#ddff35]', bg: 'bg-[#ddff35]/15 border-[#ddff35]/30' },
  { title: 'SEO & Local Search', icon: Search, color: 'text-[#39c98a]', bg: 'bg-[#39c98a]/15 border-[#39c98a]/30' },
  { title: 'Creative Content', icon: Video, color: 'text-purple-400', bg: 'bg-purple-500/15 border-purple-500/30' },
  { title: 'Social Media Marketing', icon: Share2, color: 'text-sky-400', bg: 'bg-sky-500/15 border-sky-500/30' },
  { title: 'AI Marketing Workflows', icon: Cpu, color: 'text-[#ff762b]', bg: 'bg-[#ff762b]/15 border-[#ff762b]/30' },
];
---

<section id="hero" class="relative overflow-hidden bg-[#061d33] text-white pt-6 sm:pt-20 lg:pt-28 pb-8 sm:pb-20 lg:pb-24 rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl scroll-mt-24">
  <!-- Subtle Animated Tech Background Grid -->
  <AnimatedGrid opacity={0.10} />

  <!-- Restrained Decorative Accent Elements -->
  <FloatingOrb color="orange" size="lg" class="-top-24 -left-24 opacity-60 pointer-events-none" duration="16s" />
  <SectionSpark color="orange" size="md" class="top-10 right-[8%] pointer-events-none" delay="0s" />

  <div class="relative mx-auto max-w-[1280px] px-6 sm:px-8 z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Positioning & CTAs (col-span-7) -->
      <div class="lg:col-span-7 space-y-4 sm:space-y-7 text-left">
        
        <div class="inline-flex items-center">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1 sm:px-4 sm:py-1.5 text-[11px] sm:text-xs font-mono font-medium uppercase tracking-[0.06em] text-[#ddff35] backdrop-blur-md">
            <Sparkles class="size-3.5 text-[#ddff35]" />
            <span>{hero.eyebrow}</span>
          </span>
        </div>

        <!-- Hero Headline -->
        <h1 class="font-heading font-bold text-[26px] sm:text-[44px] lg:text-[54px] leading-[1.12] tracking-[-0.03em] text-white">
          {hero.headline}
        </h1>

        <!-- Supporting Paragraph (Max 2 sentences) -->
        <p class="text-sm sm:text-lg leading-[1.6] text-slate-200 font-body max-w-2xl font-normal">
          {hero.paragraph}
        </p>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-1 font-body">
          <a
            href={`${site.basePath}${hero.primaryCta.href}`}
            data-track="primary-cta"
            class="group inline-flex items-center justify-center min-h-[44px] sm:min-h-[48px] gap-2.5 rounded-full bg-[#ddff35] px-6 py-2.5 sm:px-7 sm:py-3 font-body font-semibold text-sm sm:text-base text-[#061d33] shadow-lg hover:bg-[#c9eb1e] hover:-translate-y-0.5 transition-all"
          >
            <span>{hero.primaryCta.label}</span>
            <ArrowRight class="size-4 text-[#061d33] group-hover:translate-x-1 transition-transform" />
          </a>
          <a
            href={`${site.basePath}${hero.secondaryCta.href}`}
            class="inline-flex items-center justify-center min-h-[44px] sm:min-h-[48px] gap-2 rounded-full border border-white/30 bg-white/10 px-6 py-2.5 sm:px-7 sm:py-3 font-body font-semibold text-sm sm:text-base text-white hover:bg-white/20 transition-all backdrop-blur-sm"
          >
            {hero.secondaryCta.label}
          </a>
        </div>

      </div>

      <!-- Right Column: Visual 3D Composition Anchor (col-span-5) -->
      <div class="lg:col-span-5">
        <LightweightVisual3D type="hero-3d" />
      </div>

    </div>
  </div>
</section>

---
import { site } from '../../site.config';
import { homepageContent } from '../../data/homepage';
import AnimatedGrid from '../motion/AnimatedGrid.astro';
import FloatingOrb from '../motion/FloatingOrb.astro';
import SectionSpark from '../motion/SectionSpark.astro';
import { ArrowRight, Sparkles, Megaphone, Globe, Search, Video, Share2, Bot, ChevronRight } from '@lucide/astro';

const { hero } = homepageContent;

const heroServices = [
  {
    id: 'paid-advertising',
    title: 'Paid Advertising',
    subtitle: 'Meta, TikTok & Google Ad Campaigns',
    href: '/services/paid-advertising/',
    icon: Megaphone,
    color: 'text-[#ff762b]',
    bgColor: 'bg-[#ff762b]/15 border-[#ff762b]/30'
  },
  {
    id: 'website-design-development',
    title: 'Website Design & Development',
    subtitle: 'Custom Fast Websites & Storefronts',
    href: '/services/website-design-development/',
    icon: Globe,
    color: 'text-[#38bdf8]',
    bgColor: 'bg-[#38bdf8]/15 border-[#38bdf8]/30'
  },
  {
    id: 'seo-local-search',
    title: 'SEO & Local Search',
    subtitle: 'Google Maps & Local Search Rank',
    href: '/services/seo-local-search/',
    icon: Search,
    color: 'text-[#39c98a]',
    bgColor: 'bg-[#39c98a]/15 border-[#39c98a]/30'
  },
  {
    id: 'creative-content',
    title: 'Creative Content',
    subtitle: 'Video Edits & Direct Response Visuals',
    href: '/services/creative-content/',
    icon: Video,
    color: 'text-purple-400',
    bgColor: 'bg-purple-500/15 border-purple-500/30'
  },
  {
    id: 'social-media-marketing',
    title: 'Social Media Marketing',
    subtitle: 'Social Content & Publishing',
    href: '/services/social-media-marketing/',
    icon: Share2,
    color: 'text-pink-400',
    bgColor: 'bg-pink-500/15 border-pink-500/30'
  },
  {
    id: 'ai-marketing-workflows',
    title: 'AI Marketing Workflows',
    subtitle: 'Custom AI Avatars & Lead Routing',
    href: '/services/ai-marketing-workflows/',
    icon: Bot,
    color: 'text-[#ddff35]',
    bgColor: 'bg-[#ddff35]/15 border-[#ddff35]/30'
  }
];
---

<section id="hero" class="relative overflow-hidden bg-[#061d33] text-white pt-6 sm:pt-16 lg:pt-20 pb-12 sm:pb-20 lg:pb-24 rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl scroll-mt-24">
  <!-- Subtle Animated Tech Background Grid -->
  <AnimatedGrid opacity={0.10} />

  <!-- Restrained Decorative Accent Elements -->
  <FloatingOrb color="orange" size="lg" class="-top-24 -left-24 opacity-60 pointer-events-none" duration="16s" />
  <SectionSpark color="orange" size="md" class="top-10 right-[8%] pointer-events-none" delay="0s" />

  <div class="relative mx-auto max-w-[1280px] px-6 sm:px-8 z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Positioning & CTAs (col-span-6 desktop) -->
      <div class="lg:col-span-6 space-y-4 sm:space-y-7 text-left">
        
        <div class="inline-flex items-center">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-3.5 py-1 sm:px-4 sm:py-1.5 text-[11px] sm:text-xs font-mono font-medium uppercase tracking-[0.06em] text-[#ddff35] backdrop-blur-md">
            <Sparkles class="size-3.5 text-[#ddff35]" />
            <span>{hero.eyebrow}</span>
          </span>
        </div>

        <!-- Hero Headline -->
        <h1 class="font-heading font-bold text-[28px] sm:text-[44px] lg:text-[52px] leading-[1.12] tracking-[-0.03em] text-white">
          {hero.headline}
        </h1>

        <!-- Supporting Paragraph -->
        <p class="text-sm sm:text-lg leading-[1.6] text-slate-200 font-body max-w-xl font-normal">
          {hero.paragraph}
        </p>

        <!-- Homepage Hero CTAs: Discuss Your Project & Explore Our Services -->
        <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-2 font-body">
          <a
            href={`${site.basePath}/contact/`}
            data-track="primary-cta"
            class="group inline-flex items-center justify-center min-h-[48px] gap-2.5 rounded-full bg-[#ddff35] px-7 py-3 font-body font-semibold text-sm sm:text-base text-[#061d33] shadow-lg hover:bg-[#c9eb1e] hover:-translate-y-0.5 transition-all focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ddff35]"
          >
            <span>Discuss Your Project</span>
            <ArrowRight class="size-4 text-[#061d33] group-hover:translate-x-1 transition-transform" />
          </a>
          <a
            href={`${site.basePath}/services/`}
            class="inline-flex items-center justify-center min-h-[48px] gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3 font-body font-semibold text-sm sm:text-base text-white hover:bg-white/20 transition-all backdrop-blur-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            Explore Our Services
          </a>
        </div>

      </div>

      <!-- Right Column: Interactive Restored 6-Service Panel (col-span-6 desktop) -->
      <div id="homepage-service-panel" class="lg:col-span-6">
        <div class="relative rounded-3xl border border-white/15 bg-white/5 p-4 sm:p-6 backdrop-blur-xl shadow-2xl space-y-3">
          
          <!-- Panel Header -->
          <div class="flex items-center gap-2.5 border-b border-white/10 pb-3.5 mb-1 px-1">
            <span class="size-2 rounded-full bg-[#ff762b] shrink-0"></span>
            <span class="font-mono text-xs font-bold uppercase tracking-wider text-slate-300">
              Our Services
            </span>
          </div>

          <!-- 6 Service Rows (Clickable, Accessible, Min 44px Target) -->
          <div class="space-y-2.5">
            {heroServices.map((service, idx) => {
              const IconComp = service.icon;
              return (
                <a
                  href={`${site.basePath}${service.href}`}
                  class="group relative flex items-center justify-between rounded-2xl border border-white/10 bg-white/5 p-3 sm:p-3.5 min-h-[52px] transition-all duration-300 hover:border-white/30 hover:bg-white/15 hover:-translate-y-0.5 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] active:scale-[0.99]"
                  style={`animation-delay: ${idx * 60}ms`}
                >
                  <div class="flex items-center gap-3.5">
                    <div class={`size-9 rounded-xl border flex items-center justify-center shrink-0 ${service.bgColor} group-hover:scale-105 transition-transform`}>
                      <IconComp class={`size-4.5 ${service.color}`} />
                    </div>
                      <div>
                        <span class="font-heading font-bold text-sm sm:text-base text-white group-hover:text-[#ddff35] transition-colors leading-tight block">
                          {service.title}
                        </span>
                        <span class="font-mono text-[11px] text-slate-300 block">
                          {service.subtitle}
                        </span>
                      </div>
                  </div>
                  <div class="size-7 rounded-lg bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 group-hover:text-white group-hover:border-white/30 group-hover:translate-x-0.5 transition-all">
                    <ChevronRight class="size-4" />
                  </div>
                </a>
              );
            })}
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

---
import { site } from '../../site.config';
import { homepageContent } from '../../data/homepage';
import AnimatedGrid from '../motion/AnimatedGrid.astro';
import FloatingOrb from '../motion/FloatingOrb.astro';
import SectionSpark from '../motion/SectionSpark.astro';
import { ArrowRight, Sparkles } from '@lucide/astro';

const { hero } = homepageContent;
---

<section id="hero" class="relative overflow-hidden bg-[#061d33] text-white pt-12 pb-16 sm:pt-16 sm:pb-20 lg:pt-20 lg:pb-24 rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl">
  <!-- Subtle Animated Tech Background Grid -->
  <AnimatedGrid opacity={0.10} />

  <!-- Restrained Decorative Accent Elements (Orb & Spark) -->
  <FloatingOrb color="orange" size="lg" class="-top-24 -left-24 opacity-60 pointer-events-none" duration="16s" />
  <SectionSpark color="orange" size="md" class="top-10 right-[8%] pointer-events-none" delay="0s" />

  <div class="relative mx-auto max-w-[1280px] px-6 sm:px-8 z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Positioning, Explanation & CTAs (55% width on desktop -> col-span-7) -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-7 text-left">
        
        <!-- Eyebrow Pill -->
        <div data-motion="scale-in" data-motion-delay="0" class="inline-flex items-center">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-[0.06em] text-[#ddff35] backdrop-blur-md">
            <Sparkles class="size-3.5 text-[#ddff35]" />
            <span>{hero.eyebrow}</span>
          </span>
        </div>

        <!-- Hero Headline -->
        <h1 data-motion="clip-up" data-motion-delay="120" class="font-heading font-bold text-[34px] sm:text-[46px] lg:text-[54px] leading-[1.1] tracking-[-0.03em] text-white">
          {hero.headline}
        </h1>

        <!-- Supporting Paragraph -->
        <p data-motion="fade-up" data-motion-delay="240" class="text-base sm:text-lg leading-[1.65] text-slate-200 font-body max-w-2xl font-normal">
          {hero.paragraph}
        </p>

        <!-- Action Buttons -->
        <div data-motion="pop-in" data-motion-delay="360" class="flex flex-wrap items-center gap-4 pt-2 font-body">
          <a
            href={`${site.basePath}${hero.primaryCta.href}`}
            data-track="primary-cta"
            class="group inline-flex items-center justify-center min-h-[48px] gap-2.5 rounded-full bg-[#ddff35] px-7 py-3 font-body font-semibold text-base text-[#061d33] shadow-lg hover:bg-[#c9eb1e] hover:-translate-y-0.5 transition-all"
          >
            <span>{hero.primaryCta.label}</span>
            <ArrowRight class="size-4 text-[#061d33] group-hover:translate-x-1 transition-transform" />
          </a>
          <a
            href={`${site.basePath}${hero.secondaryCta.href}`}
            class="inline-flex items-center justify-center min-h-[48px] gap-2 rounded-full border border-white/30 bg-white/10 px-7 py-3 font-body font-semibold text-base text-white hover:bg-white/20 transition-all backdrop-blur-sm"
          >
            {hero.secondaryCta.label}
          </a>
        </div>

        <!-- Supporting Service Line (Restrained Editorial Text) -->
        <div data-motion="fade-up" data-motion-delay="420" class="pt-3 border-t border-white/15">
          <p class="text-xs sm:text-sm font-mono text-slate-300 flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
            {hero.serviceLine.map((item, idx) => (
              <>
                <span class="whitespace-nowrap">{item}</span>
                {idx < hero.serviceLine.length - 1 && (
                  <span class="text-[#ff762b] opacity-60">•</span>
                )}
              </>
            ))}
          </p>
        </div>

      </div>

      <!-- Right Column: Grounded Project-Proof Panels (45% width on desktop -> col-span-5) -->
      <div data-motion="fade-up" data-motion-delay="300" class="lg:col-span-5 space-y-4">
        
        <!-- Header Label -->
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full bg-[#ff762b]"></span>
          <span class="text-xs font-mono font-semibold uppercase tracking-[0.08em] text-[#ff762b]">
            {hero.proofHeaderLabel}
          </span>
        </div>

        <!-- Proof Panel 1: Black Gold Fertilizer -->
        {hero.proofCards.slice(0, 1).map((card) => (
          <a
            href={`${site.basePath}${card.href}`}
            class="group block rounded-2xl border border-white/15 bg-white/5 p-5 sm:p-6 backdrop-blur-md hover:border-[#ff762b]/60 hover:bg-white/10 transition-all duration-300 shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
          >
            <div class="flex items-start justify-between gap-3 mb-3">
              <div>
                <h2 class="font-heading font-bold text-lg sm:text-xl text-white group-hover:text-[#ff762b] transition-colors">
                  {card.brand}
                </h2>
                <p class="text-xs font-mono text-slate-300 mt-0.5">{card.context}</p>
              </div>
              <ArrowRight class="size-4 text-slate-400 group-hover:text-[#ff762b] group-hover:translate-x-1 transition-all shrink-0 mt-1" />
            </div>

            <!-- Metric Summary Text -->
            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-body mb-4">
              {card.summary}
            </p>

            <!-- Metrics Badges -->
            <div class="grid grid-cols-2 gap-3 pt-3 border-t border-white/10">
              {card.metrics.map((m) => (
                <div class="bg-[#061d33]/60 rounded-xl p-2.5 border border-white/10">
                  <div class="font-heading font-bold text-lg sm:text-xl text-[#ddff35]">
                    {m.value}
                  </div>
                  <div class="text-[11px] font-mono text-slate-300 mt-0.5">{m.label}</div>
                </div>
              ))}
            </div>
          </a>
        ))}

        <!-- Proof Panel 2: Wajib Livestock -->
        {hero.proofCards.slice(1, 2).map((card) => (
          <a
            href={`${site.basePath}${card.href}`}
            class="group block rounded-2xl border border-white/15 bg-white/5 p-5 sm:p-6 backdrop-blur-md hover:border-[#ddff35]/60 hover:bg-white/10 transition-all duration-300 shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
          >
            <div class="flex items-start justify-between gap-3 mb-3">
              <div>
                <h2 class="font-heading font-bold text-lg sm:text-xl text-white group-hover:text-[#ddff35] transition-colors">
                  {card.brand}
                </h2>
                <p class="text-xs font-mono text-slate-300 mt-0.5">{card.context}</p>
              </div>
              <ArrowRight class="size-4 text-slate-400 group-hover:text-[#ddff35] group-hover:translate-x-1 transition-all shrink-0 mt-1" />
            </div>

            <!-- Metric Summary Text -->
            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed font-body mb-4">
              {card.summary}
            </p>

            <!-- Metrics Badges -->
            <div class="grid grid-cols-2 gap-3 pt-3 border-t border-white/10">
              {card.metrics.map((m) => (
                <div class="bg-[#061d33]/60 rounded-xl p-2.5 border border-white/10">
                  <div class="font-heading font-bold text-lg sm:text-xl text-[#ff762b]">
                    {m.value}
                  </div>
                  <div class="text-[11px] font-mono text-slate-300 mt-0.5">{m.label}</div>
                </div>
              ))}
            </div>
          </a>
        ))}

      </div>

    </div>
  </div>
</section>

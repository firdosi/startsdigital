---
import { brands } from '../../data/brands';
import { site } from '../../site.config';

// All 12 approved brand logos — exactly 12 in DOM, no duplicates
const activeBrands = brands.filter(b => b.active && b.logoApproved && b.logo).map(b => {
  let logoAsset = b.logo!;
  if (logoAsset.endsWith('/logo.webp')) {
    logoAsset = logoAsset.replace('/logo.webp', '/logo-transparent.webp');
  }
  const logoUrl = logoAsset.startsWith('/') ? `${site.basePath}${logoAsset}` : logoAsset;

  return {
    id: b.id,
    name: b.name,
    logo: logoUrl,
    darkLogoContainer: b.darkLogoContainer || false
  };
});

// Explicit per-brand sizing & proportion metadata for white cards
const brandSizingMap: Record<string, { maxWidth: string; maxHeight: string; scale?: number }> = {
  'clearzone-immigration': { maxWidth: '120px', maxHeight: '36px', scale: 0.95 },
  'rapidzone': { maxWidth: '120px', maxHeight: '36px', scale: 1.0 },
  'rapidline-immigration-services': { maxWidth: '140px', maxHeight: '42px', scale: 1.05 },
  'convort-ai': { maxWidth: '125px', maxHeight: '38px', scale: 1.0 },
  'rk-reno-solutions': { maxWidth: '135px', maxHeight: '42px', scale: 1.05 },
  'black-gold-fertilizer': { maxWidth: '145px', maxHeight: '48px', scale: 1.15 },
  'wajib-livestock': { maxWidth: '130px', maxHeight: '42px', scale: 1.05 },
  'riyadh-finish-pro': { maxWidth: '145px', maxHeight: '52px', scale: 1.25 },
  'viral-naturals': { maxWidth: '130px', maxHeight: '40px', scale: 1.0 },
  'shopinq-online': { maxWidth: '120px', maxHeight: '36px', scale: 0.95 },
  'super-safety-covers': { maxWidth: '135px', maxHeight: '40px', scale: 1.05 },
  'unique-lahore-lab-sahiwal': { maxWidth: '135px', maxHeight: '40px', scale: 1.05 }
};
---

<section id="brand-logos" class="py-16 sm:py-20 bg-[#061d33] text-white relative border-t border-b border-white/10">
  <!-- Soft ambient radial backlight -->
  <div class="absolute inset-0 pointer-events-none opacity-30" style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(255,118,43,0.12) 0%, transparent 70%);" aria-hidden="true"></div>

  <div class="max-w-[1280px] mx-auto px-6 sm:px-8 relative z-10 space-y-10">

    <!-- Section Header -->
    <div class="text-center space-y-3">
      <span class="inline-block font-mono text-xs uppercase tracking-widest text-[#ddff35]">
        Proven Business Partnerships
      </span>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white">
        Brands We Have Supported&nbsp;&amp;&nbsp;Built&nbsp;With
      </h2>
      <p class="font-body text-sm sm:text-base text-slate-300 max-w-xl mx-auto">
        Engagements across e-commerce, seasonal campaigns, renovation services, immigration and tech platforms.
      </p>
    </div>

    <!-- Single Responsive White Card Grid (Exactly 12 logo cards in DOM) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-5 logo-grid">
      {activeBrands.map((b, idx) => {
        const sizing = brandSizingMap[b.id] || { maxWidth: '130px', maxHeight: '40px', scale: 1.0 };

        return (
          <div
            data-client-logo
            data-client-brand-id={b.id}
            style={`animation-delay: ${idx * 40}ms; background-color: #ffffff;`}
            class="rounded-2xl border border-white/20 bg-white p-3 sm:p-4 flex items-center justify-center h-[88px] sm:h-[100px] shadow-sm hover:shadow-xl hover:border-[#ff762b] hover:-translate-y-0.5 transition-all duration-300 cursor-default select-none overflow-hidden"
          >
            {b.id === 'black-gold-fertilizer' ? (
              <div class="flex items-center justify-center gap-2 sm:gap-2.5 w-full px-1">
                <img
                  src={b.logo}
                  alt={`${b.name} logo mark`}
                  loading="lazy"
                  decoding="async"
                  width="44"
                  height="44"
                  style="max-width: 38px; max-height: 38px;"
                  class="w-auto h-auto object-contain shrink-0"
                />
                <span class="font-bold text-[#061d33] text-xs sm:text-[13px] leading-tight text-left">
                  Black Gold Fertilizer
                </span>
              </div>
            ) : b.darkLogoContainer ? (
              <div class="bg-[#061d33] px-3.5 py-2 rounded-xl flex items-center justify-center w-full h-full max-h-[58px] shadow-inner">
                <img
                  src={b.logo}
                  alt={`${b.name} logo`}
                  loading="lazy"
                  decoding="async"
                  width="140"
                  height="50"
                  style={`max-width: ${sizing.maxWidth}; max-height: ${sizing.maxHeight}; transform: scale(${sizing.scale || 1.0});`}
                  class="w-auto object-contain transition-transform"
                />
              </div>
            ) : (
              <img
                src={b.logo}
                alt={`${b.name} logo`}
                loading="lazy"
                decoding="async"
                width="140"
                height="50"
                style={`max-width: ${sizing.maxWidth}; max-height: ${sizing.maxHeight}; transform: scale(${sizing.scale || 1.0});`}
                class="w-auto object-contain transition-transform"
              />
            )}
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  /* Gentle staggered entrance for logo tiles */
  @media (prefers-reduced-motion: no-preference) {
    .logo-grid > div {
      opacity: 0;
      transform: translateY(8px);
      animation: logo-appear 0.45s ease-out forwards;
    }
  }

  @keyframes logo-appear {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

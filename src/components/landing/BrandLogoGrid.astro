---
import { brands } from '../../data/brands';
import { site } from '../../site.config';

// All 12 active brand logos — shown exactly once, no duplicates
const activeBrands = brands.filter(b => b.active && b.logo).map(b => ({
  name: b.name,
  logo: b.logo!.startsWith('/') ? `${site.basePath}${b.logo}` : b.logo!,
  darkContainer: !!b.darkLogoContainer
}));
---

<section id="brand-logos" class="py-16 sm:py-20 bg-[#061d33] text-white relative border-t border-b border-white/10">
  <!-- Soft ambient radial backlight -->
  <div class="absolute inset-0 pointer-events-none opacity-30" style="background: radial-gradient(ellipse 60% 50% at 50% 50%, rgba(255,118,43,0.12) 0%, transparent 70%);" aria-hidden="true"></div>

  <div class="max-w-[1280px] mx-auto px-6 sm:px-8 relative z-10">

    <!-- Section Header -->
    <div class="text-center mb-10 sm:mb-12 space-y-3">
      <span class="inline-block font-mono text-xs uppercase tracking-widest text-[#ddff35]">
        Proven Business Partnerships
      </span>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white">
        Brands We Have Supported&nbsp;&amp;&nbsp;Built&nbsp;With
      </h2>
      <p class="font-body text-sm sm:text-base text-slate-300 max-w-xl mx-auto">
        Engagements across e-commerce, seasonal campaigns, renovation services, immigration and tech platforms.
      </p>
    </div>

    <!-- Desktop: Balanced static grid (all 12 logos once) -->
    <div class="hidden sm:grid sm:grid-cols-4 lg:grid-cols-6 gap-4 logo-grid">
      {activeBrands.map((b, idx) => (
        <div
          class="rounded-2xl border border-white/15 bg-white/5 p-4 flex items-center justify-center h-[80px] sm:h-[88px] hover:border-[#ff762b]/50 hover:bg-white/10 hover:-translate-y-0.5 transition-all duration-300 cursor-default select-none"
          style={`animation-delay: ${idx * 40}ms`}
        >
          <img
            src={b.logo}
            alt={`${b.name}`}
            loading="lazy"
            decoding="async"
            width="140"
            height="50"
            class="max-h-10 sm:max-h-11 w-auto object-contain"
          />
        </div>
      ))}
    </div>

    <!-- Mobile: Horizontal scroll-snap (all 12 logos once, no auto-scroll, no links) -->
    <div class="sm:hidden -mx-6 px-6 overflow-x-auto scroll-snap-x-mandatory scrollbar-hide">
      <div class="flex gap-3 w-max pb-2">
        {activeBrands.map((b) => (
          <div
            class="snap-start shrink-0 rounded-2xl border border-white/15 bg-white/5 p-4 flex items-center justify-center w-[140px] h-[78px] cursor-default select-none"
          >
            <img
              src={b.logo}
              alt={`${b.name}`}
              loading="lazy"
              decoding="async"
              width="110"
              height="40"
              class="max-h-9 w-auto object-contain"
            />
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  /* Gentle staggered entrance for logo tiles */
  @media (prefers-reduced-motion: no-preference) {
    .logo-grid > div {
      opacity: 0;
      transform: translateY(8px);
      animation: logo-appear 0.45s ease-out forwards;
    }
  }

  @keyframes logo-appear {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Hide scrollbar on mobile logo row */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }

  .scroll-snap-x-mandatory {
    scroll-snap-type: x mandatory;
  }
</style>

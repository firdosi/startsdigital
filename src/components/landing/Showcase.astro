---
import { site } from '../../site.config';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import BrandLogoWall from '../work/BrandLogoWall.astro';
import CombinedAchievements from '../work/CombinedAchievements.astro';
import { ArrowRight } from '@lucide/astro';
---

<section id="work" class="py-16 sm:py-24 bg-[#061d33] text-white scroll-mt-[100px] border-b border-white/10">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    <!-- Section Eyebrow & Title -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <SectionEyebrow
        label="COMBINED COMMERCIAL ACHIEVEMENTS"
        align="center"
        motion={false}
      />
      <h2 class="font-heading font-bold text-[32px] sm:text-[42px] lg:text-[48px] text-white leading-[1.12] tracking-[-0.03em]">
        What Our Team Has Delivered
      </h2>
      <p class="text-base sm:text-lg text-slate-300 font-body leading-relaxed font-normal">
        Aggregate commercial outcomes delivered across paid advertising, custom web development, local search, creative content, and AI workflows.
      </p>
    </div>
  </div>

  <!-- A. Compact Combined Achievements -->
  <CombinedAchievements />

  <!-- B. Premium Unlinked Logo Wall -->
  <BrandLogoWall />

  <!-- C. Visual CTA to General Work Page -->
  <div class="py-12 bg-[#061d33] text-center border-t border-white/10">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8 space-y-6">
      <h3 class="font-heading font-bold text-2xl sm:text-3xl text-white">
        Explore Combined Work & Capability Breakdown
      </h3>
      <div>
        <a
          href={`${site.basePath}/work/`}
          class="inline-flex items-center gap-2.5 rounded-full bg-[#ff762b] px-8 py-4 font-body font-semibold text-base text-white shadow-xl hover:bg-[#e0611a] transition-all duration-200"
        >
          <span>Explore Digital Work & Results</span>
          <ArrowRight class="size-5" />
        </a>
      </div>
    </div>
  </div>
</section>

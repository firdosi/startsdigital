---
import { site } from '../../site.config';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { 
  Sprout, 
  TrendingUp, 
  Wrench, 
  MapPin, 
  ArrowRight,
  ShoppingBag,
  ExternalLink,
  Cpu,
  CheckCircle2
} from '@lucide/astro';

interface Props {
  showAllWorkButton?: boolean;
}

const { showAllWorkButton = true } = Astro.props;

const featuredProjects = [
  {
    id: 'black-gold-fertilizer',
    name: 'Black Gold Fertilizer',
    category: 'AGRICULTURE',
    number: '01',
    description: 'Contributed to PKR 30M+ in delivered-order revenue and 29,000+ product sales across multiple product categories through managed digital campaigns.',
    logo: '/brands/black-gold-fertilizer/logo.webp',
    darkLogoContainer: true,
    link: '/work/black-gold-fertilizer/',
    website: 'https://blackgoldfertilizer.com',
    facebook: 'https://www.facebook.com/profile.php?id=61561083447093',
    image: '/images/black-gold-official.png',
    metrics: [
      { label: 'Revenue Supported', value: 'PKR 30M+' },
      { label: 'Product Sales', value: '29,000+' }
    ]
  },
  {
    id: 'wajib-livestock',
    name: 'Wajib Livestock',
    category: 'LIVESTOCK',
    number: '02',
    description: 'Supported seasonal Qurbani marketing through paid social advertising, lead generation, campaign creative, WhatsApp routing, and digital sales support.',
    logo: '/brands/wajib-livestock/logo.webp',
    darkLogoContainer: true,
    link: '/work/qurbani-campaign/',
    website: 'https://wajib.pk',
    facebook: 'https://www.facebook.com/profile.php?id=61579219484606',
    metrics: [
      { label: 'Animals Sold', value: '150+' },
      { label: 'Sales Supported', value: 'PKR 4.2M+' }
    ]
  },
  {
    id: 'rk-reno-solutions',
    name: 'RK Reno Solutions',
    category: 'RENOVATION',
    number: '03',
    description: 'Built a structured SEO foundation targeting renovation and air-conditioning services in Kuala Lumpur and Selangor.',
    logo: '/brands/rk-reno-solutions/logo.webp',
    darkLogoContainer: false,
    link: '/work/rk-reno-solutions/',
    website: 'https://rkrenosolution.com',
    image: '/brands/rk-reno-solutions/screenshot.webp',
    scope: [
      'Kuala Lumpur & Selangor SEO Scope',
      'Renovation & HVAC Architecture'
    ]
  },
  {
    id: 'convort-ai',
    name: 'ConvortAI',
    category: 'TECHNOLOGY',
    number: '04',
    relationship: 'TECHNOLOGY PARTNER',
    description: 'Starts Digital developed the ConvortAI web application and continues supporting product development, project management, social media, creative production and growth.',
    logo: '/brands/convort-ai/logo.webp',
    darkLogoContainer: true,
    link: '/work/#convortai',
    website: 'https://convortai.com/',
    scope: [
      'Web App Development',
      'Product & Growth Support'
    ]
  }
];
---

<section id="work" class="py-16 sm:py-20 lg:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
      <div class="space-y-3 max-w-2xl">
        <SectionEyebrow
          label="SELECTED WORK"
          align="left"
          delay={0}
        />
        <h2 data-motion="clip-up" data-motion-delay="100" class="font-heading font-bold text-[28px] md:text-[36px] lg:text-[40px] text-[#061d33] leading-[1.15] tracking-[-0.025em]">
          Different businesses require different combinations of strategy and execution.
        </h2>
        <p data-motion="fade-up" data-motion-delay="200" class="text-base text-slate-700 font-body leading-relaxed font-normal">
          Explore selected projects across e-commerce, seasonal campaigns, local services and technology.
        </p>
      </div>
      {showAllWorkButton && (
        <div data-motion="pop-in" data-motion-delay="200" class="shrink-0">
          <a
            href={`${site.basePath}/work/`}
            class="inline-flex items-center gap-2 rounded-full border-2 border-[#061d33] bg-white px-6 py-3 font-body font-semibold text-sm text-[#061d33] hover:bg-[#ff762b] hover:border-[#ff762b] hover:text-white transition-all shadow-sm group/cta"
          >
            <span>View all client work</span>
            <ArrowRight class="size-4 group-hover/cta:translate-x-1 transition-transform" />
          </a>
        </div>
      )}
    </div>

    <!-- 4 Featured Case-Study Grid (2x2 Grid Desktop) -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      {featuredProjects.map((p, idx) => (
        <article
          data-motion="fade-up"
          data-motion-delay={idx * 100}
          class="rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-8 flex flex-col justify-between shadow-xs hover:border-[#ff762b]/40 hover:shadow-md transition-all duration-300 group"
        >
          <div class="space-y-5">
            <!-- Header Row: Category Tag, Logo Container & Number -->
            <div class="flex items-center justify-between gap-3 pb-4 border-b border-[#061d33]/8">
              <div class="flex items-center gap-2">
                <span class="rounded-full bg-[#ff762b]/15 border border-[#ff762b]/30 px-3 py-0.5 text-xs font-mono font-bold text-[#ff762b] uppercase tracking-wider">
                  {p.category}
                </span>
                {p.relationship && (
                  <span class="rounded-full bg-[#061d33] px-2.5 py-0.5 text-[10px] font-mono font-semibold text-[#ddff35] uppercase">
                    PARTNER
                  </span>
                )}
              </div>

              <!-- Brand Logo Container -->
              <div class={`h-11 w-32 rounded-xl px-2.5 py-1.5 flex items-center justify-center border ${p.darkLogoContainer ? 'bg-[#061d33] border-[#061d33]' : 'bg-white border-slate-200'}`}>
                <img
                  src={`${site.basePath}${p.logo}`}
                  alt={`${p.name} logo`}
                  width="120"
                  height="36"
                  loading="lazy"
                  class="max-h-7 w-auto object-contain"
                />
              </div>
            </div>

            <!-- Title & Description -->
            <div>
              <h3 class="font-heading font-bold text-2xl text-[#061d33] group-hover:text-[#ff762b] transition-colors leading-tight mb-2">
                {p.name}
              </h3>
              <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
                {p.description}
              </p>
            </div>

            <!-- Contextual Highlights (Metrics or Scope) -->
            {p.metrics && (
              <div class="grid grid-cols-2 gap-3 p-3.5 rounded-2xl bg-[#f7f4ed] border border-[#061d33]/8">
                {p.metrics.map((m) => (
                  <div>
                    <span class="font-heading font-bold text-lg text-[#061d33] block">{m.value}</span>
                    <span class="text-xs font-body font-semibold text-slate-600">{m.label}</span>
                  </div>
                ))}
              </div>
            )}

            {p.scope && (
              <div class="flex flex-wrap gap-2 pt-1">
                {p.scope.map((s) => (
                  <span class="inline-flex items-center gap-1.5 rounded-lg bg-[#f7f4ed] px-3 py-1.5 text-xs font-mono font-medium text-[#061d33] border border-[#061d33]/10">
                    <CheckCircle2 class="size-3 text-[#ff762b]" />
                    <span>{s}</span>
                  </span>
                ))}
              </div>
            )}
          </div>

          <!-- Bottom Action Buttons -->
          <div class="flex flex-wrap items-center gap-3 pt-5 mt-6 border-t border-[#061d33]/8 font-body">
            <a
              href={`${site.basePath}${p.link}`}
              data-track="case-study-open"
              class="inline-flex items-center gap-2 rounded-full bg-[#061d33] px-5 py-2.5 text-xs sm:text-sm font-semibold text-white hover:bg-[#ff762b] transition-all shadow-xs"
            >
              <span>Explore project</span>
              <ArrowRight class="size-4 group-hover:translate-x-1 transition-transform" />
            </a>

            {p.website && (
              <a
                href={p.website}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${p.name} official website`}
                class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-[#f7f4ed] px-4 py-2.5 text-xs sm:text-sm font-semibold text-[#061d33] hover:border-[#061d33] hover:bg-white transition-all shadow-xs"
              >
                <span>Website</span>
                <ExternalLink class="size-3.5" />
              </a>
            )}
          </div>

        </article>
      ))}

    </div>

  </div>
</section>

---
import { site } from '../../site.config';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { ArrowRight, Sparkles, ShoppingBag, Wrench, Calendar, Cpu } from '@lucide/astro';

const industryPreviews = [
  {
    title: 'E-Commerce Product Brands',
    description: 'Direct-to-consumer storefronts, WooCommerce optimization, product ad creative, and customer retention.',
    icon: ShoppingBag,
    color: 'text-[#ff762b]',
    href: '/industries/ecommerce-product-brands/'
  },
  {
    title: 'Local Service Contractors',
    description: 'Renovation, HVAC, and local service businesses built for Google Maps ranking and direct phone inquiries.',
    icon: Wrench,
    color: 'text-[#39c98a]',
    href: '/industries/local-service-businesses/'
  },
  {
    title: 'Seasonal Campaigns',
    description: 'High-demand promotional windows, rapid lead generation, WhatsApp sales routing, and seasonal ad strategy.',
    icon: Calendar,
    color: 'text-[#ddff35]',
    href: '/industries/seasonal-campaigns/'
  },
  {
    title: 'Technology & Software Products',
    description: 'Web application development, SaaS product landing pages, AI character workflows, and digital growth support.',
    icon: Cpu,
    color: 'text-[#38bdf8]',
    href: '/industries/technology-products/'
  }
];
---

<section id="work" class="py-16 sm:py-24 bg-[#061d33] text-white scroll-mt-[100px] border-b border-white/10">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    <!-- Section Eyebrow & Title -->
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <SectionEyebrow
        label="SECTOR CAPABILITIES"
        align="center"
        motion={false}
      />
      <h2 class="font-heading font-bold text-[32px] sm:text-[42px] lg:text-[48px] text-white leading-[1.12] tracking-[-0.03em]">
        Tailored Solutions for Key Business Sectors
      </h2>
      <p class="text-base sm:text-lg text-slate-300 font-body leading-relaxed font-normal">
        Explore how Starts Digital coordinates paid advertising, website development, local search, creative production, and AI workflows across different industry business models.
      </p>

      <!-- Homepage Marketing System Picture Composition -->
      <div class="pt-6 max-w-4xl mx-auto">
        <div class="rounded-3xl overflow-hidden border border-white/15 shadow-2xl bg-white/5 p-2">
          <picture>
            <source srcset={`${site.basePath}/visuals/marketing-system-visual.avif`} type="image/avif" />
            <img
              src={`${site.basePath}/visuals/marketing-system-visual.webp`}
              alt="Starts Digital Marketing System and Digital Strategy Composition"
              width="800"
              height="600"
              loading="eager"
              decoding="async"
              class="w-full h-auto object-cover rounded-2xl"
            />
          </picture>
        </div>
      </div>
    </div>

    <!-- 4 Industry Sector Preview Cards Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 my-12">
      {industryPreviews.map((ind) => {
        const IconComp = ind.icon;
        return (
          <a
            href={`${site.basePath}${ind.href}`}
            class="group rounded-3xl border border-white/15 bg-white/5 p-6 flex flex-col justify-between space-y-5 hover:border-white/30 hover:bg-white/10 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
          >
            <div class="space-y-3">
              <div class="size-10 rounded-2xl border border-white/15 bg-white/10 flex items-center justify-center">
                <IconComp class={`size-5 ${ind.color}`} />
              </div>
              <h3 class="font-heading font-bold text-lg text-white group-hover:text-[#ddff35] transition-colors leading-snug">
                {ind.title}
              </h3>
              <p class="font-body text-xs text-slate-300 leading-relaxed font-normal">
                {ind.description}
              </p>
            </div>
            <div class="flex items-center gap-1.5 text-xs font-mono text-slate-400 group-hover:text-white transition-colors">
              <span>View Industry Solutions</span>
              <ArrowRight class="size-3.5 text-[#ff762b] group-hover:translate-x-1 transition-transform" />
            </div>
          </a>
        );
      })}
    </div>

    <!-- Visual CTA to General Work Page -->
    <div class="pt-8 text-center border-t border-white/10">
      <a
        href={`${site.basePath}/work/`}
        class="inline-flex items-center gap-2.5 rounded-full bg-[#ff762b] px-8 py-4 font-body font-semibold text-base text-white shadow-xl hover:bg-[#e0611a] transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
      >
        <span>Explore Work & Capabilities</span>
        <ArrowRight class="size-5" />
      </a>
    </div>
  </div>
</section>

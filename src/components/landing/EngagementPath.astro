---
import { site } from '../../site.config';
import { homepageContent } from '../../data/homepage';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { ArrowRight, CheckCircle, MessageSquare } from '@lucide/astro';

const { engagementPath } = homepageContent;
---

<section id="engagement-path" class="py-16 sm:py-20 lg:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 sm:mb-16 text-center space-y-3 max-w-2xl mx-auto">
      <SectionEyebrow
        label={engagementPath.eyebrow}
        align="center"
        delay={0}
      />
      <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        {engagementPath.heading}
      </h2>
      <p data-motion="fade-up" data-motion-delay="200" class="text-base sm:text-lg text-slate-700 font-body leading-relaxed font-normal">
        {engagementPath.paragraph}
      </p>
    </div>

    <!-- 3 Numbered Steps Grid -->
    <div data-motion="fade-up" data-motion-delay="250" class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 mb-12">
      {engagementPath.steps.map((step) => (
        <div class="rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-8 flex flex-col justify-between shadow-xs hover:border-[#ff762b]/40 transition-all">
          <div class="space-y-4">
            <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-3 py-1 rounded-full w-fit block">
              STEP {step.number}
            </span>
            <h3 class="font-heading font-bold text-xl sm:text-2xl text-[#061d33] leading-snug">
              {step.title}
            </h3>
            <p class="text-base text-slate-700 font-body leading-relaxed">
              {step.description}
            </p>
          </div>
        </div>
      ))}
    </div>

    <!-- Preparation Checklist Box -->
    <div data-motion="fade-up" data-motion-delay="350" class="rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-8 lg:p-10 shadow-xs max-w-4xl mx-auto">
      <div class="space-y-6">
        <div>
          <h3 class="font-heading font-bold text-lg sm:text-xl text-[#061d33] mb-1">
            {engagementPath.checklistHeader}
          </h3>
          <p class="text-sm text-slate-600 font-body">
            Providing these details during your initial inquiry allows us to understand your goals before our first conversation.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 pt-2 border-t border-[#061d33]/8">
          {engagementPath.checklistItems.map((item) => (
            <div class="flex items-center gap-2 text-xs sm:text-sm font-body font-semibold text-[#061d33]">
              <CheckCircle class="size-4 text-[#ff762b] shrink-0" />
              <span>{item}</span>
            </div>
          ))}
        </div>

        <!-- Action CTAs -->
        <div class="pt-6 border-t border-[#061d33]/8 flex flex-wrap items-center justify-between gap-4">
          <a
            href={`${site.basePath}${engagementPath.primaryCta.href}`}
            data-track="primary-cta"
            class="group inline-flex items-center gap-2.5 rounded-full bg-[#061d33] px-7 py-3.5 font-body font-semibold text-base text-white hover:bg-[#ff762b] transition-all shadow-md"
          >
            <span>{engagementPath.primaryCta.label}</span>
            <ArrowRight class="size-4 group-hover:translate-x-1 transition-transform" />
          </a>

          <a
            href={site.contact.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            data-track="contact-whatsapp"
            class="inline-flex items-center gap-2 text-sm font-body font-semibold text-[#061d33] hover:text-[#39c98a] transition-colors"
          >
            <MessageSquare class="size-4 text-[#39c98a]" />
            <span>{engagementPath.secondaryTextLink}</span>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>

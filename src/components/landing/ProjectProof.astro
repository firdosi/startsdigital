---
import { site } from '../../site.config';
import { homepageContent } from '../../data/homepage';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { ArrowRight, CheckCircle2, Cpu } from '@lucide/astro';

const { projectProof } = homepageContent;
---

<section id="project-proof" class="py-16 sm:py-20 lg:py-24 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px] sm:scroll-mt-[112px] lg:scroll-mt-[104px]">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 sm:mb-16 text-center space-y-3 max-w-2xl mx-auto">
      <SectionEyebrow
        label={projectProof.eyebrow}
        align="center"
        delay={0}
      />
      <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        {projectProof.heading}
      </h2>
      <p data-motion="fade-up" data-motion-delay="200" class="text-base sm:text-lg text-slate-700 font-body leading-relaxed font-normal">
        {projectProof.paragraph}
      </p>
    </div>

    <!-- Editorial Project Rows (Alternating Layout) -->
    <div class="space-y-8 sm:space-y-10">
      
      <!-- ROW 1: RK RENO SOLUTIONS (Direct Screenshot Media Container) -->
      {(projectProof?.items || []).slice(0, 1).map((item: any) => (
        <div
          data-motion="fade-up"
          data-motion-delay="300"
          class="rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-8 lg:p-10 shadow-xs hover:border-[#ff762b]/40 transition-all duration-300 group"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            
            <!-- Project Visual Column (5 cols desktop) -->
            <div class="lg:col-span-5 order-2 lg:order-1">
              <a href={`${site.basePath}${item.link}`} class="block overflow-hidden rounded-2xl border border-[#061d33]/15 bg-white shadow-md relative group-hover:border-[#ff762b]/50 transition-all">
                <img
                  src={`${site.basePath}${item.imagePath}`}
                  alt={`${item.brand} website screenshot`}
                  width="600"
                  height="400"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-[260px] sm:h-[300px] object-cover object-top group-hover:scale-102 transition-transform duration-500"
                />
                <div class="px-4 py-2 bg-[#f7f4ed] border-t border-[#061d33]/10 text-center">
                  <span class="text-xs font-mono text-slate-600 font-medium">RK Reno Solutions website</span>
                </div>
              </a>
            </div>

            <!-- Project Details Column (7 cols desktop) -->
            <div class="lg:col-span-7 order-1 lg:order-2 space-y-5">
              <div class="flex flex-wrap items-center gap-3">
                <span class="inline-block px-3 py-1 rounded-full bg-[#f7f4ed] text-[#061d33] font-mono text-xs font-semibold uppercase tracking-wider border border-[#061d33]/10">
                  {item.sector}
                </span>
                <span class="text-xs font-mono text-slate-500">Website & Local SEO Scope</span>
              </div>

              <h3 class="font-heading font-bold text-2xl sm:text-3xl text-[#061d33] group-hover:text-[#ff762b] transition-colors">
                {item.brand}
              </h3>

              <div class="space-y-3 text-base text-slate-700 font-body">
                <p class="leading-relaxed">
                  <strong class="font-semibold text-[#061d33]">Starts Digital Contribution:</strong> {item.contribution}
                </p>
              </div>

              <!-- Demonstrated Services Tags -->
              <div class="space-y-2 pt-1">
                <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 block">
                  Demonstrated Capabilities
                </span>
                <div class="flex flex-wrap gap-2">
                  {item.tags.map((tag: string) => (
                    <span class="inline-flex items-center gap-1.5 rounded-lg bg-[#f7f4ed] px-3 py-1.5 text-xs font-mono font-medium text-[#061d33] border border-[#061d33]/10">
                      <CheckCircle2 class="size-3.5 text-[#ff762b]" />
                      <span>{tag}</span>
                    </span>
                  ))}
                </div>
              </div>

              <div class="pt-2">
                <a
                  href={`${site.basePath}${item.link}`}
                  class="inline-flex items-center gap-2 font-heading font-semibold text-base text-[#061d33] group-hover:text-[#ff762b] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] transition-colors"
                >
                  <span>Explore Case Study</span>
                  <ArrowRight class="size-4 text-[#ff762b] group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </div>

          </div>
        </div>
      ))}

      <!-- ROW 2: CONVORTAI (Typography & Technology-Led Deep Navy Row) -->
      {(projectProof?.items || []).slice(1, 2).map((item: any) => (
        <div
          data-motion="fade-up"
          data-motion-delay="400"
          class="rounded-3xl border border-white/20 bg-[#061d33] text-white p-6 sm:p-8 lg:p-10 shadow-xl relative overflow-hidden group"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center relative z-10">
            
            <!-- Details & Contribution Column (7 cols desktop) -->
            <div class="lg:col-span-7 space-y-5">
              <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex items-center gap-2 rounded-full border border-[#ddff35]/50 bg-[#ddff35]/15 px-3.5 py-1 text-xs font-mono font-bold uppercase tracking-wider text-[#ddff35]">
                  <Cpu class="size-3.5 text-[#ddff35]" />
                  <span>{item.relationship}</span>
                </span>
                <span class="text-xs font-mono text-slate-300">{item.sector}</span>
              </div>

              <div>
                <h3 class="font-heading font-bold text-2xl sm:text-3xl text-white group-hover:text-[#ddff35] transition-colors">
                  {item.brand}
                </h3>
                <p class="text-sm font-mono text-[#ff762b] font-semibold mt-1">
                  {item.extendedRelationship}
                </p>
              </div>

              <p class="text-base text-slate-200 font-body leading-relaxed">
                {item.contribution}
              </p>

              <!-- 6 Contribution Areas Grid (No truncate class!) -->
              <div class="space-y-2 pt-1">
                <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 block">
                  Partnership Scope
                </span>
                <div class="flex flex-wrap gap-2">
                  {item.tags.map((tag: string) => (
                    <div class="inline-flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-mono text-white border border-white/15">
                      <CheckCircle2 class="size-3.5 text-[#39c98a] shrink-0" />
                      <span class="whitespace-normal">{tag}</span>
                    </div>
                  ))}
                </div>
              </div>

              <div class="pt-2">
                <a
                  href={`${site.basePath}${item.link}`}
                  class="inline-flex items-center gap-2 font-heading font-semibold text-base text-[#ddff35] group-hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] transition-colors"
                >
                  <span>Explore Partner Details</span>
                  <ArrowRight class="size-4 text-[#ddff35] group-hover:translate-x-1 transition-transform" />
                </a>
              </div>
            </div>

            <!-- Brand Logo Badge Column (5 cols desktop) -->
            <div class="lg:col-span-5 flex items-center justify-center">
              <div class="w-full max-w-[320px] aspect-[4/3] rounded-2xl bg-[#0b2947] border border-white/15 p-8 flex flex-col items-center justify-center text-center shadow-lg group-hover:border-[#ddff35]/50 transition-all">
                <div class="w-full h-16 flex items-center justify-center mb-3">
                  <img
                    src={`${site.basePath}${item.logoPath}`}
                    alt="ConvortAI official logo"
                    width="200"
                    height="60"
                    loading="lazy"
                    class="max-h-12 w-auto object-contain"
                  />
                </div>
                <span class="text-xs font-mono font-semibold text-[#ff762b] uppercase tracking-wider">
                  TECHNOLOGY PARTNER
                </span>
                <span class="text-[11px] font-mono text-slate-400 mt-1">
                  Product & Growth Support
                </span>
              </div>
            </div>

          </div>
        </div>
      ))}

    </div>

  </div>
</section>

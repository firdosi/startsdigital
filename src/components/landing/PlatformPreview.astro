---
import { toolEcosystem } from '../../data/tool-ecosystem';
import { site } from '../../site.config';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { ArrowRight } from '@lucide/astro';

const primaryToolIds = [
  'meta-ads',
  'google-ads',
  'google-analytics-4',
  'google-search-console',
  'wordpress',
  'woocommerce',
  'shopify',
  'canva',
  'adobe-premiere-pro',
  'whatsapp-business',
  'openai',
  'google-gemini'
];

const selectedTools = primaryToolIds
  .map(id => toolEcosystem.find(t => t.id === id))
  .filter((t): t is typeof toolEcosystem[number] => Boolean(t));

const logoSrc = (asset: string | null) => asset ? (asset.startsWith('http') ? asset : `${site.basePath}${asset}`) : '';
---

<section id="platform-preview" class="py-16 sm:py-20 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px]">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8 space-y-10">

    <!-- Section Header -->
    <div class="max-w-3xl text-center mx-auto space-y-3">
      <SectionEyebrow
        label="CORE TECHNOLOGY STACK"
        align="center"
        delay={0}
      />
      <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-2xl sm:text-3xl lg:text-4xl text-[#061d33] leading-snug tracking-tight">
        Core Platforms &amp; Software We Rely On
      </h2>
      <p data-motion="fade-up" data-motion-delay="200" class="text-sm sm:text-base text-slate-700 font-body max-w-xl mx-auto">
        A snapshot of the key platforms driving our advertising, analytics, development, design, and AI workflows.
      </p>
    </div>

    <!-- Responsive Compact White Logo Cards Grid (6 across desktop, 3-4 tablet, 2 mobile, balanced) -->
    <div class="flex flex-wrap justify-center gap-3 sm:gap-4 max-w-5xl mx-auto">
      {selectedTools.map((t, idx) => (
        <div
          data-tool-logo
          data-tool-id={t.id}
          style="background-color: #ffffff;"
          class="w-[calc(50%-0.375rem)] sm:w-[calc(33.333%-0.67rem)] md:w-[calc(25%-0.75rem)] lg:w-[calc(16.666%-0.7rem)] rounded-2xl border border-[#061d33]/12 bg-white p-3 sm:p-4 flex flex-col items-center justify-center text-center shadow-xs hover:shadow-md hover:border-[#ff762b] hover:-translate-y-0.5 transition-all duration-300 h-[110px] sm:h-[120px] group overflow-hidden shrink-0"
        >
          <div class="h-10 sm:h-12 w-full flex items-center justify-center p-1 group-hover:scale-105 transition-transform duration-300">
            <img
              src={logoSrc(t.localAsset)}
              alt={t.alt}
              width="48"
              height="48"
              loading="lazy"
              decoding="async"
              style={`max-width: ${t.maxWidth || '44px'}; max-height: ${t.maxHeight || '44px'}; transform: scale(${t.displayScale || 1.0});`}
              class="object-contain w-auto h-auto"
            />
          </div>

          <div class="mt-2 w-full px-1">
            <h3 class="font-heading font-bold text-xs sm:text-[13px] text-[#061d33] leading-tight group-hover:text-[#ff762b] transition-colors truncate">
              {t.name}
            </h3>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA to Full Tools Page -->
    <div class="text-center pt-2">
      <a
        href={`${site.basePath}/tools/`}
        class="inline-flex items-center gap-2 rounded-full border border-[#061d33] bg-[#061d33] px-6 py-3 font-body font-semibold text-sm text-white hover:bg-[#ff762b] hover:border-[#ff762b] transition-all shadow-sm hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] min-h-[44px]"
      >
        <span>Explore Our Full Technology Stack</span>
        <ArrowRight class="size-4" />
      </a>
    </div>

  </div>
</section>

---
import { site } from '../../site.config';
import { homepageContent } from '../../data/homepage';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { ArrowRight, Check } from '@lucide/astro';

const { services } = homepageContent;
---

<section id="services" class="py-16 sm:py-20 lg:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 relative">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 sm:mb-16 text-center max-w-2xl mx-auto space-y-3">
      <SectionEyebrow
        label={services.eyebrow}
        align="center"
        delay={0}
      />

      <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        {services.heading}
      </h2>

      <p data-motion="fade-up" data-motion-delay="200" class="text-sm sm:text-base text-slate-700 font-body leading-relaxed font-normal">
        {services.paragraph}
      </p>
    </div>

    <!-- 6-Service Editorial Grid -->
    <div data-motion="fade-up" data-motion-delay="250" class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.items.map((service) => (
          <a
            href={`${site.basePath}/services/`}
            data-track="service-link"
            class="group rounded-2xl border border-[#061d33]/12 bg-white p-6 sm:p-7 shadow-xs hover:border-[#ff762b]/50 hover:shadow-md transition-all duration-300 flex flex-col justify-between focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
          >
            <div>
              <!-- Top Row: Number & Icon/Accent -->
              <div class="flex items-center justify-between mb-4">
                <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-2.5 py-1 rounded">
                  SERVICE {service.number}
                </span>
                <ArrowRight class="size-4 text-slate-400 group-hover:text-[#ff762b] group-hover:translate-x-1 transition-all" />
              </div>

              <!-- Title -->
              <h3 class="font-heading font-bold text-xl text-[#061d33] group-hover:text-[#ff762b] transition-colors mb-2.5">
                {service.title}
              </h3>

              <!-- Description -->
              <p class="text-xs sm:text-sm text-slate-600 font-body leading-relaxed mb-5">
                {service.description}
              </p>
            </div>

            <!-- Practical Deliverables -->
            <div class="pt-4 border-t border-[#061d33]/8">
              <span class="text-[11px] font-mono font-semibold uppercase tracking-wider text-slate-400 block mb-2">
                PRACTICAL DELIVERABLES
              </span>
              <ul class="grid grid-cols-2 gap-x-2 gap-y-1.5">
                {service.deliverables.map((d) => (
                  <li class="flex items-center gap-1.5 text-xs font-body text-[#061d33]">
                    <Check class="size-3 text-[#ff762b] shrink-0" />
                    <span class="truncate">{d}</span>
                  </li>
                ))}
              </ul>
            </div>

          </a>
        ))
      }
    </div>

  </div>
</section>

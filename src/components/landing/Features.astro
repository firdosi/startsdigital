---
import { site } from '../../site.config';
import { homepageContent } from '../../data/homepage';
import { servicesData } from '../../data/services';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { ArrowRight, CheckCircle2 } from '@lucide/astro';

const { services } = homepageContent;
---

<section id="services" class="py-16 sm:py-20 lg:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 relative scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 sm:mb-16 text-center max-w-2xl mx-auto space-y-3">
      <SectionEyebrow
        label={services.eyebrow}
        align="center"
        motion={false}
      />

      <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        {services.heading}
      </h2>

      <p class="text-base sm:text-lg text-slate-700 font-body leading-relaxed font-normal">
        {services.paragraph}
      </p>
    </div>

    <!-- 6-Service Editorial Grid -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 mb-10">
      {
        servicesData.map((svc, idx) => {
          const targetUrl = `${site.basePath}/services/${svc.slug}/`;

          return (
            <a
              href={targetUrl}
              data-track="service-link"
              data-service={svc.slug}
              aria-label={`Explore ${svc.name} service`}
              class="group rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-7 shadow-xs hover:border-[#ff762b]/50 hover:shadow-md transition-all duration-300 flex flex-col justify-between focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
            >
              <div class="space-y-4">
                <!-- Top Row: Number & Icon/Accent -->
                <div class="flex items-center justify-between">
                  <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-2.5 py-1 rounded">
                    0{idx + 1} • {svc.shortName}
                  </span>
                  <div class="size-8 rounded-full bg-[#061d33]/5 text-[#061d33] group-hover:bg-[#ff762b] group-hover:text-white flex items-center justify-center transition-colors">
                    <ArrowRight class="size-4 group-hover:translate-x-0.5 transition-transform" />
                  </div>
                </div>

                <!-- Title -->
                <h3 class="font-heading font-bold text-2xl text-[#061d33] group-hover:text-[#ff762b] transition-colors">
                  {svc.name}
                </h3>

                <!-- Description >= 16px -->
                <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
                  {svc.summary}
                </p>

                <!-- Practical Deliverables >= 16px -->
                <div class="pt-3 border-t border-[#061d33]/8 space-y-2">
                  <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 block">
                    Practical Deliverables
                  </span>
                  <ul class="space-y-1.5">
                    {svc.idealFor.slice(0, 3).map((item) => (
                      <li class="flex items-start gap-2 text-xs font-mono text-slate-700">
                        <CheckCircle2 class="size-3.5 text-[#ff762b] shrink-0 mt-0.5" />
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- Action Footer -->
              <div class="pt-4 mt-6 border-t border-[#061d33]/8 flex items-center justify-between text-xs font-mono font-semibold text-[#061d33] group-hover:text-[#ff762b] transition-colors">
                <span>Explore Service</span>
                <ArrowRight class="size-3.5 group-hover:translate-x-1 transition-transform" />
              </div>
            </a>
          );
        })
      }
    </div>

    <!-- View All Services CTA -->
    <div class="text-center">
      <a
        href={`${site.basePath}/services/`}
        class="inline-flex items-center gap-2 rounded-full border border-[#061d33]/20 bg-white px-7 py-3.5 font-body font-semibold text-base text-[#061d33] hover:bg-[#061d33] hover:text-white transition-all shadow-xs"
      >
        <span>View All Services Directory</span>
        <ArrowRight class="size-4" />
      </a>
    </div>

  </div>
</section>

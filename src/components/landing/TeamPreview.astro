---
import { teamMembers, type TeamMember } from '../../data/team';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { site } from '../../site.config';

const visibleMembers: TeamMember[] = teamMembers
  .filter((m) => m.approvedForPublic && m.homepageVisible)
  .sort((a, b) => a.order - b.order);
---

{
  visibleMembers.length > 0 && (
    <section id="team" class="py-16 sm:py-20 lg:py-24 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px] sm:scroll-mt-[112px] lg:scroll-mt-[104px]">
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
        
        <!-- Section Header -->
        <div class="mb-12 text-center space-y-3 max-w-2xl mx-auto">
          <SectionEyebrow label="OUR TEAM" align="center" delay={0} />
          <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
            The People Behind the Work
          </h2>
          <p data-motion="fade-up" data-motion-delay="200" class="text-base text-slate-700 font-body leading-relaxed font-normal">
            Meet the approved people responsible for the services and project work presented by Starts Digital.
          </p>
        </div>

        <!-- Responsive Team Member Grid -->
        <div class="grid gap-6 sm:gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 justify-center">
          {visibleMembers.map((m) => (
            <div
              data-motion="fade-up"
              class="rounded-3xl border border-[#061d33]/12 bg-white p-6 shadow-xs flex flex-col justify-between group hover:border-[#ff762b]/40 transition-all"
            >
              <div class="space-y-4">
                <div class="aspect-square rounded-2xl overflow-hidden bg-slate-100 border border-[#061d33]/10">
                  <img
                    src={`${site.basePath}${m.image}`}
                    alt={m.name}
                    width="300"
                    height="300"
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-103 transition-transform duration-300"
                  />
                </div>
                <div>
                  <h3 class="font-heading font-bold text-xl text-[#061d33]">{m.name}</h3>
                  <p class="font-mono text-xs text-[#ff762b] font-semibold mt-0.5">{m.role}</p>
                </div>
                <p class="text-base text-slate-700 font-body leading-relaxed">{m.shortBio}</p>
              </div>

              {m.responsibilities && m.responsibilities.length > 0 && (
                <div class="pt-4 mt-4 border-t border-[#061d33]/8">
                  <span class="text-[11px] font-mono font-semibold text-slate-400 uppercase tracking-wider block mb-2">Focus</span>
                  <div class="flex flex-wrap gap-1.5">
                    {m.responsibilities.map((r) => (
                      <span class="text-xs font-mono bg-[#f7f4ed] text-[#061d33] px-2 py-0.5 rounded border border-[#061d33]/10">{r}</span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>

      </div>
    </section>
  )
}

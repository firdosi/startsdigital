---
import { teamMembers, type TeamMember } from '../../data/team';
import TeamMemberCard from '../team/TeamMemberCard.astro';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { site } from '../../site.config';
import { ArrowRight } from '@lucide/astro';

const visibleMembers: TeamMember[] = teamMembers
  .filter((m) => m.approvedForPublic && m.homepageVisible)
  .sort((a, b) => a.order - b.order);
---

{
  visibleMembers.length > 0 && (
    <section id="team-preview" class="py-16 sm:py-20 lg:py-24 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px] sm:scroll-mt-[112px] lg:scroll-mt-[104px]">
      <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
        
        <!-- Section Header -->
        <div class="mb-12 text-center space-y-3 max-w-2xl mx-auto">
          <SectionEyebrow label="THE PEOPLE BEHIND THE WORK" align="center" delay={0} />
          <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
            Meet the people supporting strategy, creative and development work.
          </h2>
          <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
            Ahad plans marketing strategy, Meesam crafts ad creatives and video edits, while Zaid engineers fast frontend interfaces and digital builds.
          </p>
        </div>

        <!-- 3-Member Responsive Team Grid -->
        <div class="grid gap-6 sm:gap-8 grid-cols-1 sm:grid-cols-2 md:grid-cols-3 max-w-5xl mx-auto mb-10">
          {visibleMembers.map((m) => (
            <div class="w-full">
              <TeamMemberCard
                member={m}
                variant="homepage"
                showResponsibilities={true}
                showLinkedIn={true}
                class="h-full"
              />
            </div>
          ))}
        </div>

        <!-- About Page Team Link -->
        <div class="text-center pt-2">
          <a
            href={`${site.basePath}/about/#team`}
            class="inline-flex items-center gap-2 rounded-full border border-[#061d33]/20 bg-white px-6 py-3 font-body font-semibold text-sm text-[#061d33] hover:bg-[#061d33] hover:text-white transition-all shadow-xs group/link min-h-[44px]"
          >
            <span>Meet the Team</span>
            <ArrowRight class="size-4 group-hover/link:translate-x-1 transition-transform" />
          </a>
        </div>

      </div>
    </section>
  )
}

---
import { brands, type Brand } from '../../data/brands';
import { site } from '../../site.config';
import SectionEyebrow from '../common/SectionEyebrow.astro';

// Verified active brands (13 approved brands sorted by order)
const activeBrands = brands
  .filter((b) => b.active && b.logoApproved && b.logo)
  .sort((a, b) => a.order - b.order);

const fitClasses: Record<NonNullable<Brand['logoFit']>, string> = {
  compact: 'max-h-[30px] sm:max-h-[34px] max-w-[80%]',
  standard: 'max-h-[36px] sm:max-h-[40px] max-w-[85%]',
  wide: 'max-h-[32px] sm:max-h-[36px] max-w-[90%]',
  large: 'max-h-[40px] sm:max-h-[44px] max-w-[92%]',
};
---

<section id="brands" class="scroll-mt-[96px] sm:scroll-mt-[108px] lg:scroll-mt-[100px] py-14 sm:py-16 lg:py-20 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 overflow-hidden">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-10 sm:mb-12 text-center space-y-3 max-w-2xl mx-auto">
      <SectionEyebrow
        label="CLIENT EXPERIENCE"
        align="center"
        delay={0}
      />
      <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        BRANDS WE HAVE WORKED WITH
      </h2>
      <p data-motion="fade-up" data-motion-delay="200" class="text-base text-slate-700 font-body leading-relaxed font-normal">
        Client experience across e-commerce, agriculture, local services, immigration and technology.
      </p>
    </div>

    <!-- Editorial Client Index Grid -->
    <div data-motion="fade-up" data-motion-delay="250" class="w-full">
      <div class="flex flex-wrap justify-center items-stretch border-t border-l border-[#061d33]/12">
        {
          activeBrands.map((b) => {
            const destUrl = b.website || b.facebook;
            const fitClass = fitClasses[b.logoFit || 'standard'];

            const logoElement = (
              <img
                src={`${site.basePath}${b.logo}`}
                alt={`${b.name} logo`}
                width="160"
                height="48"
                loading="lazy"
                decoding="async"
                class={`w-auto object-contain transition-transform duration-300 group-hover:scale-103 ${fitClass}`}
              />
            );

            const content = (
              <div class="w-full h-full flex flex-col items-center justify-between p-3 sm:p-4 group">
                
                <!-- Logo Zone -->
                <div class="w-full h-12 sm:h-14 flex items-center justify-center shrink-0">
                  {b.darkLogoContainer ? (
                    <div class="w-full max-w-[138px] h-[42px] sm:h-[46px] rounded-lg bg-[#061d33] px-3 py-1.5 flex items-center justify-center border border-white/10 shadow-xs">
                      {logoElement}
                    </div>
                  ) : (
                    <div class="w-full h-full flex items-center justify-center p-1">
                      {logoElement}
                    </div>
                  )}
                </div>

                <!-- Brand Name Underneath -->
                <div class="w-full text-center mt-2.5 flex-1 flex flex-col items-center justify-start">
                  <span class="font-heading font-semibold text-[13px] sm:text-[14px] text-[#061d33] text-center leading-snug line-clamp-2 transition-colors duration-200 group-hover:text-[#ff762b]">
                    {b.name}
                  </span>

                  <!-- Technology Partner Label (ConvortAI Only) -->
                  <div class="min-h-[16px] mt-1 flex items-center justify-center">
                    {b.isTechnologyPartner ? (
                      <span class="text-[10px] font-mono font-medium tracking-wider text-[#ff762b] uppercase block">
                        TECHNOLOGY PARTNER
                      </span>
                    ) : null}
                  </div>
                </div>

              </div>
            );

            return destUrl ? (
              <a
                href={destUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-track={b.website ? 'client-website' : 'client-facebook'}
                aria-label={`Visit ${b.name} official page`}
                class="client-index-item group w-1/2 sm:w-1/3 lg:w-1/5 border-b border-r border-[#061d33]/12 flex flex-col items-center justify-between focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] transition-colors duration-200 hover:bg-white/40"
              >
                {content}
              </a>
            ) : (
              <div class="client-index-item group w-1/2 sm:w-1/3 lg:w-1/5 border-b border-r border-[#061d33]/12 flex flex-col items-center justify-between">
                {content}
              </div>
            );
          })
        }
      </div>
    </div>

  </div>
</section>

<style>
  .client-index-item:focus-visible {
    outline: 2px solid #ff762b;
    outline-color: #ff762b;
    outline-style: solid;
    outline-width: 2px;
    outline-offset: 2px;
  }
</style>
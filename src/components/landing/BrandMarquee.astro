---
import { brands, type Brand } from '../../data/brands';
import { site } from '../../site.config';
import SectionEyebrow from '../common/SectionEyebrow.astro';

// Verified active brands (13 approved brands sorted by order)
const activeBrands = brands
  .filter((b) => b.active && b.logoApproved && b.logo)
  .sort((a, b) => a.order - b.order);

const fitClasses: Record<NonNullable<Brand['logoFit']>, string> = {
  compact: 'max-h-7 sm:max-h-8 max-w-[70%]',
  standard: 'max-h-8 sm:max-h-9 max-w-[80%]',
  wide: 'max-h-9 sm:max-h-10 max-w-[88%]',
  large: 'max-h-10 sm:max-h-11 max-w-[92%]',
};
---

<section id="brands" class="scroll-mt-[96px] sm:scroll-mt-[108px] lg:scroll-mt-[100px] py-16 sm:py-20 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 overflow-hidden">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-10 text-center space-y-3 max-w-2xl mx-auto">
      <SectionEyebrow
        label="CLIENT WORK & PORTFOLIO"
        align="center"
        delay={0}
      />
      <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        Selected Client Experience
      </h2>
      <p data-motion="fade-up" data-motion-delay="200" class="text-sm sm:text-base text-slate-700 font-body leading-relaxed font-normal">
        Proven execution delivered across growth-stage e-commerce, agriculture, regional services, and technology.
      </p>
    </div>

    <!-- Unified Editorial Client Wall Panel (Lighter Warm-White Panel, No Individual Cards) -->
    <div data-motion="fade-up" data-motion-delay="250" class="rounded-3xl border border-[#061d33]/10 bg-white/70 px-4 py-5 sm:px-6 sm:py-6 lg:px-8 lg:py-8 shadow-xs">
      
      <!-- Centred Flex-Wrap Grid (2/row mobile, 3/row tablet, 5/row desktop, final row centred) -->
      <div class="flex flex-wrap justify-center items-stretch gap-x-3 gap-y-4 sm:gap-x-4 sm:gap-y-5 lg:gap-x-5 lg:gap-y-4">
        {
          activeBrands.map((b) => {
            const destUrl = b.website || b.facebook;
            const fitClass = fitClasses[b.logoFit || 'standard'];

            const logoElement = (
              <img
                src={`${site.basePath}${b.logo}`}
                alt={`${b.name} logo`}
                width="160"
                height="48"
                loading="lazy"
                decoding="async"
                class={`w-auto object-contain transition-transform duration-300 group-hover:scale-103 ${fitClass}`}
              />
            );

            const content = (
              <div class="w-full h-full flex flex-col items-center justify-between p-1.5 sm:p-2 bg-transparent transition-all duration-300 group">
                
                <!-- Logo Presentation Container -->
                <div class="w-full flex-1 flex items-center justify-center min-h-[50px] sm:min-h-[60px]">
                  {b.darkLogoContainer ? (
                    <div class="w-full max-w-[148px] h-11 sm:h-12 rounded-xl bg-[#061d33] px-3 py-1.5 flex items-center justify-center border border-[#061d33]/20 shadow-xs">
                      {logoElement}
                    </div>
                  ) : (
                    <div class="w-full h-11 sm:h-12 flex items-center justify-center p-1">
                      {logoElement}
                    </div>
                  )}
                </div>

                <!-- Reserved Technology Partner Caption Region -->
                <div class="mt-1 text-center h-3.5 flex items-center justify-center">
                  {b.isTechnologyPartner ? (
                    <span class="text-[10px] sm:text-[11px] font-mono font-semibold uppercase tracking-[0.08em] text-[#061d33] block">
                      TECHNOLOGY PARTNER
                    </span>
                  ) : (
                    <span class="text-[10px] sm:text-[11px] font-mono block opacity-0 pointer-events-none" aria-hidden="true">
                      PARTNER
                    </span>
                  )}
                </div>

              </div>
            );

            return destUrl ? (
              <a
                href={destUrl}
                target="_blank"
                rel="noopener noreferrer"
                data-track={b.website ? 'client-website' : 'client-facebook'}
                aria-label={`Visit ${b.name} official page`}
                class="client-logo-link w-[calc(50%_-_0.375rem)] sm:w-[calc(33.333333%_-_0.666667rem)] lg:w-[calc(20%_-_1rem)] min-h-[82px] sm:min-h-[96px] flex rounded-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] transition-all duration-300"
              >
                {content}
              </a>
            ) : (
              <div class="w-[calc(50%_-_0.375rem)] sm:w-[calc(33.333333%_-_0.666667rem)] lg:w-[calc(20%_-_1rem)] min-h-[82px] sm:min-h-[96px] flex rounded-xl transition-all duration-300">
                {content}
              </div>
            );
          })
        }
      </div>

    </div>

  </div>
</section>

<style>
  .client-logo-link:focus-visible {
    outline: 2px solid #ff762b;
    outline-color: #ff762b;
    outline-style: solid;
    outline-width: 2px;
    outline-offset: 2px;
  }
</style>
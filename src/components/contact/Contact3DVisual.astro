---
import { Target, FileText, MessageSquare, CheckCircle } from '@lucide/astro';

const steps = [
  {
    icon: Target,
    color: 'text-[#ff762b]',
    bg: 'bg-[#ff762b]/15 border-[#ff762b]/30',
    label: 'Share Your Goal',
    desc: 'Tell us what you want to achieve'
  },
  {
    icon: FileText,
    color: 'text-[#38bdf8]',
    bg: 'bg-[#38bdf8]/15 border-[#38bdf8]/30',
    label: 'Describe Your Project',
    desc: 'Services needed and timeline'
  },
  {
    icon: MessageSquare,
    color: 'text-[#39c98a]',
    bg: 'bg-[#39c98a]/15 border-[#39c98a]/30',
    label: 'WhatsApp or Email',
    desc: 'Direct line to our team'
  },
  {
    icon: CheckCircle,
    color: 'text-[#ddff35]',
    bg: 'bg-[#ddff35]/15 border-[#ddff35]/30',
    label: 'Review & Response',
    desc: 'We confirm and plan next steps'
  }
];
---

<!-- Communication Journey Visual — 4-step path with connecting lines -->
<div class="relative py-4 select-none" aria-hidden="true">

  <!-- Horizontal step line (desktop) / vertical stack (mobile) -->
  <div class="hidden sm:flex items-start justify-between relative">

    <!-- Connecting line behind steps -->
    <div class="absolute top-7 left-[10%] right-[10%] h-[2px] bg-gradient-to-r from-[#ff762b]/40 via-[#39c98a]/40 to-[#ddff35]/40 z-0"></div>

    {steps.map((step, idx) => {
      const IconComp = step.icon;
      return (
        <div class="flex flex-col items-center gap-3 w-[22%] z-10 step-float" style={`animation-delay: ${idx * 120}ms`}>
          <!-- Icon bubble -->
          <div class={`size-14 rounded-2xl border-2 flex items-center justify-center ${step.bg} shadow-lg`}>
            <IconComp class={`size-6 ${step.color}`} />
          </div>
          <!-- Step number dot -->
          <span class="font-mono text-[10px] font-bold text-white bg-white/10 border border-white/20 px-2 py-0.5 rounded-full">
            0{idx + 1}
          </span>
          <!-- Label -->
          <div class="text-center space-y-1">
            <span class="font-heading font-bold text-xs text-white block leading-tight">{step.label}</span>
            <span class="font-body text-[11px] text-slate-400 block leading-snug">{step.desc}</span>
          </div>
        </div>
      );
    })}
  </div>

  <!-- Mobile: vertical stack -->
  <div class="sm:hidden space-y-4">
    {steps.map((step, idx) => {
      const IconComp = step.icon;
      return (
        <div class="flex items-start gap-4">
          <div class={`size-10 rounded-xl border flex items-center justify-center shrink-0 ${step.bg}`}>
            <IconComp class={`size-5 ${step.color}`} />
          </div>
          <div class="space-y-0.5 pt-1">
            <span class="font-heading font-bold text-sm text-white block">{step.label}</span>
            <span class="font-body text-xs text-slate-400">{step.desc}</span>
          </div>
        </div>
      );
    })}
  </div>

</div>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .step-float {
      animation: step-bob 3s ease-in-out infinite alternate;
    }
  }

  @keyframes step-bob {
    0%   { transform: translateY(0); }
    100% { transform: translateY(-6px); }
  }
</style>

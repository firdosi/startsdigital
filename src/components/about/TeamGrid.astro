---
import { teamMembers, type TeamMember } from '../../data/team';
import TeamMemberCard from '../team/TeamMemberCard.astro';
import SectionEyebrow from '../common/SectionEyebrow.astro';

const nonFounderMembers: TeamMember[] = teamMembers
  .filter((m) => m.approvedForPublic && m.aboutVisible && !m.isFounder)
  .sort((a, b) => a.order - b.order);
---

<section id="team" class="py-16 sm:py-20 lg:py-24 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 text-center max-w-2xl mx-auto space-y-3">
      <SectionEyebrow label="CREATIVE & DEVELOPMENT TEAM" align="center" motion={false} />
      <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        Creative and technical support for client projects.
      </h2>
      <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
        Meesam handles video editing and brand visuals, while Zaid leads UI/UX design and web development execution.
      </p>
    </div>

    <!-- Centered Responsive Team Grid for Non-Founders -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8 max-w-3xl mx-auto">
      {nonFounderMembers.map((m) => (
        <div class="w-full">
          <TeamMemberCard
            member={m}
            variant="about"
            showResponsibilities={true}
            showLinkedIn={true}
            showMemberLabel={true}
            class="h-full"
          />
        </div>
      ))}
    </div>

  </div>
</section>

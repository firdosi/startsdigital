---
import { companyProfile } from '../../data/company';
import SectionEyebrow from '../common/SectionEyebrow.astro';
---

<section id="story" class="py-16 sm:py-20 lg:py-24 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px] sm:scroll-mt-[112px] lg:scroll-mt-[104px]">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Left Column: Origin Marker & Title (5 cols desktop) -->
      <div class="lg:col-span-5 space-y-6">
        <SectionEyebrow label="OUR STORY" align="left" delay={0} />
        
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
          Built to coordinate the work businesses often manage separately.
        </h2>

        <!-- 2025 Origin Badge -->
        <div class="inline-flex items-center gap-4 rounded-2xl bg-white p-5 border border-[#061d33]/12 shadow-xs">
          <span class="font-heading font-bold text-3xl text-[#ff762b]">2025</span>
          <div class="border-l border-[#061d33]/15 pl-4">
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500 block">FOUNDING</span>
            <span class="text-sm font-body font-semibold text-[#061d33]">Starts Digital established in Lahore</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Approved 4-Part Story & Supporting Statement (7 cols desktop) -->
      <div class="lg:col-span-7 space-y-6">
        <div class="rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-8 lg:p-10 shadow-xs space-y-5">
          {companyProfile.story.map((paragraph) => (
            <p class="text-base sm:text-lg text-slate-700 font-body leading-relaxed font-normal">
              {paragraph}
            </p>
          ))}

          <div class="pt-5 border-t border-[#061d33]/10">
            <p class="text-base font-body font-semibold text-[#061d33] leading-relaxed">
              Starts Digital combines campaign planning, creative production, websites, search visibility and practical technology support within one clearly defined project scope.
            </p>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

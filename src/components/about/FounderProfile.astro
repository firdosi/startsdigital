---
import { teamMembers } from '../../data/team';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { ExternalLink, CheckCircle2 } from '@lucide/astro';

const founder = teamMembers.find((m) => m.id === 'ahad-firdosi');
---

{
  founder && (
    <section id="founder" class="py-16 sm:py-20 lg:py-24 bg-[#061d33] text-white relative overflow-hidden border-b border-white/10 scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
      <!-- Subtle Glow Accent -->
      <div class="absolute -right-20 -top-20 size-80 rounded-full bg-[#ff762b]/15 blur-3xl pointer-events-none"></div>

      <div class="mx-auto max-w-[1280px] px-6 sm:px-8 relative z-10">
        
        <!-- Section Header -->
        <div class="mb-12 text-center max-w-2xl mx-auto space-y-3">
          <SectionEyebrow label="FOUNDER & PROJECT LEADERSHIP" align="center" motion={false} />
          <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-white leading-tight tracking-[-0.025em]">
            Project direction led by Ahad Firdosi.
          </h2>
        </div>

        <!-- Typography-Led Founder Profile Card -->
        <div class="max-w-4xl mx-auto rounded-3xl border border-white/20 bg-white/5 backdrop-blur-md p-8 sm:p-10 lg:p-12 shadow-xl space-y-6">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-6 border-b border-white/15">
            <div>
              <span class="inline-block px-3 py-1 rounded-full bg-[#ff762b]/20 border border-[#ff762b]/40 text-[#ff762b] font-mono text-xs font-bold uppercase tracking-wider mb-2">
                FOUNDER & CEO
              </span>
              <h3 class="font-heading font-bold text-3xl sm:text-4xl text-white">{founder.name}</h3>
              <p class="font-mono text-sm text-slate-300 mt-1">{founder.role}</p>
            </div>

            {founder.linkedin && (
              <a
                href={founder.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                aria-label="View Ahad Firdosi on LinkedIn"
                class="inline-flex items-center gap-2 rounded-full bg-[#0077b5] px-5 py-2.5 text-xs sm:text-sm font-body font-semibold text-white hover:bg-[#006097] transition-all shadow-xs self-start sm:self-auto"
              >
                <svg class="size-4 fill-white" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
                </svg>
                <span>View Ahad Firdosi on LinkedIn</span>
                <ExternalLink class="size-3.5" />
              </a>
            )}
          </div>

          <!-- Biography & Context -->
          <div class="space-y-4 text-base sm:text-lg text-slate-200 font-body leading-relaxed">
            <p>{founder.shortBio}</p>
            <p class="text-sm sm:text-base text-slate-300">
              Ahad coordinates project requirements, digital marketing work and team responsibilities across Starts Digital engagements.
            </p>
          </div>

          <!-- Key Responsibilities Grid -->
          <div class="pt-4 border-t border-white/15 space-y-3">
            <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 block">
              Core Responsibilities
            </span>
            <div class="flex flex-wrap gap-2.5">
              {founder.responsibilities.map((r) => (
                <div class="inline-flex items-center gap-2 rounded-xl bg-white/10 px-4 py-2 text-xs sm:text-sm font-mono text-white border border-white/15">
                  <CheckCircle2 class="size-4 text-[#ddff35]" />
                  <span>{r}</span>
                </div>
              ))}
            </div>
          </div>

        </div>

      </div>
    </section>
  )
}

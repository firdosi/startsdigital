---
import { companyProfile } from '../../data/company';
import { site } from '../../site.config';
import SectionEyebrow from '../common/SectionEyebrow.astro';
import { ArrowRight, CheckCircle2 } from '@lucide/astro';
---

<section id="capability-connection" class="py-16 sm:py-20 lg:py-24 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px] sm:scroll-mt-[112px] lg:scroll-mt-[104px]">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Eyebrow, Heading & Sentence (6 cols desktop) -->
      <div class="lg:col-span-6 space-y-5">
        <SectionEyebrow label="CONNECTED CAPABILITIES" align="left" delay={0} />
        
        <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
          Different skills, organised around one project requirement.
        </h2>

        <p data-motion="fade-up" data-motion-delay="200" class="text-base sm:text-lg text-slate-700 font-body leading-relaxed font-normal">
          Clients can engage Starts Digital for one focused service or for a coordinated combination of services where the project requires it.
        </p>

        <div data-motion="fade-up" data-motion-delay="300" class="pt-2">
          <a
            href={`${site.basePath}/services/`}
            class="inline-flex items-center gap-2 rounded-full bg-[#061d33] px-7 py-3.5 font-body font-semibold text-base text-white hover:bg-[#ff762b] transition-all shadow-xs group/cta"
          >
            <span>Explore Services</span>
            <ArrowRight class="size-4 group-hover/cta:translate-x-1 transition-transform" />
          </a>
        </div>
      </div>

      <!-- Right Column: 6-Capability Compact Index Strip (6 cols desktop) -->
      <div data-motion="fade-up" data-motion-delay="250" class="lg:col-span-6">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {companyProfile.services.map((service, idx) => (
            <div class="rounded-2xl border border-[#061d33]/12 bg-white p-4 sm:p-5 flex items-center gap-3 shadow-xs hover:border-[#ff762b]/40 transition-all">
              <span class="font-mono text-xs font-bold text-[#ff762b] bg-[#ff762b]/10 px-2 py-0.5 rounded shrink-0">
                0{idx + 1}
              </span>
              <span class="font-heading font-bold text-sm sm:text-base text-[#061d33]">
                {service}
              </span>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>
</section>

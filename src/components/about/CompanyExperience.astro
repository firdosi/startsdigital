---
import { site } from '../../site.config';
import { ArrowRight } from '@lucide/astro';
---

<section id="experience" class="py-12 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 text-center scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    <a
      href={`${site.basePath}/work/`}
      class="inline-flex items-center gap-2 font-heading font-semibold text-base sm:text-lg text-[#061d33] hover:text-[#ff762b] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
    >
      <span>View our client work</span>
      <ArrowRight class="size-4 text-[#ff762b]" />
    </a>
  </div>
</section>

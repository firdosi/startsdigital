---
import SectionEyebrow from '../common/SectionEyebrow.astro';

const principles = [
  {
    number: '01',
    title: 'Clear Scope',
    description: 'Services, deliverables and responsibilities are defined around the project requirements.'
  },
  {
    number: '02',
    title: 'Documented Communication',
    description: 'Important requirements, updates and next steps are kept clear through agreed communication channels.'
  },
  {
    number: '03',
    title: 'Coordinated Execution',
    description: 'Marketing, creative and technical tasks are organised within one working plan where the project requires them.'
  },
  {
    number: '04',
    title: 'Practical Review',
    description: 'Work is reviewed against the agreed business requirement, available information and project deliverables.'
  }
];
---

<section id="principles" class="py-16 sm:py-20 lg:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-[100px] sm:scroll-mt-[112px] lg:scroll-mt-[104px]">
  <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
    
    <!-- Section Header -->
    <div class="mb-12 text-center max-w-2xl mx-auto space-y-3">
      <SectionEyebrow label="HOW WE WORK" align="center" delay={0} />
      <h2 data-motion="fade-up" data-motion-delay="100" class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
        Simple principles for clearer project execution.
      </h2>
    </div>

    <!-- 4 Principles Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {principles.map((p, idx) => (
        <div
          data-motion="fade-up"
          data-motion-delay={idx * 80}
          class="rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:border-[#ff762b]/40 transition-all duration-300"
        >
          <div class="space-y-4">
            <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-3 py-1 rounded-full w-fit block">
              PRINCIPLE {p.number}
            </span>
            <h3 class="font-heading font-bold text-xl text-[#061d33] leading-snug">
              {p.title}
            </h3>
            <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
              {p.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

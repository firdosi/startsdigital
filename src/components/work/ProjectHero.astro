---
import { site } from '../../site.config';
import type { ResolvedProject } from '../../data/projects';
import ProjectBreadcrumbs from './ProjectBreadcrumbs.astro';
import { ArrowLeft, ExternalLink, CheckCircle2, TrendingUp } from '@lucide/astro';

interface Props {
  project: ResolvedProject;
  metrics?: Array<{ value: string; label: string }>;
}

const { project, metrics } = Astro.props;
---

<section id="project-hero" class="bg-[#061d33] text-white pt-12 pb-16 sm:pt-16 sm:pb-20 border-b border-white/10 relative overflow-hidden rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl scroll-mt-24">
  <!-- Subtle background accent -->
  <div class="absolute -right-20 -top-20 size-80 rounded-full bg-[#ff762b]/15 blur-3xl pointer-events-none"></div>

  <div class="relative mx-auto max-w-[1280px] px-6 sm:px-8 z-10 space-y-6">
    <!-- Breadcrumbs -->
    <ProjectBreadcrumbs projectName={project.publicName} projectSlug={project.projectSlug} />

    <!-- Top Metadata Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-white/10">
      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-mono font-bold uppercase tracking-wider text-[#ddff35]">
          {project.sector}
        </span>
        {project.relationshipType && (
          <span class="inline-flex items-center gap-2 rounded-full border border-[#ff762b]/30 bg-[#ff762b]/15 px-4 py-1.5 text-xs font-mono font-semibold text-[#ff762b]">
            {project.relationshipType}
          </span>
        )}
      </div>

      <a
        href={`${site.basePath}/work/`}
        class="inline-flex items-center gap-2 text-sm font-body font-semibold text-slate-300 hover:text-[#ddff35] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xs"
      >
        <ArrowLeft class="size-4" />
        <span>Back to all work</span>
      </a>
    </div>

    <!-- Main Title & Summary (Renders immediately without motion) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start pt-2">
      <div class="lg:col-span-8 space-y-5">
        <h1 class="font-heading font-bold text-[32px] sm:text-[44px] lg:text-[52px] leading-[1.12] tracking-[-0.03em] text-white">
          {project.publicName}
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-slate-200 font-body leading-relaxed font-normal max-w-3xl">
          {project.shortSummary}
        </p>

        <!-- Service Tags -->
        <div class="pt-2 flex flex-wrap gap-2">
          {project.resolvedServices.map((svc) => (
            <a
              href={`${site.basePath}/services/${svc.slug}/`}
              class="inline-flex items-center gap-1.5 rounded-lg bg-white/10 px-3 py-1.5 text-xs font-mono font-medium text-white border border-white/15 hover:border-[#ddff35] hover:text-[#ddff35] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
            >
              <CheckCircle2 class="size-3 text-[#39c98a]" />
              <span>{svc.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Hero Actions & Logo Container -->
      <div class="lg:col-span-4 space-y-4 rounded-2xl border border-white/15 bg-white/5 p-6 backdrop-blur-md">
        <!-- Logo Zone -->
        <div class={`h-14 w-full rounded-xl px-4 py-2 flex items-center justify-center border ${project.darkLogoContainer ? 'bg-[#061d33] border-white/15' : 'bg-white border-slate-200'}`}>
          <img
            src={`${site.basePath}${project.logo}`}
            alt={`${project.publicName} logo`}
            width="160"
            height="44"
            loading="eager"
            fetchpriority="high"
            class="max-h-9 w-auto object-contain"
          />
        </div>

        <!-- Official External Link -->
        {(project.officialWebsite || project.officialSocialUrl) && (
          <a
            href={project.officialWebsite || project.officialSocialUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Visit official page for ${project.publicName}`}
            class="w-full inline-flex items-center justify-center gap-2 rounded-full border border-white/20 bg-white/10 px-5 py-3 text-sm font-body font-semibold text-white hover:bg-white hover:text-[#061d33] transition-all shadow-xs focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
          >
            <span>Visit Official Page</span>
            <ExternalLink class="size-4" />
          </a>
        )}
      </div>
    </div>

    <!-- Verified Outcome Metrics Row (when metrics supplied) -->
    {metrics && metrics.length > 0 && (
      <div class="pt-6 border-t border-white/10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {metrics.map((m) => (
          <div class="rounded-2xl border border-white/15 bg-white/5 p-4 space-y-1">
            <span class="font-heading font-bold text-2xl sm:text-3xl text-[#ddff35] block">
              {m.value}
            </span>
            <span class="text-xs font-mono font-medium text-slate-300 block">
              {m.label}
            </span>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

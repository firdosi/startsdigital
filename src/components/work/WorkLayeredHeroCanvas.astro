---
// Layered Editorial Work Showcase Canvas for Work Hero
---

<div class="relative w-full max-w-4xl mx-auto py-8 px-4" id="layered-work-canvas">
  <!-- Backdrop Glow -->
  <div class="absolute inset-0 bg-radial from-[#ff762b]/15 via-transparent to-transparent blur-2xl pointer-events-none"></div>

  <div class="relative grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
    
    <!-- Layer 1: E-Commerce Mobile Storefront & Website Layout (Left Column) -->
    <div class="space-y-4 group">
      <!-- Website Screenshot Frame -->
      <div class="relative rounded-2xl bg-[#0a233c] border border-white/15 p-4 shadow-xl transform transition-transform duration-500 group-hover:-translate-y-2 group-hover:rotate-1">
        <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-3">
          <div class="flex items-center gap-1.5">
            <div class="size-2.5 rounded-full bg-[#ff762b]"></div>
            <div class="size-2.5 rounded-full bg-[#ddff35]"></div>
            <div class="size-2.5 rounded-full bg-[#39c98a]"></div>
          </div>
          <span class="text-[10px] font-mono text-slate-400">E-Commerce Web Architecture</span>
        </div>
        <div class="relative aspect-video rounded-lg overflow-hidden bg-[#061d33] border border-white/10">
          <img 
            src="/photography/web-designer-responsive.webp" 
            alt="Real responsive website design project example" 
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
            width="800"
            height="1020"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#061d33] via-transparent to-transparent opacity-60"></div>
          <div class="absolute bottom-2 left-2 right-2 flex items-center justify-between text-xs font-semibold text-white">
            <span>E-Commerce Storefront</span>
            <span class="text-[#ddff35] font-mono text-[10px]">Production UX</span>
          </div>
        </div>
      </div>

      <!-- Graphic Design Canvas Frame -->
      <div class="relative rounded-2xl bg-[#0a233c]/90 border border-white/15 p-3 shadow-lg transform transition-transform duration-500 group-hover:translate-x-1">
        <div class="flex items-center gap-3">
          <div class="size-10 rounded-xl bg-[#ff762b]/20 border border-[#ff762b]/40 flex items-center justify-center shrink-0">
            <svg class="size-5 text-[#ff762b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-bold text-white block">Brand Visual Identity</span>
            <p class="text-[11px] text-slate-300">Custom Vector Assets & Typography</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Layer 2: Featured Video Editing Timeline & AI Character Creative Frame (Center Hero Column) -->
    <div class="relative z-10 space-y-4 group">
      <!-- Main Video Editing Workstation Frame -->
      <div class="relative rounded-2xl bg-[#0a233c] border-2 border-[#ddff35]/40 p-4 shadow-2xl transform transition-transform duration-500 group-hover:scale-[1.02]">
        <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-3">
          <span class="text-xs font-bold text-[#ddff35] tracking-wider font-mono">FEATURED CREATIVE OUTPUT</span>
          <span class="text-[10px] font-mono bg-[#ddff35]/15 text-[#ddff35] px-2 py-0.5 rounded-full border border-[#ddff35]/30">4K Video Edit</span>
        </div>
        <div class="relative aspect-[16/10] rounded-xl overflow-hidden bg-[#061d33] border border-white/15">
          <img 
            src="/photography/video-editing-workstation.webp" 
            alt="Hands editing video timeline on a professional workstation" 
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
            width="800"
            height="534"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#061d33]/90 via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
            <span class="text-xs font-bold text-white">Commercial Video Campaign</span>
            <span class="text-[11px] font-mono text-[#39c98a]">Multi-Track Production</span>
          </div>
        </div>
      </div>

      <!-- AI Character Campaign Frame -->
      <div class="relative rounded-2xl bg-gradient-to-r from-[#0a233c] to-[#0d2e4f] border border-white/15 p-4 shadow-xl">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div class="size-9 rounded-full bg-[#ff762b]/20 border border-[#ff762b]/40 flex items-center justify-center">
              <svg class="size-4 text-[#ff762b]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div>
              <span class="text-xs font-bold text-white block">AI Character Consistency</span>
              <p class="text-[11px] text-slate-300">27+ Brand Characters Generated</p>
            </div>
          </div>
          <span class="text-[10px] font-mono text-[#ddff35] bg-[#ddff35]/10 px-2.5 py-1 rounded-md border border-[#ddff35]/20">Active System</span>
        </div>
      </div>
    </div>

    <!-- Layer 3: Social Advertisement & Local Search Setup (Right Column) -->
    <div class="space-y-4 group">
      <!-- Social Advertisement Creative Frame -->
      <div class="relative rounded-2xl bg-[#0a233c] border border-white/15 p-4 shadow-xl transform transition-transform duration-500 group-hover:translate-y-2 group-hover:-rotate-1">
        <div class="flex items-center justify-between border-b border-white/10 pb-3 mb-3">
          <span class="text-xs font-bold text-white">Paid Social Creative</span>
          <span class="text-[10px] font-mono text-[#ff762b]">Meta Ad Suite</span>
        </div>
        <div class="relative aspect-video rounded-lg overflow-hidden bg-[#061d33] border border-white/10">
          <img 
            src="/photography/advertising-creative-production.webp" 
            alt="Advertising creative production and multi-channel campaign asset" 
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
            width="800"
            height="570"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#061d33] via-transparent to-transparent opacity-60"></div>
          <div class="absolute bottom-2 left-2 right-2 flex items-center justify-between text-xs font-semibold text-white">
            <span>High-CTR Ad Unit</span>
            <span class="text-[#ff762b] font-mono text-[10px]">Campaign Optimized</span>
          </div>
        </div>
      </div>

      <!-- Local Search & Map Setup Frame -->
      <div class="relative rounded-2xl bg-[#0a233c]/90 border border-white/15 p-3 shadow-lg transform transition-transform duration-500 group-hover:-translate-x-1">
        <div class="flex items-center gap-3">
          <div class="size-10 rounded-xl bg-[#39c98a]/20 border border-[#39c98a]/40 flex items-center justify-center shrink-0">
            <svg class="size-5 text-[#39c98a]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <span class="text-xs font-bold text-white block">Local Search & Maps Foundation</span>
            <p class="text-[11px] text-slate-300">Google Business & Local Optimisation</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>

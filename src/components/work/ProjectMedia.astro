---
import { site } from '../../site.config';
import { Image as ImageIcon } from '@lucide/astro';

interface PictureSources {
  webp?: string;
  avif?: string;
  smWebp?: string;
}

interface Props {
  heroImage?: string;
  heroPicture?: PictureSources;
  heroAlt?: string;
  heroCaption?: string;
  gallery?: Array<{ src: string; alt: string; caption?: string }>;
}

const { heroImage, heroPicture, heroAlt, heroCaption, gallery } = Astro.props;
const hasHero = Boolean(heroImage || heroPicture);
const hasGallery = Boolean(gallery && gallery.length > 0);
---

{hasHero && (
  <section id="project-hero-media" class="py-8 bg-[#faf9f6]">
    <div class="mx-auto max-w-[1000px] px-6 sm:px-8">
      <div class="rounded-3xl border border-[#061d33]/12 bg-white p-4 sm:p-6 shadow-md overflow-hidden group">
        <div class="relative overflow-hidden rounded-2xl bg-[#061d33]/5 border border-slate-200">
          {heroPicture ? (
            <picture>
              {heroPicture.avif && <source srcset={`${site.basePath}${heroPicture.avif}`} type="image/avif" />}
              {heroPicture.webp && <source srcset={`${site.basePath}${heroPicture.webp}`} type="image/webp" />}
              <img
                src={`${site.basePath}${heroPicture.webp || heroImage}`}
                alt={heroAlt || 'Project visual'}
                width="1000"
                height="562"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="w-full max-h-[500px] object-contain bg-slate-900/5 group-hover:scale-102 transition-transform duration-500"
              />
            </picture>
          ) : (
            <img
              src={`${site.basePath}${heroImage}`}
              alt={heroAlt || 'Project visual'}
              width="1000"
              height="562"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              class="w-full max-h-[500px] object-contain bg-slate-900/5 group-hover:scale-102 transition-transform duration-500"
            />
          )}
        </div>
        {heroCaption && (
          <div class="mt-3 flex items-center justify-between text-xs font-mono font-medium text-slate-600 px-2">
            <span class="inline-flex items-center gap-1.5 uppercase text-[#ff762b]">
              <ImageIcon class="size-4" />
              <span>Verified Visual</span>
            </span>
            <span>{heroCaption}</span>
          </div>
        )}
      </div>
    </div>
  </section>
)}

{hasGallery && (
  <section id="project-gallery" class="py-12 bg-white border-t border-b border-[#061d33]/10">
    <div class="mx-auto max-w-[1000px] px-6 sm:px-8 space-y-6">
      <div class="flex items-center justify-between">
        <h3 class="font-heading font-bold text-2xl text-[#061d33]">
          Genuine Project Gallery
        </h3>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {gallery!.map((img) => (
          <div class="rounded-2xl border border-[#061d33]/12 bg-[#faf9f6] p-3 shadow-sm overflow-hidden group">
            <div class="relative overflow-hidden rounded-xl bg-white border border-slate-200">
              <img
                src={`${site.basePath}${img.src}`}
                alt={img.alt}
                width="600"
                height="337"
                loading="lazy"
                decoding="async"
                class="w-full h-56 object-cover group-hover:scale-105 transition-transform duration-300"
              />
            </div>
            {img.caption && (
              <p class="mt-2.5 text-xs font-mono font-medium text-slate-600 px-1">
                {img.caption}
              </p>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

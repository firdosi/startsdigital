---
import { Play } from '@lucide/astro';

interface Props {
  youtubeId: string;
  title: string;
  projectName?: string;
  index?: number;
}

const { youtubeId, title, projectName = 'Project Video', index = 1 } = Astro.props;
const posterUrl = `https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`;
const embedUrl = `https://www.youtube-nocookie.com/embed/${youtubeId}?autoplay=1&playsinline=1&rel=0`;
const uniqueId = `yt-short-${youtubeId}`;
const ariaLabel = `Play ${projectName} video ${index}: ${title}`;
---

<div
  class="youtube-short-card group relative rounded-2xl overflow-hidden bg-[#061d33] border border-white/15 shadow-md hover:shadow-xl hover:border-[#ff762b] transition-all duration-300 flex flex-col aspect-[9/16] w-full select-none"
  data-youtube-id={youtubeId}
  data-embed-url={embedUrl}
  data-title={title}
>
  <!-- Poster Image & Play Trigger Container -->
  <div class="video-container relative w-full h-full flex items-center justify-center overflow-hidden bg-black/40">
    <img
      src={posterUrl}
      alt={`${title} thumbnail`}
      loading="lazy"
      decoding="async"
      class="poster-img absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    
    <!-- Gradient Overlay for Contrast -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#061d33]/90 via-black/20 to-black/30 pointer-events-none"></div>

    <!-- Play Button (Accessible Click Target >= 44px) -->
    <button
      type="button"
      id={uniqueId}
      aria-label={ariaLabel}
      class="play-btn relative z-10 size-14 sm:size-16 rounded-full bg-[#ff762b] text-white flex items-center justify-center shadow-lg group-hover:bg-[#ddff35] group-hover:text-[#061d33] group-hover:scale-110 transition-all duration-300 focus:outline-none focus-visible:ring-4 focus-visible:ring-[#ff762b] focus-visible:ring-offset-2 min-h-[44px] min-w-[44px]"
    >
      <Play class="size-6 sm:size-7 fill-current ml-0.5" />
    </button>

    <!-- Bottom Caption Bar -->
    <div class="absolute bottom-0 inset-x-0 p-3 sm:p-4 z-10 pointer-events-none">
      <span class="inline-block px-2.5 py-0.5 rounded-full bg-[#ddff35]/20 text-[#ddff35] text-[10px] font-mono font-bold uppercase tracking-wider mb-1 backdrop-blur-xs">
        Short
      </span>
      <h3 class="text-white font-heading font-bold text-xs sm:text-sm leading-snug line-clamp-2 drop-shadow-xs">
        {title}
      </h3>
    </div>
  </div>
</div>

<script>
  function setupYouTubeCards() {
    const cards = document.querySelectorAll<HTMLElement>('.youtube-short-card');

    cards.forEach((card) => {
      if (card.dataset.initialized) return;
      card.dataset.initialized = 'true';

      const btn = card.querySelector<HTMLButtonElement>('.play-btn');
      const container = card.querySelector<HTMLElement>('.video-container');

      const loadIframe = () => {
        const embedUrl = card.dataset.embedUrl;
        const title = card.dataset.title || 'YouTube Short';

        if (!embedUrl || !container) return;

        const iframe = document.createElement('iframe');
        iframe.src = embedUrl;
        iframe.title = title;
        iframe.className = 'w-full h-full absolute inset-0 border-0 rounded-2xl';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
        iframe.allowFullscreen = true;
        iframe.loading = 'lazy';

        container.innerHTML = '';
        container.appendChild(iframe);
      };

      if (btn) {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          loadIframe();
        });
      }
    });
  }

  // Run on DOM load and Astro page swaps
  setupYouTubeCards();
  document.addEventListener('astro:page-load', setupYouTubeCards);
</script>

---
import { brands } from '../../data/brands';

// Filter all 12 active brand logos from source of truth
const logoBrands = brands.filter(b => b.active && b.logo).map(b => ({
  name: b.name,
  logo: b.logo!,
  darkContainer: !!b.darkLogoContainer
}));
---

<section class="py-16 sm:py-20 bg-[#061d33] text-white overflow-hidden relative border-t border-b border-white/10">
  <!-- Subtle ambient background glow -->
  <div class="absolute inset-0 bg-radial-gradient from-[#ff762b]/10 via-transparent to-transparent pointer-events-none"></div>

  <div class="max-w-[1280px] mx-auto px-6 sm:px-8 relative z-10">
    <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
      <span class="inline-block font-mono text-xs uppercase tracking-widest text-[#ddff35]">
        Trusted Client Partnerships
      </span>
      <h2 class="font-heading text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white">
        Brands We Have Delivered Work For
      </h2>
      <p class="font-body text-sm sm:text-base text-slate-300">
        Selected businesses across e-commerce, seasonal marketing, local services, immigration and technology.
      </p>
    </div>

    <!-- Premium Logo Grid Wall (Unlinked, No Pointer Cursors, No Links) -->
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-6">
      {logoBrands.map((b, idx) => (
        <div 
          class="group relative rounded-2xl border border-white/15 bg-white/5 p-6 flex items-center justify-center min-h-[100px] transition-all duration-300 hover:border-[#ff762b]/50 hover:bg-white/10 select-none cursor-default"
          style={`animation-delay: ${idx * 75}ms`}
        >
          <!-- Soft Spotlight Glow on Hover -->
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-tr from-[#ff762b]/0 via-[#ff762b]/5 to-[#ddff35]/0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

          <!-- Logo Image with Grayscale-to-Color Transition -->
          <img
            src={b.logo}
            alt={`${b.name} logo`}
            loading="lazy"
            decoding="async"
            width="140"
            height="50"
            class="max-h-12 w-auto object-contain filter grayscale opacity-70 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-300 transform group-hover:scale-105"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .group {
      animation: none !important;
      transition: none !important;
    }
    img {
      filter: none !important;
      opacity: 1 !important;
      transition: none !important;
      transform: none !important;
    }
  }
</style>

---
import { TrendingUp, ShoppingBag, Users, Zap, DollarSign, Bot, Sparkles, Layers } from '@lucide/astro';

const resultsList = [
  {
    title: 'PKR 5.9M+ Direct Sales Revenue',
    category: 'E-Commerce Marketing',
    description: 'Generated across product distribution, paid social campaigns, and commission-based digital storefront operations.',
    icon: DollarSign,
    color: 'border-[#ff762b] text-[#ff762b] bg-[#ff762b]/10'
  },
  {
    title: '5,000+ Product Units Sold',
    category: 'E-Commerce Launch Support',
    description: 'Delivered through multi-channel ad creatives, promotional campaign execution, and automated sales routing.',
    icon: ShoppingBag,
    color: 'border-[#ddff35] text-[#ddff35] bg-[#ddff35]/10'
  },
  {
    title: '140+ Clients Converted',
    category: 'Seasonal & Lead Campaigns',
    description: 'Secured during high-demand promotional windows through targeted video ad scripts and direct lead handling.',
    icon: Users,
    color: 'border-[#39c98a] text-[#39c98a] bg-[#39c98a]/10'
  },
  {
    title: 'AED 1.4M+ Campaign Revenue',
    category: 'Lead Generation Campaigns',
    description: 'Driven through AI-supported video workflows, direct response ad testing, and paid social performance strategy.',
    icon: TrendingUp,
    color: 'border-[#38bdf8] text-[#38bdf8] bg-[#38bdf8]/10'
  },
  {
    title: 'AED 0.10 Lead Cost Benchmark',
    category: 'Paid Advertising Efficiency',
    description: 'Recorded on selected regional TikTok and Meta advertising campaigns targeting high-intent audience segments.',
    icon: Zap,
    color: 'border-[#ff762b] text-[#ff762b] bg-[#ff762b]/10'
  },
  {
    title: 'PKR 10 Lead Cost Benchmark',
    category: 'Regional Search & Social Ads',
    description: 'Achieved on selected Pakistan-focused promotional campaigns with highly optimized direct-response visual creatives.',
    icon: Zap,
    color: 'border-[#39c98a] text-[#39c98a] bg-[#39c98a]/10'
  },
  {
    title: '27+ Original AI Character Identities',
    category: 'AI Creative Innovation',
    description: 'Created on private high-performance infrastructure establishing consistent visual marketing avatars for scale ad production.',
    icon: Bot,
    color: 'border-[#ddff35] text-[#ddff35] bg-[#ddff35]/10'
  },
  {
    title: 'Thousands of Generated AI Assets',
    category: 'Scale Content Production',
    description: 'Produced for multi-angle creative testing across video ads, social graphics, and multi-channel campaign variations.',
    icon: Layers,
    color: 'border-[#38bdf8] text-[#38bdf8] bg-[#38bdf8]/10'
  }
];
---

<section id="work-results" class="py-16 sm:py-24 bg-[#061d33] text-white relative overflow-hidden">
  <div class="max-w-[1280px] mx-auto px-6 sm:px-8 relative z-10">
    <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
      <span class="inline-flex items-center gap-2 rounded-full border border-[#ff762b]/30 bg-[#ff762b]/10 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-[0.08em] text-[#ff762b]">
        <Sparkles class="size-3.5 text-[#ff762b]" />
        <span>TRACK RECORD OF EXECUTION</span>
      </span>
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight">
        Results Across Campaigns, Commerce and Digital Products
      </h2>
      <p class="font-body text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed">
        Selected outcomes from our client operations across advertising, e-commerce, websites, creative production, local search and AI workflows.
      </p>
    </div>

    <!-- 8 Result Cards Grid (Each figure appears ONCE in main page flow) -->
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {resultsList.map(item => {
        const IconComponent = item.icon;
        return (
          <div class="rounded-3xl border border-white/15 bg-white/5 p-6 flex flex-col justify-between space-y-5 hover:border-white/30 hover:bg-white/10 transition-all duration-300">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] uppercase tracking-wider text-slate-400">
                  {item.category}
                </span>
                <div class={`size-9 rounded-2xl border flex items-center justify-center ${item.color}`}>
                  <IconComponent class="size-4.5" />
                </div>
              </div>
              <h3 class="font-heading font-bold text-xl text-white tracking-tight leading-snug">
                {item.title}
              </h3>
              <p class="font-body text-xs sm:text-sm text-slate-300 leading-relaxed font-normal">
                {item.description}
              </p>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Honest General Note -->
    <div class="mt-12 text-center border-t border-white/10 pt-8">
      <p class="font-body text-xs text-slate-400 max-w-2xl mx-auto leading-relaxed">
        Results vary according to the business, offer, market, budget and campaign conditions.
      </p>
    </div>
  </div>
</section>

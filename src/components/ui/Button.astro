---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'tertiary' | 'lime';
  surface?: 'dark' | 'light';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  [key: string]: any;
}

const {
  href,
  variant = 'primary',
  surface = 'dark',
  class: className = '',
  type = 'button',
  ...rest
} = Astro.props;

const baseStyles =
  'inline-flex items-center justify-center min-h-[44px] font-heading text-sm sm:text-base font-semibold transition-all duration-200 cursor-pointer disabled:pointer-events-none disabled:opacity-50 select-none focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] rounded-xl';

const getVariantStyle = () => {
  if (variant === 'lime') {
    return 'bg-[#ddff35] text-[#061d33] border border-[#ddff35] px-6 py-3 hover:bg-[#c9ea2b] active:scale-[0.98] shadow-sm';
  }
  if (variant === 'primary') {
    return 'bg-[#ff762b] text-white border border-[#ff762b] px-6 py-3 hover:bg-[#e05e1b] hover:border-[#e05e1b] active:scale-[0.98] shadow-sm';
  }
  if (variant === 'secondary') {
    if (surface === 'light') {
      return 'bg-white text-[#061d33] border border-[#061d33]/20 px-6 py-3 hover:bg-[#061d33] hover:text-white hover:border-[#061d33] active:scale-[0.98]';
    }
    return 'bg-white/10 text-white border border-white/20 px-6 py-3 hover:bg-white/20 hover:border-white/40 active:scale-[0.98]';
  }
  if (variant === 'tertiary') {
    const textColor = surface === 'light' ? 'text-[#061d33] hover:text-[#ff762b]' : 'text-[#ddff35] hover:text-white';
    return `bg-transparent p-0 min-h-0 ${textColor} gap-1.5 hover:translate-x-1 duration-200`;
  }
  return 'bg-[#ff762b] text-white px-6 py-3';
};

const classes = `${baseStyles} ${getVariantStyle()} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}

---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyStory from '../components/about/CompanyStory.astro';
import CompanyFacts from '../components/about/CompanyFacts.astro';
import FounderProfile from '../components/about/FounderProfile.astro';
import TeamGrid from '../components/about/TeamGrid.astro';
import TeamWorkflow from '../components/about/TeamWorkflow.astro';
import CompanyExperience from '../components/about/CompanyExperience.astro';
import WorkingPrinciples from '../components/about/WorkingPrinciples.astro';
import CapabilityConnection from '../components/about/CapabilityConnection.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import MotionController from '../components/common/MotionController.astro';
import AnimatedGrid from '../components/motion/AnimatedGrid.astro';
import FloatingOrb from '../components/motion/FloatingOrb.astro';
import SectionSpark from '../components/motion/SectionSpark.astro';
import { Sparkles, MapPin, Calendar, Globe } from '@lucide/astro';
---

<BaseLayout>
  {/* 1. About Hero (Deep Navy Background & Immediately Visible Narrative) */}
  <section id="about-hero" class="relative overflow-hidden bg-[#061d33] text-white pt-20 sm:pt-24 lg:pt-28 pb-16 sm:pb-20 lg:pb-24 rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl scroll-mt-24">
    <AnimatedGrid opacity={0.10} />
    <FloatingOrb color="orange" size="lg" class="-top-24 -left-24 opacity-60 pointer-events-none" duration="16s" />
    <SectionSpark color="orange" size="md" class="top-10 right-[8%] pointer-events-none" delay="0s" />

    <div class="relative mx-auto max-w-[1280px] px-6 sm:px-8 z-10">
      <div class="max-w-3xl space-y-6 text-left">
        
        <div class="inline-flex items-center">
          <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-[0.06em] text-[#ddff35] backdrop-blur-md">
            <Sparkles class="size-3.5 text-[#ddff35]" />
            <span>ABOUT STARTS DIGITAL</span>
          </span>
        </div>

        <h1 class="font-heading font-bold text-[32px] sm:text-[44px] lg:text-[54px] leading-[1.12] tracking-[-0.03em] text-white">
          A Lahore-based digital agency connecting strategy, creative and technical execution.
        </h1>

        <p class="text-base sm:text-lg leading-[1.65] text-slate-200 font-body font-normal">
          Founded in 2025, Starts Digital supports local and international clients through paid advertising, websites, SEO, creative content, social media marketing and practical AI workflows.
        </p>

        <!-- Context Badges Strip -->
        <div class="pt-4 border-t border-white/15 flex flex-wrap items-center gap-4 text-xs font-mono text-slate-300">
          <div class="flex items-center gap-1.5">
            <MapPin class="size-3.5 text-[#ff762b]" />
            <span>Lahore, Pakistan</span>
          </div>
          <span class="text-white/30">•</span>
          <div class="flex items-center gap-1.5">
            <Calendar class="size-3.5 text-[#ddff35]" />
            <span>Established 2025</span>
          </div>
          <span class="text-white/30">•</span>
          <div class="flex items-center gap-1.5">
            <Globe class="size-3.5 text-[#39c98a]" />
            <span>Local & International Clients</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* 2. Company Story */}
  <CompanyStory />

  {/* 3. Company at a Glance */}
  <CompanyFacts />

  {/* 4. Founder & Leadership (Ahad Firdosi) */}
  <FounderProfile />

  {/* 5. Creative & Development Team (Meesam) */}
  <TeamGrid />

  {/* 6. Team Workflow */}
  <TeamWorkflow />

  {/* 7. Company Experience */}
  <CompanyExperience />

  {/* 8. Working Principles */}
  <WorkingPrinciples />

  {/* 9. Capability Connection */}
  <CapabilityConnection />

  {/* 10. Final CTA */}
  <FinalCta />

  {/* Motion Controller */}
  <MotionController />
</BaseLayout>

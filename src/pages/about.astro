---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyStory from '../components/about/CompanyStory.astro';
import CompanyFacts from '../components/about/CompanyFacts.astro';
import FounderProfile from '../components/about/FounderProfile.astro';
import TeamGrid from '../components/about/TeamGrid.astro';
import TeamWorkflow from '../components/about/TeamWorkflow.astro';
import WorkingPrinciples from '../components/about/WorkingPrinciples.astro';
import CapabilityConnection from '../components/about/CapabilityConnection.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import MotionController from '../components/common/MotionController.astro';
import AnimatedGrid from '../components/motion/AnimatedGrid.astro';
import FloatingOrb from '../components/motion/FloatingOrb.astro';
import SectionSpark from '../components/motion/SectionSpark.astro';
import { site } from '../site.config';
import { Sparkles, MapPin, Calendar, Globe, ArrowRight } from '@lucide/astro';
---

<BaseLayout>
  {/* 1. About Hero */}
  <section id="about-hero" class="relative overflow-hidden bg-[#061d33] text-white pt-8 sm:pt-20 lg:pt-28 pb-12 sm:pb-20 lg:pb-24 rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl scroll-mt-24">
    <AnimatedGrid opacity={0.10} />
    <FloatingOrb color="orange" size="lg" class="-top-24 -left-24 opacity-60 pointer-events-none" duration="16s" />
    <SectionSpark color="orange" size="md" class="top-10 right-[8%] pointer-events-none" delay="0s" />

    <div class="relative mx-auto max-w-[1280px] px-6 sm:px-8 z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="inline-flex items-center">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-[0.06em] text-[#ddff35] backdrop-blur-md">
              <Sparkles class="size-3.5 text-[#ddff35]" />
              <span>ABOUT STARTS DIGITAL</span>
            </span>
          </div>

          <h1 class="font-heading font-bold text-[32px] sm:text-[44px] lg:text-[54px] leading-[1.12] tracking-[-0.03em] text-white">
            A Lahore-based digital agency connecting strategy, creative and technical execution.
          </h1>

          <p class="text-base sm:text-lg leading-[1.65] text-slate-200 font-body font-normal">
            Founded in 2023, Starts Digital supports local and international clients through paid advertising, websites, SEO, creative content, social media marketing and practical AI workflows.
          </p>

          <!-- Context Badges Strip -->
          <div class="pt-4 border-t border-white/15 flex flex-wrap items-center gap-4 text-xs font-mono text-slate-300">
            <div class="flex items-center gap-1.5">
              <MapPin class="size-3.5 text-[#ff762b]" />
              <span>Lahore, Pakistan</span>
            </div>
            <span class="text-white/30">•</span>
            <div class="flex items-center gap-1.5">
              <Calendar class="size-3.5 text-[#ddff35]" />
              <span>Established 2023</span>
            </div>
            <span class="text-white/30">•</span>
            <div class="flex items-center gap-1.5">
              <Globe class="size-3.5 text-[#39c98a]" />
              <span>Local & International Clients</span>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 space-y-2">
          <div class="rounded-3xl overflow-hidden border border-white/15 shadow-2xl bg-white/5 p-2 backdrop-blur-md">
            <picture>
              <source srcset={`${site.basePath}/photography/team-collaboration-workspace.avif`} type="image/avif" />
              <img
                src={`${site.basePath}/photography/team-collaboration-workspace.webp`}
                alt="Illustrative team collaboration photography"
                width="800"
                height="533"
                loading="eager"
                decoding="async"
                class="w-full h-auto object-cover rounded-2xl aspect-[4/3]"
              />
            </picture>
          </div>
          <p class="text-[11px] font-mono text-slate-400 text-center">
            Illustrative team collaboration photography
          </p>
        </div>

      </div>
    </div>
  </section>

  {/* 2. Company Story */}
  <CompanyStory />

  {/* 3. Company Facts */}
  <CompanyFacts />

  {/* 4. How We Work – values list + second workspace visual */}
  <section class="py-16 sm:py-20 bg-white text-[#061d33] border-b border-[#061d33]/10">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

        <!-- Left: Second workspace photograph -->
        <div class="lg:col-span-5 order-2 lg:order-1">
          <div class="rounded-3xl overflow-hidden border border-[#061d33]/10 shadow-xl">
            <picture>
              <source srcset={`${site.basePath}/photography/creative-campaign-planning.avif`} type="image/avif" />
              <img
                src={`${site.basePath}/photography/creative-campaign-planning.webp`}
                alt="Illustrative creative and campaign planning workspace"
                width="800"
                height="533"
                loading="lazy"
                decoding="async"
                class="w-full h-auto object-cover aspect-[4/3]"
              />
            </picture>
          </div>
          <p class="text-[11px] font-mono text-slate-400 mt-2 text-center">
            Illustrative workspace photography
          </p>
        </div>

        <!-- Right: How We Work values -->
        <div class="lg:col-span-7 order-1 lg:order-2 space-y-8">
          <div class="space-y-3">
            <span class="inline-block font-mono text-xs uppercase tracking-widest text-[#ff762b]">How We Work</span>
            <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
              Principles that guide every project
            </h2>
          </div>

          <div class="space-y-6">
            <!-- Principle 1 -->
            <div class="flex gap-5 items-start">
              <div class="size-10 rounded-2xl bg-[#ff762b]/10 border border-[#ff762b]/25 flex items-center justify-center shrink-0">
                <span class="font-mono font-bold text-sm text-[#ff762b]">01</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-heading font-bold text-lg text-[#061d33]">Transparency over promises</h3>
                <p class="font-body text-base text-slate-700 leading-relaxed">We communicate what is being built, why, and how it performs. No hidden processes or vague deliverables.</p>
              </div>
            </div>

            <!-- Principle 2 -->
            <div class="flex gap-5 items-start">
              <div class="size-10 rounded-2xl bg-[#39c98a]/10 border border-[#39c98a]/25 flex items-center justify-center shrink-0">
                <span class="font-mono font-bold text-sm text-[#39c98a]">02</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-heading font-bold text-lg text-[#061d33]">Real outcomes over activity</h3>
                <p class="font-body text-base text-slate-700 leading-relaxed">We focus on leads, sales, visibility and conversions — not just posting frequency or ad impressions.</p>
              </div>
            </div>

            <!-- Principle 3 -->
            <div class="flex gap-5 items-start">
              <div class="size-10 rounded-2xl bg-[#38bdf8]/10 border border-[#38bdf8]/25 flex items-center justify-center shrink-0">
                <span class="font-mono font-bold text-sm text-[#38bdf8]">03</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-heading font-bold text-lg text-[#061d33]">Direct communication</h3>
                <p class="font-body text-base text-slate-700 leading-relaxed">Every project has clear points of contact via WhatsApp and email. No account managers blocking access to the team doing the actual work.</p>
              </div>
            </div>

            <!-- Principle 4 -->
            <div class="flex gap-5 items-start">
              <div class="size-10 rounded-2xl bg-purple-500/10 border border-purple-500/25 flex items-center justify-center shrink-0">
                <span class="font-mono font-bold text-sm text-purple-400">04</span>
              </div>
              <div class="space-y-1">
                <h3 class="font-heading font-bold text-lg text-[#061d33]">Practical digital, not theoretical</h3>
                <p class="font-body text-base text-slate-700 leading-relaxed">We work in the markets and tools our clients use daily: Meta Ads, Google, WooCommerce, WhatsApp, local SEO and AI-supported creative workflows.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* 5. Founder Profile (Ahad Firdosi) */}
  <FounderProfile />

  {/* 5. Creative & Development Team (Meesam & Zaid) */}
  <TeamGrid />

  {/* 6. Team Responsibilities */}
  <TeamWorkflow />

  {/* 7. Working Method */}
  <WorkingPrinciples />

  {/* 8. Principles & Service Connection */}
  <CapabilityConnection />

  {/* Client Work Simple Text Link Section */}
  <section class="py-12 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 text-center">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
      <a
        href={`${site.basePath}/work/`}
        class="inline-flex items-center gap-2 font-heading font-semibold text-base sm:text-lg text-[#061d33] hover:text-[#ff762b] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b] min-h-[44px]"
      >
        <span>View our client work</span>
        <ArrowRight class="size-4 text-[#ff762b]" />
      </a>
    </div>
  </section>

  {/* 9. Final Call to Action */}
  <FinalCta title="Build Your Digital Capability with Starts Digital" />

  {/* Motion Controller */}
  <MotionController />
</BaseLayout>

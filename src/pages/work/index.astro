---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionEyebrow from '../../components/common/SectionEyebrow.astro';
import MotionController from '../../components/common/MotionController.astro';
import AnimatedGrid from '../../components/motion/AnimatedGrid.astro';
import FloatingOrb from '../../components/motion/FloatingOrb.astro';
import SectionSpark from '../../components/motion/SectionSpark.astro';
import { site } from '../../site.config';
import {
  getDetailedProjectStories,
  getClientExperienceProfiles,
  getDetailTypeActionLabel,
  type ResolvedProject
} from '../../data/projects';
import { getPublishedServices } from '../../data/services';
import {
  ArrowRight,
  ExternalLink,
  CheckCircle2,
  MessageSquare,
  Filter,
  RotateCcw,
  Building2,
  MapPin
} from '@lucide/astro';

const detailedProjects: ResolvedProject[] = getDetailedProjectStories();
const experienceProjects: ResolvedProject[] = getClientExperienceProfiles();
const publishedServices = getPublishedServices();

const encodedWhatsappMsg = encodeURIComponent('Hello Starts Digital, I would like to discuss a project after reviewing your work.');
const whatsappUrl = `${site.contact.whatsapp}?text=${encodedWhatsappMsg}`;

// Project Industry Filter Mapping
function getProjectIndustryCategory(project: ResolvedProject): string {
  const brandCat = project.brand.category;
  if (brandCat === 'ecommerce') return 'ecommerce';
  if (brandCat === 'immigration' || brandCat === 'business-services') return 'immigration';
  if (brandCat === 'construction') return 'construction';
  if (brandCat === 'technology') return 'technology';
  if (brandCat === 'healthcare') return 'healthcare';
  if (project.sector.toLowerCase().includes('agriculture') || project.sector.toLowerCase().includes('livestock')) return 'agriculture';
  return 'ecommerce';
}

function getProjectLocation(project: ResolvedProject): string {
  if (project.id === 'black-gold-fertilizer' || project.id === 'viral-naturals' || project.id === 'shopinq-online') return 'Lahore, Pakistan';
  if (project.id === 'wajib-livestock') return 'Pakistan (Nationwide)';
  if (project.id === 'rk-reno-solutions') return 'Kuala Lumpur, Malaysia';
  if (project.id === 'convort-ai') return 'Global Technology';
  if (project.id === 'rapidline-immigration-services' || project.id === 'rapidzone' || project.id === 'clearzone-immigration') return 'Dubai, UAE';
  if (project.id === 'riyadh-finish-pro') return 'Riyadh, Saudi Arabia';
  if (project.id === 'super-safety-covers') return 'Mian Channu, Pakistan';
  if (project.id === 'unique-lahore-lab-sahiwal') return 'Sahiwal, Pakistan';
  return 'Local & International';
}
---

<BaseLayout>
  <!-- 1. WORK HERO -->
  <section id="work-hero" class="relative overflow-hidden bg-[#061d33] text-white pt-16 sm:pt-20 lg:pt-24 pb-16 sm:pb-20 lg:pb-24 rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl scroll-mt-24">
    <AnimatedGrid opacity={0.10} />
    <FloatingOrb color="orange" size="lg" class="-top-24 -left-24 opacity-60 pointer-events-none" duration="16s" />
    <SectionSpark color="orange" size="md" class="top-10 right-[8%] pointer-events-none" delay="0s" />

    <div class="relative mx-auto max-w-[1280px] px-6 sm:px-8 z-10">
      <div class="max-w-4xl space-y-6 text-left">
        
        <div class="inline-flex items-center gap-2">
          <span class="w-7 h-[2px] bg-[#ff762b] shrink-0" aria-hidden="true"></span>
          <span class="font-mono font-semibold text-xs sm:text-sm uppercase tracking-[0.08em] text-[#ff762b]">
            SELECTED CLIENT WORK
          </span>
        </div>

        <h1 class="font-heading font-bold text-[32px] sm:text-[44px] lg:text-[54px] leading-[1.12] tracking-[-0.03em] text-white">
          Work across campaigns, websites, content and digital products.
        </h1>

        <p class="text-base sm:text-lg leading-[1.65] text-slate-200 font-body font-normal max-w-3xl">
          Explore Starts Digital project experience across e-commerce, immigration, local services, agriculture, technology and diagnostic healthcare.
        </p>

        <!-- Factual Hero Statistics -->
        <div class="pt-3 grid grid-cols-2 sm:grid-cols-4 gap-3 max-w-3xl">
          <div class="rounded-2xl border border-white/15 bg-white/5 p-3.5 text-left">
            <span class="font-heading font-bold text-xl sm:text-2xl text-[#ddff35] block">12</span>
            <span class="text-xs font-mono text-slate-300 block mt-0.5">Client Brands</span>
          </div>

          <div class="rounded-2xl border border-white/15 bg-white/5 p-3.5 text-left">
            <span class="font-heading font-bold text-xl sm:text-2xl text-[#ff762b] block">4</span>
            <span class="text-xs font-mono text-slate-300 block mt-0.5">Detailed Project Stories</span>
          </div>

          <div class="rounded-2xl border border-white/15 bg-white/5 p-3.5 text-left">
            <span class="font-heading font-bold text-xl sm:text-2xl text-[#39c98a] block">8</span>
            <span class="text-xs font-mono text-slate-300 block mt-0.5">Client Experience Profiles</span>
          </div>

          <div class="rounded-2xl border border-white/15 bg-white/5 p-3.5 text-left">
            <span class="font-heading font-bold text-xl sm:text-2xl text-white block">Local & Int’l</span>
            <span class="text-xs font-mono text-slate-300 block mt-0.5">Work Reach</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. CLIENT FILTERING CONTROLS SECTION -->
  <section id="work-filters" class="py-8 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 sticky top-16 z-30 shadow-xs backdrop-blur-md bg-[#f7f4ed]/95">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8 space-y-4">
      
      <div class="flex flex-wrap items-center justify-between gap-4 pb-2 border-b border-[#061d33]/10">
        <div class="flex items-center gap-2">
          <Filter class="size-4 text-[#ff762b]" />
          <span class="font-heading font-bold text-sm text-[#061d33] uppercase tracking-wider">
            Filter Client Projects
          </span>
        </div>

        <div class="flex items-center gap-3">
          <span id="visible-count-text" class="text-xs font-mono font-bold bg-white text-[#061d33] px-3 py-1.5 rounded-full border border-[#061d33]/10">
            Showing 12 of 12 Projects
          </span>
          <button
            id="reset-filters-btn"
            type="button"
            class="inline-flex items-center gap-1.5 min-h-[44px] px-3.5 py-1.5 rounded-full bg-white text-xs font-body font-semibold text-[#061d33] hover:bg-[#061d33] hover:text-white border border-[#061d33]/15 transition-all cursor-pointer"
          >
            <RotateCcw class="size-3.5 text-[#ff762b]" />
            <span>Reset Filters</span>
          </button>
        </div>
      </div>

      <!-- Filter Controls Groups Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 text-xs font-body">
        
        <!-- Filter Group 1: Project Type -->
        <div class="space-y-1.5">
          <span class="font-mono font-semibold uppercase text-slate-500 text-[11px] block">Project Type</span>
          <div class="flex flex-wrap gap-1.5" id="type-filter-group">
            <button type="button" data-filter-type="type" data-value="all" aria-pressed="true" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/20 bg-[#061d33] text-white font-medium cursor-pointer transition-all">All Work</button>
            <button type="button" data-filter-type="type" data-value="detailed" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Detailed Stories</button>
            <button type="button" data-filter-type="type" data-value="experience" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Client Experience</button>
          </div>
        </div>

        <!-- Filter Group 2: Industry Sector -->
        <div class="space-y-1.5">
          <span class="font-mono font-semibold uppercase text-slate-500 text-[11px] block">Industry Sector</span>
          <div class="flex flex-wrap gap-1.5" id="industry-filter-group">
            <button type="button" data-filter-type="industry" data-value="all" aria-pressed="true" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/20 bg-[#061d33] text-white font-medium cursor-pointer transition-all">All</button>
            <button type="button" data-filter-type="industry" data-value="ecommerce" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">E-Commerce</button>
            <button type="button" data-filter-type="industry" data-value="immigration" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Immigration & Setup</button>
            <button type="button" data-filter-type="industry" data-value="construction" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Construction</button>
            <button type="button" data-filter-type="industry" data-value="agriculture" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Agriculture</button>
            <button type="button" data-filter-type="industry" data-value="technology" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Technology</button>
            <button type="button" data-filter-type="industry" data-value="healthcare" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Healthcare</button>
          </div>
        </div>

        <!-- Filter Group 3: Core Service -->
        <div class="space-y-1.5">
          <span class="font-mono font-semibold uppercase text-slate-500 text-[11px] block">Service Discipline</span>
          <div class="flex flex-wrap gap-1.5" id="service-filter-group">
            <button type="button" data-filter-type="service" data-value="all" aria-pressed="true" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/20 bg-[#061d33] text-white font-medium cursor-pointer transition-all">All</button>
            <button type="button" data-filter-type="service" data-value="paid-advertising" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Paid Ads</button>
            <button type="button" data-filter-type="service" data-value="website-design-development" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Web Dev</button>
            <button type="button" data-filter-type="service" data-value="seo-local-search" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">SEO</button>
            <button type="button" data-filter-type="service" data-value="creative-content" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Creative</button>
            <button type="button" data-filter-type="service" data-value="social-media-marketing" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">Social</button>
            <button type="button" data-filter-type="service" data-value="ai-marketing-workflows" aria-pressed="false" class="filter-btn min-h-[44px] px-3 py-2 rounded-xl border border-[#061d33]/15 bg-white text-[#061d33] hover:bg-slate-100 font-medium cursor-pointer transition-all">AI Workflows</button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 3. FOUR DETAILED PROJECT STORIES SECTION -->
  <section id="detailed-stories" class="py-16 sm:py-20 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
      
      <div class="mb-10 text-left max-w-3xl space-y-2">
        <SectionEyebrow label="DETAILED PROJECT STORIES" align="left" motion={false} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] text-[#061d33] leading-tight">
          Four Detailed Project Stories
        </h2>
        <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
          In-depth project documentations featuring verified outcomes, system breakdowns, and comprehensive execution details.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
        {detailedProjects.map((proj) => {
          const actionLabel = getDetailTypeActionLabel(proj.detailType);
          const indCat = getProjectIndustryCategory(proj);
          const svcList = proj.serviceIds.join(',');

          return (
            <article 
              class="project-card rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-8 flex flex-col justify-between shadow-xs hover:border-[#ff762b]/40 hover:shadow-md transition-all duration-300 group"
              data-project-card
              data-type="detailed"
              data-industry={indCat}
              data-services={svcList}
            >
              <div class="space-y-5">
                
                <!-- Card Header -->
                <div class="flex items-center justify-between gap-3 pb-4 border-b border-[#061d33]/8">
                  <span class="rounded-full bg-[#ff762b]/15 border border-[#ff762b]/30 px-3 py-0.5 text-xs font-mono font-bold text-[#ff762b] uppercase tracking-wider">
                    {proj.sector}
                  </span>

                  <!-- Brand Logo Zone -->
                  <div class={`h-11 w-32 rounded-xl px-2.5 py-1 flex items-center justify-center border ${proj.darkLogoContainer ? 'bg-[#061d33] border-[#061d33]' : 'bg-slate-50 border-slate-200'}`}>
                    <img
                      src={`${site.basePath}${proj.logo}`}
                      alt={`${proj.publicName} logo`}
                      width="120"
                      height="36"
                      loading="lazy"
                      class="max-h-7 w-auto object-contain"
                    />
                  </div>
                </div>

                <!-- Title & Relationship -->
                <div>
                  <h3 class="font-heading font-bold text-2xl text-[#061d33] group-hover:text-[#ff762b] transition-colors leading-tight">
                    {proj.publicName}
                  </h3>
                  {proj.primaryRelationship ? (
                    <div class="mt-1.5 flex flex-wrap gap-2">
                      <span class="inline-flex items-center rounded-md bg-[#ddff35]/20 border border-[#ddff35]/50 px-2.5 py-0.5 text-xs font-mono font-semibold text-[#061d33]">
                        {proj.primaryRelationship}
                      </span>
                      {proj.secondaryRelationship ? (
                        <span class="inline-flex items-center rounded-md bg-[#ff762b]/10 border border-[#ff762b]/30 px-2.5 py-0.5 text-xs font-mono font-semibold text-[#ff762b]">
                          {proj.secondaryRelationship}
                        </span>
                      ) : null}
                    </div>
                  ) : proj.relationshipType ? (
                    <span class="inline-block mt-1 font-mono text-xs text-[#ff762b] font-semibold">
                      {proj.relationshipType}
                    </span>
                  ) : null}
                </div>

                <!-- Contribution Summary -->
                <div class="space-y-1.5">
                  <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-400 block">
                    Approved Contribution
                  </span>
                  <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
                    {proj.shortSummary}
                  </p>
                </div>

                <!-- Verified Result -->
                {proj.verifiedOutcome ? (
                  <div class="p-4 rounded-2xl bg-[#f7f4ed] border border-[#061d33]/8 space-y-1">
                    <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[#061d33] block">
                      Verified Outcome
                    </span>
                    <p class="text-base font-body font-semibold text-[#061d33] leading-relaxed">
                      {proj.verifiedOutcome}
                    </p>
                  </div>
                ) : proj.verifiedContribution ? (
                  <div class="p-4 rounded-2xl bg-[#f7f4ed] border border-[#061d33]/8 space-y-1">
                    <span class="text-xs font-mono font-semibold uppercase tracking-wider text-[#061d33] block">
                      Verified Contribution
                    </span>
                    <p class="text-base font-body font-semibold text-[#061d33] leading-relaxed">
                      {proj.verifiedContribution}
                    </p>
                  </div>
                ) : null}

                <!-- Services Tags -->
                <div class="pt-2 flex flex-wrap gap-2">
                  {proj.approvedServices.map((svc) => (
                    <span class="inline-flex items-center gap-1.5 rounded-lg bg-slate-100 px-2.5 py-1 text-xs font-mono text-slate-700 border border-slate-200">
                      <CheckCircle2 class="size-3 text-[#ff762b]" />
                      <span>{svc}</span>
                    </span>
                  ))}
                </div>

              </div>

              <!-- Card Actions -->
              <div class="flex flex-wrap items-center justify-between gap-3 pt-5 mt-6 border-t border-[#061d33]/8">
                <a
                  href={`${site.basePath}${proj.detailPath}`}
                  class="inline-flex items-center gap-2 rounded-full bg-[#061d33] min-h-[44px] px-5 py-2.5 text-sm font-body font-semibold text-white hover:bg-[#ff762b] transition-all shadow-xs"
                >
                  <span>{actionLabel}</span>
                  <ArrowRight class="size-4 group-hover:translate-x-1 transition-transform" />
                </a>

                {proj.officialWebsite && (
                  <a
                    href={proj.officialWebsite}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 rounded-full border border-slate-300 bg-[#f7f4ed] min-h-[44px] px-4 py-2.5 text-sm font-body font-semibold text-[#061d33] hover:border-[#061d33] hover:bg-white transition-all shadow-xs"
                  >
                    <span>Website</span>
                    <ExternalLink class="size-3.5" />
                  </a>
                )}
              </div>
            </article>
          );
        })}
      </div>

    </div>
  </section>

  <!-- 4. EIGHT CLIENT EXPERIENCE PROFILES SECTION -->
  <section id="client-experience" class="py-16 sm:py-20 bg-white text-[#061d33] border-b border-[#061d33]/10">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
      
      <div class="mb-10 text-left max-w-3xl space-y-2">
        <SectionEyebrow label="CLIENT EXPERIENCE PROFILES" align="left" motion={false} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] text-[#061d33] leading-tight">
          Eight Client Experience Profiles
        </h2>
        <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
          Client work across e-commerce, immigration, construction, and healthcare. Profiles feature project contributions, services, and reported performance.
        </p>
      </div>

      <!-- 8 Client Experience Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {experienceProjects.map((p) => {
          const actionLabel = getDetailTypeActionLabel(p.detailType);
          const indCat = getProjectIndustryCategory(p);
          const svcList = p.serviceIds.join(',');
          const locStr = getProjectLocation(p);
          const isPending = p.evidenceStatus === 'user-provided-pending-evidence';

          return (
            <article 
              class="project-card rounded-3xl border border-[#061d33]/12 bg-[#faf9f6] p-6 sm:p-7 flex flex-col justify-between shadow-xs hover:border-[#ff762b]/40 hover:shadow-md transition-all duration-300 group"
              data-project-card
              data-type="experience"
              data-industry={indCat}
              data-services={svcList}
            >
              <div class="space-y-4">
                
                <!-- Logo & Sector Header -->
                <div class="flex items-center justify-between gap-3 pb-3 border-b border-[#061d33]/8">
                  <span class="rounded-full bg-[#061d33]/5 border border-[#061d33]/10 px-2.5 py-0.5 text-[11px] font-mono font-semibold text-slate-600 uppercase tracking-wider">
                    {p.sector}
                  </span>

                  <div class={`h-10 w-28 rounded-xl px-2 py-1 flex items-center justify-center border shrink-0 ${p.darkLogoContainer ? 'bg-[#061d33] border-[#061d33]' : 'bg-white border-slate-200'}`}>
                    <img
                      src={`${site.basePath}${p.logo}`}
                      alt={`${p.publicName} logo`}
                      width="110"
                      height="32"
                      loading="lazy"
                      class="max-h-6 w-auto object-contain"
                    />
                  </div>
                </div>

                <!-- Brand Name & Location -->
                <div>
                  <h3 class="font-heading font-bold text-xl text-[#061d33] group-hover:text-[#ff762b] transition-colors leading-tight">
                    {p.publicName}
                  </h3>
                  <div class="flex items-center gap-1.5 mt-1 text-xs font-mono text-slate-500">
                    <MapPin class="size-3.5 text-[#ff762b]" />
                    <span>{locStr}</span>
                  </div>
                </div>

                <!-- Contribution Summary -->
                <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
                  {p.shortSummary}
                </p>

                <!-- Reported Result Block -->
                {p.reportedResult && (
                  <div class="p-3.5 rounded-2xl bg-white border border-[#061d33]/10 space-y-1">
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#ff762b]">
                        {p.resultLabel || 'Reported Result'}
                      </span>
                      {isPending && (
                        <span class="text-[10px] font-mono text-amber-700 bg-amber-100 px-2 py-0.5 rounded-md font-semibold">
                          Evidence Pending
                        </span>
                      )}
                    </div>
                    <p class="text-xs font-body font-medium text-slate-800 leading-normal">
                      {p.reportedResult}
                    </p>
                  </div>
                )}

                <!-- Services Tags -->
                <div class="pt-1 flex flex-wrap gap-1.5">
                  {p.approvedServices.slice(0, 3).map((svc) => (
                    <span class="inline-flex items-center gap-1 rounded-md bg-white px-2 py-0.5 text-[11px] font-mono text-slate-700 border border-slate-200 font-medium">
                      <span>{svc}</span>
                    </span>
                  ))}
                </div>

              </div>

              <!-- Action Footer -->
              <div class="pt-4 mt-6 border-t border-[#061d33]/8 flex flex-wrap items-center justify-between gap-2.5">
                <a
                  href={`${site.basePath}${p.detailPath}`}
                  class="inline-flex items-center gap-2 rounded-full bg-[#061d33] px-4 py-2.5 min-h-[44px] text-sm font-body font-semibold text-white hover:bg-[#ff762b] transition-all shadow-xs"
                >
                  <span>{actionLabel}</span>
                  <ArrowRight class="size-4 group-hover:translate-x-1 transition-transform" />
                </a>

                {p.officialWebsite ? (
                  <a
                    href={p.officialWebsite}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Official website for ${p.publicName}`}

  <!-- Vanilla Client-Side Filtering Script -->
  <script>
    function initWorkFilters() {
      const cards = Array.from(document.querySelectorAll('[data-project-card]')) as HTMLElement[];
      const countEl = document.getElementById('visible-count-text');
      const resetBtn = document.getElementById('reset-filters-btn');

      if (cards.length === 0) return;

      let activeType = 'all';
      let activeIndustry = 'all';
      let activeService = 'all';

      function updateFiltering() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const cardType = card.dataset.type || '';
          const cardIndustry = card.dataset.industry || '';
          const cardServices = (card.dataset.services || '').split(',');

          const matchType = activeType === 'all' || cardType === activeType;
          const matchIndustry = activeIndustry === 'all' || cardIndustry === activeIndustry;
          const matchService = activeService === 'all' || cardServices.includes(activeService);

          if (matchType && matchIndustry && matchService) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (countEl) {
          countEl.textContent = `Showing ${visibleCount} of ${cards.length} Projects`;
        }
      }

      function setupFilterGroup(groupSelector: string, filterCategory: 'type' | 'industry' | 'service') {
        const buttons = Array.from(document.querySelectorAll(`[data-filter-type="${filterCategory}"]`)) as HTMLButtonElement[];
        
        buttons.forEach((btn) => {
          btn.addEventListener('click', () => {
            buttons.forEach((b) => {
              b.setAttribute('aria-pressed', 'false');
              b.classList.remove('bg-[#061d33]', 'text-white', 'border-[#061d33]/20');
              b.classList.add('bg-white', 'text-[#061d33]', 'border-[#061d33]/15');
            });

            btn.setAttribute('aria-pressed', 'true');
            btn.classList.remove('bg-white', 'text-[#061d33]', 'border-[#061d33]/15');
            btn.classList.add('bg-[#061d33]', 'text-white', 'border-[#061d33]/20');

            const val = btn.dataset.value || 'all';
            if (filterCategory === 'type') activeType = val;
            if (filterCategory === 'industry') activeIndustry = val;
            if (filterCategory === 'service') activeService = val;

            updateFiltering();
          });
        });
      }

      setupFilterGroup('#type-filter-group', 'type');
      setupFilterGroup('#industry-filter-group', 'industry');
      setupFilterGroup('#service-filter-group', 'service');

      resetBtn?.addEventListener('click', () => {
        activeType = 'all';
        activeIndustry = 'all';
        activeService = 'all';

        (['type', 'industry', 'service'] as const).forEach((cat) => {
          const buttons = Array.from(document.querySelectorAll(`[data-filter-type="${cat}"]`)) as HTMLButtonElement[];
          buttons.forEach((b) => {
            const isAll = b.dataset.value === 'all';
            b.setAttribute('aria-pressed', isAll ? 'true' : 'false');
            if (isAll) {
              b.classList.remove('bg-white', 'text-[#061d33]', 'border-[#061d33]/15');
              b.classList.add('bg-[#061d33]', 'text-white', 'border-[#061d33]/20');
            } else {
              b.classList.remove('bg-[#061d33]', 'text-white', 'border-[#061d33]/20');
              b.classList.add('bg-white', 'text-[#061d33]', 'border-[#061d33]/15');
            }
          });
        });

        updateFiltering();
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWorkFilters);
    } else {
      initWorkFilters();
    }
    document.addEventListener('astro:page-load', initWorkFilters);
  </script>

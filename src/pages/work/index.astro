---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import WorkEditorialHero from '../../components/work/WorkEditorialHero.astro';
import ProjectCard from '../../components/work/ProjectCard.astro';
import WorkDeliverablesGallery from '../../components/work/WorkDeliverablesGallery.astro';
import WorkResultsSection from '../../components/work/WorkResultsSection.astro';
import AIWorkflowStory from '../../components/landing/AIWorkflowStory.astro';
import AnimatedGrid from '../../components/motion/AnimatedGrid.astro';
import FloatingOrb from '../../components/motion/FloatingOrb.astro';
import { site } from '../../site.config';
import { ArrowRight, MessageSquare, Sparkles } from '@lucide/astro';

const genericWhatsappMsg = encodeURIComponent('Hello Starts Digital, I would like to discuss a new digital marketing project.');
const whatsappUrl = `${site.contact.whatsapp}?text=${genericWhatsappMsg}`;

const processSteps = [
  {
    number: '01',
    title: 'Discovery & Goal Alignment',
    description: 'We review your business goals, target audience, competitive environment and available assets to define clear project requirements.'
  },
  {
    number: '02',
    title: 'Strategy & Roadmap Design',
    description: 'We structure the campaign angle, website architecture, content schedule or AI workflow into a documented execution plan.'
  },
  {
    number: '03',
    title: 'Production & Launch Execution',
    description: 'Our team builds the website, edits video ad creatives, configures local search and launches paid social campaigns.'
  },
  {
    number: '04',
    title: 'Review & Optimization',
    description: 'We monitor ad performance, user conversions and lead routing to refine creative messaging and scale winning channels.'
  }
];
---

<BaseLayout>
  <!-- 1. WORK HERO (Layered Editorial Canvas) -->
  <section id="work-hero" class="relative overflow-hidden bg-[#061d33] text-white pt-16 sm:pt-20 lg:pt-24 pb-16 sm:pb-20 lg:pb-24 rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl">
    <AnimatedGrid opacity={0.10} />
    <FloatingOrb color="orange" size="lg" class="-top-24 -left-24 opacity-60 pointer-events-none" duration="16s" />

    <Container class="max-w-[1280px] px-6 sm:px-8 relative z-10 space-y-12">
      <!-- Hero Text Header -->
      <div class="text-center max-w-3xl mx-auto space-y-6">
        <div class="inline-flex items-center gap-2">
          <span class="w-7 h-[2px] bg-[#ff762b] shrink-0" aria-hidden="true"></span>
          <span class="font-mono font-semibold text-xs sm:text-sm uppercase tracking-[0.08em] text-[#ff762b]">
            DIGITAL DELIVERABLES & EXECUTION
          </span>
        </div>

        <h1 class="font-heading font-bold text-[36px] sm:text-[48px] lg:text-[60px] leading-[1.08] tracking-[-0.035em] text-white">
          Work Built Around Real Business Goals
        </h1>

        <p class="text-base sm:text-lg leading-[1.65] text-slate-200 font-body font-normal max-w-2xl mx-auto">
          Explore how Starts Digital connects advertising, websites, creative production, social media, search visibility and AI-supported workflows.
        </p>

        <div class="pt-2 flex flex-wrap justify-center gap-4 items-center font-body">
          <a
            href={`${site.basePath}/contact/`}
            class="inline-flex items-center gap-2.5 rounded-full bg-[#ff762b] px-7 py-3.5 text-sm font-semibold text-white shadow-lg hover:bg-[#e0611a] hover:shadow-xl transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
          >
            <span>Discuss Your Project</span>
            <ArrowRight class="size-4" />
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-6 py-3.5 text-sm font-medium text-white hover:bg-white/20 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
          >
            <MessageSquare class="size-4 text-[#39c98a]" />
            <span>WhatsApp Direct</span>
          </a>
        </div>
      </div>

      <!-- Editorial Photography Hero Composition -->
      <WorkEditorialHero />
    </Container>
  </section>

  <!-- 2. SELECTED PROJECT WORK (Featured Real Client Projects) -->
  <section id="selected-projects" class="py-16 sm:py-24 bg-[#f7f4ed] border-b border-[#061d33]/10">
    <Container class="max-w-[1280px] px-6 sm:px-8 space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-[#ff762b] bg-[#ff762b]/10 px-3 py-1 rounded-full">
          <Sparkles class="size-3.5" />
          <span>FEATURED CLIENT CASE STUDIES</span>
        </span>
        <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-[#061d33]">
          SELECTED PROJECT WORK
        </h2>
        <p class="font-body text-base sm:text-lg text-slate-700 max-w-2xl mx-auto">
          Explore dedicated project hubs featuring full video short galleries, technical engineering context, and client deliverables.
        </p>
      </div>

      <div class="space-y-8">
        <!-- Project 1: My Coach Live -->
        <ProjectCard
          title="My Coach Live"
          category="Technology & Fitness Platform"
          industry="Fitness & Wellness Technology"
          status="ONGOING PROJECT"
          summary="Ongoing project support for a remote fitness coaching platform providing live trainer guidance, nutritionist support, session booking, workout history, progress tracking, and personalised diet plans for UK and US clients."
          videoCount={10}
          projectLink="/work/my-coach-live/"
          website="https://my-coach.live/"
          posterYoutubeId="V0Ax0MGuuNw"
        />

        <!-- Project 2: ConvortAI -->
        <ProjectCard
          title="ConvortAI"
          category="AI Technology Partner"
          industry="AI Platform & App Development"
          summary="Starts Digital is an ongoing technology and growth partner for ConvortAI. We developed the ConvortAI web application and continue to support product development, project management, social media marketing, creative production and digital growth."
          videoCount={4}
          projectLink="/work/convort-ai/"
          website="https://convortai.com/"
          posterYoutubeId="NvXKjRNad6Q"
        />

        <!-- Project 3: Shopinq Online -->
        <ProjectCard
          title="Shopinq Online"
          category="E-Commerce Distribution"
          industry="Retail Product Marketing"
          summary="Promoted startup product lines through paid social campaigns, creative content production, customer communication, and order support on a sales-commission structure."
          videoCount={16}
          projectLink="/work/shopinq-online/"
          website="https://www.facebook.com/shopinq.online/"
          posterYoutubeId="PnYdfatKb4I"
        />
      </div>
    </Container>
  </section>

  <!-- 3. VISUAL DELIVERABLES GALLERY -->
  <WorkDeliverablesGallery />

  <!-- 4. DEDICATED SELECTED RESULTS SECTION -->
  <WorkResultsSection />

  <!-- 5. HOW STRATEGY, CREATIVE & WEB CONNECT -->
  <section class="py-16 sm:py-20 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10">
    <Container class="max-w-[1000px] px-6 sm:px-8 text-center space-y-8">
      <span class="font-mono text-xs uppercase tracking-widest text-[#ff762b]">How It All Connects</span>
      <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-[#061d33]">
        How Strategy, Creative and Web Tech Come Together
      </h2>
      <p class="font-body text-base sm:text-lg text-slate-700 leading-relaxed max-w-3xl mx-auto">
        Great marketing requires alignment across every touchpoint. We connect high-converting ad creative, high-speed website engineering, local search optimisation and lead routing so your marketing investment reaches real customers.
      </p>
    </Container>
  </section>

  <!-- 6. AI CREATIVE INNOVATION STORY -->
  <AIWorkflowStory />

  <!-- 7. PROJECT PROCESS -->
  <section class="py-16 sm:py-24 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10">
    <Container class="max-w-[1280px] px-6 sm:px-8">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <span class="inline-block font-mono text-xs uppercase tracking-widest text-[#ff762b]">
          WORKING METHOD
        </span>
        <h2 class="font-heading text-3xl sm:text-4xl font-bold tracking-tight text-[#061d33]">
          A Transparent Four-Step Working Method
        </h2>
        <p class="font-body text-base sm:text-lg text-slate-700 max-w-2xl mx-auto">
          From initial requirements discovery through strategy, production, and ongoing performance review.
        </p>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {processSteps.map((step) => (
          <div class="rounded-3xl border-2 border-[#061d33]/15 bg-white p-6 space-y-4 shadow-md flex flex-col justify-between">
            <div class="space-y-3">
              <span class="font-mono text-2xl font-bold text-[#ff762b] block">
                {step.number}
              </span>
              <h3 class="font-heading font-bold text-xl text-[#061d33]">
                {step.title}
              </h3>
              <p class="font-body text-xs sm:text-sm text-slate-600 leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 8. GENERAL PROJECT CTA -->
  <section class="py-16 sm:py-24 bg-[#061d33] text-white text-center">
    <Container class="max-w-[900px] px-6 sm:px-8 space-y-8">
      <h2 class="font-heading text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white leading-tight">
        Ready to Discuss Your Project Goals?
      </h2>
      <p class="font-body text-base sm:text-lg text-slate-300 max-w-xl mx-auto">
        Connect directly with our team to outline your requirements, get strategy recommendations, and start your campaign or web platform.
      </p>

      <div class="flex flex-wrap justify-center gap-4 font-body">
        <a
          href={`${site.basePath}/contact/`}
          class="inline-flex items-center gap-2.5 rounded-full bg-[#ff762b] px-8 py-4 text-base font-semibold text-white shadow-xl hover:bg-[#e0611a] transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#ff762b]"
        >
          <span>Start a Project</span>
          <ArrowRight class="size-5" />
        </a>
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-7 py-4 text-base font-medium text-white hover:bg-white/20 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          <MessageSquare class="size-5 text-[#39c98a]" />
          <span>Talk About Your Goals</span>
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>

---
import ProjectStoryLayout from '../../layouts/ProjectStoryLayout.astro';
import { CheckCircle2, Cpu, Code2, Rocket, Share2, Palette, Layers, LineChart } from '@lucide/astro';
---

<ProjectStoryLayout
  projectSlug="convortai"
  title="ConvortAI Technology and Growth Partnership"
  description="Explore Starts Digital’s technology, product development, project management, social media, creative production and growth support for ConvortAI."
  variant="technology"
>
  <!-- Section 1: Product Context -->
  <div class="space-y-4">
    <h2 class="font-heading font-bold text-2xl text-[#061d33] border-b border-[#061d33]/10 pb-3">
      Product Context
    </h2>
    <p class="text-base text-slate-700 font-body leading-relaxed">
      ConvortAI is a WhatsApp-focused automation platform designed to support business sales and customer-response workflows.
    </p>
  </div>

  <!-- Section 2: Starts Digital Relationship & Scope -->
  <div class="space-y-4 pt-2">
    <h2 class="font-heading font-bold text-2xl text-[#061d33]">
      Starts Digital Relationship & Scope
    </h2>
    <div class="p-6 rounded-2xl bg-[#061d33] text-white space-y-3">
      <div class="flex items-center gap-2">
        <Cpu class="size-5 text-[#ddff35]" />
        <span class="font-heading font-bold text-xl text-white">Technology Partner</span>
      </div>
      <p class="font-mono text-sm text-[#ff762b] font-semibold uppercase tracking-wider">
        Product Development & Growth Partner
      </p>
      <p class="text-base text-slate-200 font-body leading-relaxed pt-1">
        Starts Digital developed the ConvortAI web application and continues supporting product development, project management, social media, creative production and growth.
      </p>
    </div>
  </div>

  <!-- Section 3: Core Contribution Areas -->
  <div class="space-y-4 pt-2">
    <h2 class="font-heading font-bold text-2xl text-[#061d33]">
      Core Contribution Areas
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="rounded-xl border border-[#061d33]/10 bg-[#faf9f6] p-5 space-y-2">
        <div class="flex items-center gap-2 text-[#061d33] font-bold text-base">
          <Code2 class="size-4 text-[#ff762b]" />
          <span>Web Application Development</span>
        </div>
        <p class="text-base text-slate-700 font-body leading-relaxed">
          Starts Digital developed the ConvortAI web application.
        </p>
      </div>

      <div class="rounded-xl border border-[#061d33]/10 bg-[#faf9f6] p-5 space-y-2">
        <div class="flex items-center gap-2 text-[#061d33] font-bold text-base">
          <Rocket class="size-4 text-[#ff762b]" />
          <span>Product Development</span>
        </div>
        <p class="text-base text-slate-700 font-body leading-relaxed">
          Starts Digital continues supporting product development and coordinated project requirements.
        </p>
      </div>

      <div class="rounded-xl border border-[#061d33]/10 bg-[#faf9f6] p-5 space-y-2">
        <div class="flex items-center gap-2 text-[#061d33] font-bold text-base">
          <Layers class="size-4 text-[#ff762b]" />
          <span>Project Management</span>
        </div>
        <p class="text-base text-slate-700 font-body leading-relaxed">
          Starts Digital supports project planning and coordination.
        </p>
      </div>

      <div class="rounded-xl border border-[#061d33]/10 bg-[#faf9f6] p-5 space-y-2">
        <div class="flex items-center gap-2 text-[#061d33] font-bold text-base">
          <Share2 class="size-4 text-[#ff762b]" />
          <span>Social Media</span>
        </div>
        <p class="text-base text-slate-700 font-body leading-relaxed">
          Starts Digital supports social media communication.
        </p>
      </div>

      <div class="rounded-xl border border-[#061d33]/10 bg-[#faf9f6] p-5 space-y-2">
        <div class="flex items-center gap-2 text-[#061d33] font-bold text-base">
          <Palette class="size-4 text-[#ff762b]" />
          <span>Creative Production</span>
        </div>
        <p class="text-base text-slate-700 font-body leading-relaxed">
          Starts Digital supports creative production for product and brand communication.
        </p>
      </div>

      <div class="rounded-xl border border-[#061d33]/10 bg-[#faf9f6] p-5 space-y-2">
        <div class="flex items-center gap-2 text-[#061d33] font-bold text-base">
          <LineChart class="size-4 text-[#ff762b]" />
          <span>Growth Support</span>
        </div>
        <p class="text-base text-slate-700 font-body leading-relaxed">
          Starts Digital contributes to ongoing growth-related planning and execution.
        </p>
      </div>
    </div>
  </div>

  <!-- Section 4: Coordinated Working Model -->
  <div class="space-y-4 pt-2">
    <h2 class="font-heading font-bold text-2xl text-[#061d33]">
      Coordinated Working Model
    </h2>
    <p class="text-base text-slate-700 font-body leading-relaxed">
      By coordinating web application development, project management, creative production, social media, and growth planning under one integrated team, Starts Digital provides unified execution across product and communication disciplines.
    </p>

    <div class="space-y-3 pt-2">
      {[
        'Web Application Development',
        'Ongoing Product Development Support',
        'Project Planning and Coordination',
        'Social Media Communication Support',
        'Creative Production for Product and Brand Communication',
        'Ongoing Growth-Related Planning and Execution'
      ].map((item) => (
        <div class="flex items-start gap-3 text-base font-body text-slate-800">
          <CheckCircle2 class="size-5 text-[#39c98a] shrink-0 mt-0.5" />
          <span>{item}</span>
        </div>
      ))}
    </div>
  </div>
</ProjectStoryLayout>

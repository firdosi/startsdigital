---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import Button from '../../components/ui/Button.astro';
import FinalCta from '../../components/landing/FinalCta.astro';
import { ArrowRight } from '@lucide/astro';
import LightweightVisual3D from '../../components/visuals/LightweightVisual3D.astro';
import Industries3DSectorComposition from '../../components/industries/Industries3DSectorComposition.astro';
import { site } from '../../site.config';
import { getServiceById } from '../../data/services';
import { industriesFaqs } from '../../data/faqs';
import { getIndustryPages } from '../../data/marketPages';

const industryPages = getIndustryPages();

const industryVisualMap: Record<string, any> = {
  'ecommerce-product-brands': 'industry-ecommerce',
  'seasonal-campaigns': 'industry-seasonal',
  'local-service-businesses': 'industry-local',
  'technology-products': 'industry-tech',
};
---

<BaseLayout>
  <!-- 1. Hero Section -->
  <section class="relative pt-8 pb-12 sm:pt-20 sm:pb-16 lg:pt-24 lg:pb-20 bg-[#061d33] text-white border-b border-slate-800/80 overflow-hidden">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-12 items-center">
        <!-- Left Column: Copy & CTA -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <span class="inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-wider text-[#ff762b] bg-[#ff762b]/10 border border-[#ff762b]/30 px-3.5 py-1.5 rounded-full">
            INDUSTRIES & BUSINESS SECTORS
          </span>
          <h1 class="font-heading font-bold text-[28px] sm:text-[44px] lg:text-[52px] text-white leading-tight tracking-tight">
            Digital Services Structured Around Different Business Models
          </h1>
          <p class="text-base sm:text-lg text-slate-300 font-body font-normal leading-relaxed">
            Different business models require different combinations of advertising, websites, SEO, content, social media and technical support.
          </p>
          <div class="pt-2">
            <a
              href="#sectors"
              class="inline-flex items-center gap-2 rounded-full bg-[#ff762b] px-6 py-3 font-body font-semibold text-sm text-white hover:bg-[#e56017] transition-all shadow-md min-h-[44px]"
            >
              <span>Explore Sector Models</span>
              <ArrowRight class="size-4" />
            </a>
          </div>
        </div>

        <!-- Right Column: Unique 4-Sector 3D Composition Anchor (5 cols) -->
        <div class="lg:col-span-5">
          <Industries3DSectorComposition />
        </div>
      </div>
    </Container>
  </section>

  <!-- 2. Sector Photography Visual Showcase -->
  <section id="sector-visuals" class="py-16 sm:py-20 bg-white text-[#061d33] border-b border-[#061d33]/10">
    <Container class="space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <SectionEyebrow label="SECTOR VISUAL EXAMPLES" align="center" motion={false} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
          Real Business Operations Across Sectors
        </h2>
        <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
          From e-commerce product logistics to location-based marketing strategies.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- E-Commerce Fulfillment Showcase -->
        <div class="rounded-3xl border border-[#061d33]/12 bg-[#faf9f6] overflow-hidden shadow-xs group hover:border-[#ff762b]/40 transition-all duration-300">
          <div class="overflow-hidden aspect-16/9 relative bg-[#061d33]">
            <picture>
              <source srcset={`${site.basePath}/photography/ecommerce-product-fulfillment.avif`} type="image/avif" />
              <img
                src={`${site.basePath}/photography/ecommerce-product-fulfillment.webp`}
                alt="E-commerce product inventory, packaging and logistics"
                width="800"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </picture>
            <div class="absolute top-3 left-3 bg-[#061d33]/90 backdrop-blur-sm px-3 py-1 rounded-full border border-white/20">
              <span class="font-mono text-[10px] uppercase font-bold text-[#ff762b] tracking-wider">E-Commerce & Retail</span>
            </div>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="font-heading font-bold text-xl text-[#061d33]">E-Commerce Sales & Inventory Operations</h3>
            <p class="font-body text-sm text-slate-700 leading-relaxed">
              We connect paid social ad units with WooCommerce and Shopify storefronts to drive product sales and inventory movement.
            </p>
            <div class="pt-2">
              <a href={`${site.basePath}/industries/ecommerce-product-brands/`} class="inline-flex items-center gap-1.5 font-mono text-xs text-[#ff762b] font-bold hover:underline">
                <span>Explore E-Commerce Solutions</span>
                <ArrowRight class="size-3.5" />
              </a>
            </div>
          </div>
        </div>

        <!-- Local Service Marketing Showcase -->
        <div class="rounded-3xl border border-[#061d33]/12 bg-[#faf9f6] overflow-hidden shadow-xs group hover:border-[#ff762b]/40 transition-all duration-300">
          <div class="overflow-hidden aspect-16/9 relative bg-[#061d33]">
            <picture>
              <source srcset={`${site.basePath}/photography/local-service-marketing.avif`} type="image/avif" />
              <img
                src={`${site.basePath}/photography/local-service-marketing.webp`}
                alt="Local contractor and service area search location strategy"
                width="800"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </picture>
            <div class="absolute top-3 left-3 bg-[#061d33]/90 backdrop-blur-sm px-3 py-1 rounded-full border border-white/20">
              <span class="font-mono text-[10px] uppercase font-bold text-[#39c98a] tracking-wider">Local Contractors</span>
            </div>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="font-heading font-bold text-xl text-[#061d33]">Local Search & Service-Area Lead Routing</h3>
            <p class="font-body text-sm text-slate-700 leading-relaxed">
              Optimised location pages and Google Maps search visibility tailored for local contractors and service businesses.
            </p>
            <div class="pt-2">
              <a href={`${site.basePath}/industries/local-service-businesses/`} class="inline-flex items-center gap-1.5 font-mono text-xs text-[#ff762b] font-bold hover:underline">
                <span>Explore Local Service Solutions</span>
                <ArrowRight class="size-3.5" />
              </a>
            </div>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- 3. Four Industry Sectors Grid -->
  <section id="sectors" class="py-16 sm:py-20 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10">
    <Container class="space-y-12">
      <SectionHeading
        theme="light"
        eyebrow="SECTOR CAPABILITIES"
        title="Choose the Business Model Closest to Yours"
        description="Every industry faces unique customer acquisition challenges, inventory cycles, and technical requirements."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {industryPages.map((ind) => {
          return (
            <div class="bg-white border border-[#061d33]/10 rounded-2xl p-8 space-y-6 shadow-sm hover:border-[#ff762b]/40 transition-colors flex flex-col justify-between">
              <div class="space-y-4">
                <LightweightVisual3D type={industryVisualMap[ind.slug] || 'industry-ecommerce'} />
                <h2 class="font-heading font-bold text-2xl text-[#061d33]">
                  {ind.breadcrumbLabel}
                </h2>
                <p class="text-slate-700 font-body text-base leading-relaxed font-normal">
                  {ind.description}
                </p>
              </div>
              <div class="pt-4">
                <Button href={`${site.basePath}${ind.canonicalPath}`} variant="primary" class="w-full sm:w-auto justify-center min-h-[44px]">
                  Explore {ind.breadcrumbLabel}
                  <ArrowRight class="size-4 ml-1.5" />
                </Button>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- 3. Typical Challenges by Sector -->
  <section class="py-16 sm:py-20 bg-white text-[#061d33] border-b border-[#061d33]/10">
    <Container class="space-y-12">
      <SectionHeading
        theme="light"
        eyebrow="TYPICAL CHALLENGES"
        title="Sector-Specific Acquisition Challenges"
        description="Common bottlenecks businesses experience before implementing a structured digital marketing plan."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-[#f7f4ed] border border-[#061d33]/10 p-7 rounded-2xl space-y-3">
          <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">E-COMMERCE BRANDS</span>
          <h3 class="font-heading font-bold text-xl text-[#061d33]">High Ad Fatigue & Unclear Storefront Conversion</h3>
          <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
            E-commerce product brands often struggle with rapid ad fatigue, mobile checkout friction, and unverified customer order tracking.
          </p>
        </div>

        <div class="bg-[#f7f4ed] border border-[#061d33]/10 p-7 rounded-2xl space-y-3">
          <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">SEASONAL CAMPAIGNS</span>
          <h3 class="font-heading font-bold text-xl text-[#061d33]">Time Constraints & Delayed Pre-Bookings</h3>
          <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
            Seasonal operators face tight promotional windows that require fast creative turnaround and immediate lead routing pathways.
          </p>
        </div>

        <div class="bg-[#f7f4ed] border border-[#061d33]/10 p-7 rounded-2xl space-y-3">
          <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">LOCAL CONTRACTORS</span>
          <h3 class="font-heading font-bold text-xl text-[#061d33]">Poor Search Visibility & Fragmented Quotes</h3>
          <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
            Contractors need structured location landing pages and local search foundations to capture nearby commercial search intent.
          </p>
        </div>

        <div class="bg-[#f7f4ed] border border-[#061d33]/10 p-7 rounded-2xl space-y-3">
          <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">TECH PRODUCTS</span>
          <h3 class="font-heading font-bold text-xl text-[#061d33]">Complex Feature Explanation & Product UI</h3>
          <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
            Software products require clear web application interfaces, concise demo messaging, and practical customer onboarding workflows.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. Relevant Service Combinations -->
  <section class="py-16 sm:py-20 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10">
    <Container class="space-y-12">
      <SectionHeading
        theme="light"
        eyebrow="SERVICE COMBINATIONS"
        title="Industry-Specific Service Combinations"
        description="Our six core service lines selected and connected for specific business model requirements and customer acquisition channels."
      />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {industryPages.map((ind) => {
          const comboServices = ind.relevantServiceIds
            .map((id) => getServiceById(id))
            .filter((s) => Boolean(s));

          return (
            <div class="bg-white border border-[#061d33]/10 rounded-2xl p-8 space-y-6 flex flex-col justify-between">
              <div class="space-y-4">
                <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">{ind.eyebrow}</span>
                <h3 class="font-heading font-bold text-2xl text-[#061d33]">{ind.breadcrumbLabel} Combination</h3>
                <p class="text-slate-700 text-base font-body leading-relaxed font-normal">{ind.subtitle}</p>

                <div class="space-y-3 pt-2">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-500 block">Applied Published Services:</span>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                    {comboServices.map((srv) => (
                      <a
                        href={`${site.basePath}/services/${srv!.slug}/`}
                        class="bg-[#f7f4ed] border border-[#061d33]/10 rounded-xl p-3 text-sm font-heading font-semibold text-[#061d33] hover:text-[#ff762b] hover:border-[#ff762b]/40 transition-colors flex items-center justify-between"
                      >
                        <span>{srv!.shortName}</span>
                        <ArrowRight class="size-3.5 text-[#ff762b]" />
                      </a>
                    ))}
                  </div>
                </div>
              </div>

              <div class="pt-4">
                <Button href={`${site.basePath}${ind.canonicalPath}`} variant="secondary" surface="light" class="w-full justify-center min-h-[44px]">
                  View {ind.breadcrumbLabel} Scope &rarr;
                </Button>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- 5. How Project Structures Differ -->
  <section class="py-16 sm:py-20 bg-white text-[#061d33] border-b border-[#061d33]/10">
    <Container class="space-y-12">
      <SectionHeading
        theme="light"
        eyebrow="PROJECT DIFFERENTIATION"
        title="How We Structure Scopes for Different Business Models"
        description="We adapt our service combination based on business model requirements, inventory velocity, and commercial goals."
      />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-[#f7f4ed] border border-[#061d33]/10 p-6 sm:p-8 rounded-2xl space-y-4">
          <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">E-COMMERCE & PRODUCTS</span>
          <h3 class="font-heading font-bold text-xl text-[#061d33]">Transaction & Conversion Focus</h3>
          <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
            Prioritizes direct-response ad creative testing, mobile storefront alignment, campaign copy, and delivered-order tracking.
          </p>
        </div>

        <div class="bg-[#f7f4ed] border border-[#061d33]/10 p-6 sm:p-8 rounded-2xl space-y-4">
          <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">LOCAL CONTRACTORS</span>
          <h3 class="font-heading font-bold text-xl text-[#061d33]">Location & Service Clarity</h3>
          <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
            Focuses on location-specific landing pages, technical local SEO, clear scope displays, and direct WhatsApp quote pathways.
          </p>
        </div>

        <div class="bg-[#f7f4ed] border border-[#061d33]/10 p-6 sm:p-8 rounded-2xl space-y-4">
          <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">TECH & SOFTWARE</span>
          <h3 class="font-heading font-bold text-xl text-[#061d33]">Product & Workflow Development</h3>
          <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
            Engages as an integrated technical and production team developing web applications, UI layouts, practical workflows, and growth content.
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- 6. Dedicated Industries FAQ Section -->
  <section class="py-16 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10">
    <Container class="space-y-8 max-w-4xl">
      <SectionHeading
        theme="light"
        eyebrow="FREQUENTLY ASKED QUESTIONS"
        title="Industry Engagement Questions"
      />
      <div class="space-y-4">
        {industriesFaqs.map((faq) => (
          <div class="bg-white border border-[#061d33]/10 rounded-xl p-6 space-y-2">
            <h3 class="font-heading font-bold text-lg text-[#061d33]">{faq.question}</h3>
            <p class="text-slate-700 text-base font-body leading-relaxed font-normal">{faq.answer}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 7. Contact CTA -->
  <FinalCta title="Discuss Your Sector Requirements & Growth Goals" />
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedServices } from '../../data/services';
import SectionEyebrow from '../../components/common/SectionEyebrow.astro';
import MotionController from '../../components/common/MotionController.astro';
import AnimatedGrid from '../../components/motion/AnimatedGrid.astro';
import FloatingOrb from '../../components/motion/FloatingOrb.astro';
import SectionSpark from '../../components/motion/SectionSpark.astro';
import { site } from '../../site.config';
import {
  Sparkles,
  ArrowRight,
  ChevronDown,
  CheckCircle2,
  Megaphone,
  Search,
  Video,
  Share2,
  Cpu,
  FileText,
  FileCheck,
  Layers,
  TrendingUp,
  Globe,
  Activity,
  Zap
} from '@lucide/astro';

import LightweightVisual3D from '../../components/visuals/LightweightVisual3D.astro';
import Services3DEcosystem from '../../components/services/Services3DEcosystem.astro';

const visualTypeMap: Record<string, any> = {
  'paid-advertising': 'service-ad',
  'website-design-development': 'service-web',
  'seo-local-search': 'service-seo',
  'creative-content': 'service-creative',
  'social-media-marketing': 'service-social',
  'ai-marketing-workflows': 'service-ai'
};

const engagementPatterns = [
  {
    title: 'Focused Service',
    subtitle: 'One defined service addressing a clear requirement.',
    description: 'Engage Starts Digital for one specific priority—such as a website rebuild or a targeted paid ad campaign.'
  },
  {
    title: 'Coordinated Project',
    subtitle: 'Multiple relevant services organised around one project scope.',
    description: 'Combine website development, creative content and campaign strategy into one unified project plan.'
  },
  {
    title: 'Ongoing Support',
    subtitle: 'Continued work based on agreed responsibilities and priorities.',
    description: 'Structure ongoing campaign management, content updates and optimization on an agreed schedule.'
  }
];

const generalFaqs = [
  {
    q: 'Can services be hired individually or combined?',
    a: 'Clients can hire Starts Digital for one focused service or combine multiple capabilities into one coordinated project scope.'
  },
  {
    q: 'How are project scopes and prices decided?',
    a: 'Scope and pricing depend on your specific project requirements, required deliverables, platforms and timeline. We review your goals and provide a clear proposal before starting work.'
  },
  {
    q: 'Which service detail pages are published?',
    a: 'All six core service pages are fully published with detailed deliverables, process steps, FAQs, and compact project references.'
  },
  {
    q: 'Does Starts Digital guarantee commercial results?',
    a: 'No digital agency can guarantee specific sales or rankings. We focus on disciplined execution, clear messaging alignment, responsive interface design and transparent review.'
  },
  {
    q: 'How do we begin a service engagement?',
    a: 'Submit your project context via our Contact form or WhatsApp. We will review your requirements, confirm feasibility, and arrange an initial scope review.'
  }
];
---

<BaseLayout>
  {/* 1. Services Hero */}
  <section id="services-hero" class="relative overflow-hidden bg-[#061d33] text-white pt-8 sm:pt-20 lg:pt-24 pb-16 sm:pb-20 lg:pb-24 rounded-b-[36px] lg:rounded-b-[48px] shadow-2xl scroll-mt-24">
    <AnimatedGrid opacity={0.10} />
    <FloatingOrb color="orange" size="lg" class="-top-24 -left-24 opacity-60 pointer-events-none" duration="16s" />
    <SectionSpark color="orange" size="md" class="top-10 right-[8%] pointer-events-none" delay="0s" />

    <div class="relative mx-auto max-w-[1280px] px-6 sm:px-8 z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left Column: Content & Action (7 cols) -->
        <div class="lg:col-span-7 space-y-6 text-left">
          <div class="inline-flex items-center">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-mono font-medium uppercase tracking-[0.06em] text-[#ddff35] backdrop-blur-md">
              <Sparkles class="size-3.5 text-[#ddff35]" />
              <span>SERVICES</span>
            </span>
          </div>

          <h1 class="font-heading font-bold text-[32px] sm:text-[44px] lg:text-[54px] leading-[1.12] tracking-[-0.03em] text-white">
            Digital capabilities organised around real project requirements.
          </h1>

          <p class="text-base sm:text-lg leading-[1.65] text-slate-200 font-body font-normal max-w-3xl">
            Starts Digital supports paid advertising, websites, search visibility, creative production, social media and practical AI workflows. Services can be used individually or coordinated around one agreed project scope.
          </p>

          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href={`${site.basePath}/contact/`}
              class="inline-flex items-center gap-2 rounded-full bg-[#ff762b] px-7 py-3.5 font-body font-semibold text-base text-white hover:bg-white hover:text-[#061d33] transition-all shadow-lg group/cta min-h-[44px]"
            >
              <span>Discuss Your Project</span>
              <ArrowRight class="size-4 group-hover/cta:translate-x-1 transition-transform" />
            </a>

            <a
              href="#directory"
              class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-6 py-3.5 font-body font-semibold text-base text-white hover:bg-white/15 transition-all min-h-[44px]"
            >
              <span>Explore Service Areas</span>
              <ChevronDown class="size-4 text-slate-300" />
            </a>
          </div>
        </div>

        <!-- Right Column: Unique 3D Services Ecosystem Anchor (5 cols) -->
        <div class="lg:col-span-5">
          <Services3DEcosystem />
        </div>

      </div>
    </div>
  </section>

  {/* 2. Visual Production Showcase Below Hero */}
  <section id="visual-production" class="py-16 sm:py-20 bg-white text-[#061d33] border-b border-[#061d33]/10">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
      <div class="mb-12 text-center max-w-3xl mx-auto space-y-3">
        <SectionEyebrow label="CREATIVE & PRODUCTION IN ACTION" align="center" motion={false} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
          How strategy and creative production come together
        </h2>
        <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
          From campaign strategy and responsive web engineering to video editing and local search execution.
        </p>
      </div>

      <!-- 3-Column Photography Showcase Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Showcase 1: Web Design & Frontend -->
        <div class="rounded-3xl border border-[#061d33]/12 bg-[#faf9f6] overflow-hidden shadow-xs group hover:border-[#ff762b]/40 transition-all duration-300 flex flex-col justify-between">
          <div class="overflow-hidden aspect-4/3 relative bg-[#061d33]">
            <picture>
              <source srcset={`${site.basePath}/photography/web-designer-responsive.avif`} type="image/avif" />
              <img
                src={`${site.basePath}/photography/web-designer-responsive.webp`}
                alt="Website design and responsive development in progress"
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </picture>
            <div class="absolute top-3 left-3 bg-[#061d33]/90 backdrop-blur-sm px-3 py-1 rounded-full border border-white/20">
              <span class="font-mono text-[10px] uppercase font-bold text-[#38bdf8] tracking-wider">Web Engineering</span>
            </div>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="font-heading font-bold text-xl text-[#061d33]">High-Speed Web Interfaces</h3>
            <p class="font-body text-sm text-slate-700 leading-relaxed">
              Mobile-optimised storefronts, fast landing pages and custom web builds configured for high conversion rates.
            </p>
            <div class="pt-2">
              <a href={`${site.basePath}/services/website-design-development/`} class="inline-flex items-center gap-1.5 font-mono text-xs text-[#ff762b] font-bold hover:underline">
                <span>Website Development</span>
                <ArrowRight class="size-3.5" />
              </a>
            </div>
          </div>
        </div>

        <!-- Showcase 2: Creative & Campaign Strategy -->
        <div class="rounded-3xl border border-[#061d33]/12 bg-[#faf9f6] overflow-hidden shadow-xs group hover:border-[#ff762b]/40 transition-all duration-300 flex flex-col justify-between">
          <div class="overflow-hidden aspect-4/3 relative bg-[#061d33]">
            <picture>
              <source srcset={`${site.basePath}/photography/creative-campaign-planning.avif`} type="image/avif" />
              <img
                src={`${site.basePath}/photography/creative-campaign-planning.webp`}
                alt="Creative campaign planning and wireframing"
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </picture>
            <div class="absolute top-3 left-3 bg-[#061d33]/90 backdrop-blur-sm px-3 py-1 rounded-full border border-white/20">
              <span class="font-mono text-[10px] uppercase font-bold text-[#ff762b] tracking-wider">Campaign Strategy</span>
            </div>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="font-heading font-bold text-xl text-[#061d33]">Creative Strategy & Media</h3>
            <p class="font-body text-sm text-slate-700 leading-relaxed">
              Direct-response ad creative, video editing, social media assets and clear customer messaging.
            </p>
            <div class="pt-2">
              <a href={`${site.basePath}/services/creative-content/`} class="inline-flex items-center gap-1.5 font-mono text-xs text-[#ff762b] font-bold hover:underline">
                <span>Creative Content</span>
                <ArrowRight class="size-3.5" />
              </a>
            </div>
          </div>
        </div>

        <!-- Showcase 3: Video Production & Editing -->
        <div class="rounded-3xl border border-[#061d33]/12 bg-[#faf9f6] overflow-hidden shadow-xs group hover:border-[#ff762b]/40 transition-all duration-300 flex flex-col justify-between">
          <div class="overflow-hidden aspect-4/3 relative bg-[#061d33]">
            <picture>
              <source srcset={`${site.basePath}/photography/video-editing-workstation.avif`} type="image/avif" />
              <img
                src={`${site.basePath}/photography/video-editing-workstation.webp`}
                alt="Video editing software workstation for ad campaigns"
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
            </picture>
            <div class="absolute top-3 left-3 bg-[#061d33]/90 backdrop-blur-sm px-3 py-1 rounded-full border border-white/20">
              <span class="font-mono text-[10px] uppercase font-bold text-purple-400 tracking-wider">Video & Motion</span>
            </div>
          </div>
          <div class="p-6 space-y-2">
            <h3 class="font-heading font-bold text-xl text-[#061d33]">Paid Social Video Ad Production</h3>
            <p class="font-body text-sm text-slate-700 leading-relaxed">
              Multi-angle video ad variations, motion graphic hooks and customer product showcase edits.
            </p>
            <div class="pt-2">
              <a href={`${site.basePath}/services/paid-advertising/`} class="inline-flex items-center gap-1.5 font-mono text-xs text-[#ff762b] font-bold hover:underline">
                <span>Paid Advertising</span>
                <ArrowRight class="size-3.5" />
              </a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  {/* 3. Six-Service Directory */}
  <section id="directory" class="py-16 sm:py-20 lg:py-24 bg-[#faf9f6] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-44 sm:scroll-mt-40 lg:scroll-mt-36">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
      
      <div class="mb-12 text-center max-w-3xl mx-auto space-y-3">
        <SectionEyebrow label="SERVICE DIRECTORY" align="center" motion={false} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight tracking-[-0.025em]">
          Six core capabilities for digital marketing and development.
        </h2>
        <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
          Click any service area to explore full deliverables, process steps and FAQs.
        </p>
      </div>

      <!-- Divided Editorial Rows Index -->
      <div class="rounded-3xl border border-[#061d33]/15 overflow-hidden shadow-xs divide-y divide-[#061d33]/12">
        {getPublishedServices().map((svc, idx) => {
          const targetUrl = `${site.basePath}/services/${svc.slug}/`;
          const isEven = idx % 2 === 0;

          return (
            <div class={`p-6 sm:p-8 lg:p-10 transition-colors ${isEven ? 'bg-white hover:bg-[#f7f4ed]/50' : 'bg-[#f7f4ed] hover:bg-white/80'} group`}>
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                
                <!-- Service Identity -->
                <div class="lg:col-span-4 space-y-2">
                  <div class="flex items-center gap-3">
                    <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-2.5 py-0.5 rounded">
                      0{idx + 1}
                    </span>
                    <LightweightVisual3D type={visualTypeMap[svc.slug] || 'service-ad'} />
                    <span class="text-xs font-mono font-semibold uppercase tracking-wider text-slate-500">{svc.shortName}</span>
                  </div>

                  <h3 class="font-heading font-bold text-2xl sm:text-3xl text-[#061d33]">
                    <a href={targetUrl} class="hover:text-[#ff762b] transition-colors">
                      {svc.name}
                    </a>
                  </h3>
                </div>

                <!-- Summary & Core Support Areas -->
                <div class="lg:col-span-5 space-y-3">
                  <p class="text-base font-body text-slate-800 leading-relaxed font-normal">
                    {svc.summary}
                  </p>
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1">
                    {svc.idealFor.slice(0, 4).map((area) => (
                      <div class="flex items-start gap-2 text-xs font-mono text-slate-600">
                        <CheckCircle2 class="size-3.5 text-[#ff762b] shrink-0 mt-0.5" />
                        <span>{area}</span>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Action Area -->
                <div class="lg:col-span-3 lg:text-right pt-2 lg:pt-0">
                  <a
                    href={targetUrl}
                    class="inline-flex items-center gap-2 rounded-full border border-[#061d33]/20 bg-white px-5 py-2.5 text-xs font-mono font-semibold text-[#061d33] group-hover:bg-[#061d33] group-hover:text-white transition-all shadow-xs min-h-[44px]"
                  >
                    <span>VIEW SERVICE PAGE</span>
                    <ArrowRight class="size-3.5 group-hover:translate-x-1 transition-transform" />
                  </a>
                </div>

              </div>
            </div>
          );
        })}
      </div>

    </div>
  </section>

  {/* 3. Common Business Needs */}
  <section id="common-needs" class="py-16 sm:py-20 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10 scroll-mt-44">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
      <div class="mb-12 text-center max-w-3xl mx-auto space-y-3">
        <SectionEyebrow label="COMMON BUSINESS NEEDS" align="center" motion={false} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight">
          How services address typical business requirements.
        </h2>
        <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
          Businesses engage us for focused single-service deliverables or full marketing coordination.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 mb-8">
        {engagementPatterns.map((pat, idx) => (
          <div class="rounded-3xl border border-[#061d33]/12 bg-white p-6 sm:p-8 flex flex-col justify-between shadow-xs">
            <div class="space-y-3">
              <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider block">
                NEED 0{idx + 1}
              </span>
              <h3 class="font-heading font-bold text-2xl text-[#061d33]">
                {pat.title}
              </h3>
              <p class="font-mono text-xs text-slate-500 font-semibold">
                {pat.subtitle}
              </p>
              <p class="text-base text-slate-700 font-body leading-relaxed pt-2 font-normal">
                {pat.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* 4. Service Combinations */}
  <section id="service-combinations" class="py-16 sm:py-20 bg-white text-[#061d33] border-b border-[#061d33]/10">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8">
      <div class="mb-12 text-center max-w-3xl mx-auto space-y-3">
        <SectionEyebrow label="SERVICE COMBINATIONS" align="center" motion={false} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight">
          How services work together
        </h2>
        <p class="text-base text-slate-700 font-body leading-relaxed font-normal">
          Connecting search, creative and advertising into one clear plan for your marketing goals.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <div class="rounded-3xl border border-[#061d33]/12 bg-[#f7f4ed] p-7 space-y-4">
          <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">ACQUISITION FRAMEWORK</span>
          <h3 class="font-heading font-bold text-2xl text-[#061d33]">Paid Ads + Creative Content + Landing Pages</h3>
          <p class="text-base text-slate-700 font-body leading-relaxed">
            Combines Meta ad campaigns with custom video creative and mobile-optimized conversion pages.
          </p>
        </div>

        <div class="rounded-3xl border border-[#061d33]/12 bg-[#f7f4ed] p-7 space-y-4">
          <span class="text-xs font-mono font-bold uppercase text-[#ff762b] tracking-wider">ORGANIC & LOCAL FRAMEWORK</span>
          <h3 class="font-heading font-bold text-2xl text-[#061d33]">Website + Local SEO + AI Workflows</h3>
          <p class="text-base text-slate-700 font-body leading-relaxed">
            Combines structured website development with location pages and automated WhatsApp inquiry routing.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* 5. Service Delivery Process */}
  <section id="service-process" class="py-16 sm:py-20 bg-[#f7f4ed] text-[#061d33] border-b border-[#061d33]/10">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8 space-y-10">
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <SectionEyebrow label="SERVICE DELIVERY METHOD" align="center" motion={false} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight">
          Structured Service Delivery from Brief to Review
        </h2>
        <p class="text-base text-slate-700 font-body leading-relaxed">
          Every service engagement follows documented requirements, scope confirmation, production execution, and performance review.
        </p>
      </div>

      <!-- 4-stage connected delivery system timeline -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
        <div class="rounded-3xl border border-[#061d33]/12 bg-white p-6 flex flex-col justify-between shadow-xs relative group hover:border-[#ff762b]/50 transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-2.5 py-1 rounded-full">
                STAGE 01
              </span>
              <div class="size-10 rounded-2xl bg-[#061d33]/5 flex items-center justify-center text-[#061d33] group-hover:bg-[#ff762b] group-hover:text-white transition-colors">
                <FileText class="size-5" />
              </div>
            </div>
            <h3 class="font-heading font-bold text-xl text-[#061d33]">Business Brief</h3>
            <p class="font-body text-sm text-slate-700 leading-relaxed">
              Goals, business context, available assets and requirements.
            </p>
          </div>
        </div>

        <div class="rounded-3xl border border-[#061d33]/12 bg-white p-6 flex flex-col justify-between shadow-xs relative group hover:border-[#ff762b]/50 transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[#ff762b] text-xs font-bold uppercase tracking-wider bg-[#ff762b]/10 px-2.5 py-1 rounded-full">
                STAGE 02
              </span>
              <div class="size-10 rounded-2xl bg-[#061d33]/5 flex items-center justify-center text-[#061d33] group-hover:bg-[#ff762b] group-hover:text-white transition-colors">
                <FileCheck class="size-5" />
              </div>
            </div>
            <h3 class="font-heading font-bold text-xl text-[#061d33]">Scope Confirmation</h3>
            <p class="font-body text-sm text-slate-700 leading-relaxed">
              Deliverables, responsibilities, platforms and timeline.
            </p>
          </div>
        </div>

        <div class="rounded-3xl border border-[#061d33]/12 bg-white p-6 flex flex-col justify-between shadow-xs relative group hover:border-[#ff762b]/50 transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-2.5 py-1 rounded-full">
                STAGE 03
              </span>
              <div class="size-10 rounded-2xl bg-[#061d33]/5 flex items-center justify-center text-[#061d33] group-hover:bg-[#ff762b] group-hover:text-white transition-colors">
                <Layers class="size-5" />
              </div>
            </div>
            <h3 class="font-heading font-bold text-xl text-[#061d33]">Production & Execution</h3>
            <p class="font-body text-sm text-slate-700 leading-relaxed">
              Design, development, campaigns, content or technical implementation.
            </p>
          </div>
        </div>

        <div class="rounded-3xl border border-[#061d33]/12 bg-white p-6 flex flex-col justify-between shadow-xs relative group hover:border-[#ff762b]/50 transition-all">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold text-[#ff762b] uppercase tracking-wider bg-[#ff762b]/10 px-2.5 py-1 rounded-full">
                STAGE 04
              </span>
              <div class="size-10 rounded-2xl bg-[#061d33]/5 flex items-center justify-center text-[#061d33] group-hover:bg-[#ff762b] group-hover:text-white transition-colors">
                <TrendingUp class="size-5" />
              </div>
            </div>
            <h3 class="font-heading font-bold text-xl text-[#061d33]">Review & Next Actions</h3>
            <p class="font-body text-sm text-slate-700 leading-relaxed">
              Review completed work, available results and agreed next actions.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* 6. Supported Platforms & Environments */}
  <section id="service-platforms" class="py-16 sm:py-20 bg-white text-[#061d33] border-b border-[#061d33]/10">
    <div class="mx-auto max-w-[1280px] px-6 sm:px-8 space-y-10">
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <SectionEyebrow label="TECHNICAL ENVIRONMENTS" align="center" motion={false} />
        <h2 class="font-heading font-bold text-[28px] sm:text-[36px] lg:text-[40px] text-[#061d33] leading-tight">
          Platforms, Tools and Systems We Manage
        </h2>

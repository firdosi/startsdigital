---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import ProjectProof from '../components/landing/ProjectProof.astro';
import BrandMarquee from '../components/landing/BrandMarquee.astro';
import Features from '../components/landing/Features.astro';
import Showcase from '../components/landing/Showcase.astro';
import Process from '../components/landing/Process.astro';
import PlatformGrid from '../components/landing/PlatformGrid.astro';
import Faq from '../components/landing/Faq.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import MotionController from '../components/common/MotionController.astro';
import { site } from '../site.config';
---

<BaseLayout 
  title={`${site.name} — Strategy, Execution & Digital Growth`}
  description={site.description}
>
  {/* 1. Hero V2 (Editorial Split Layout & Grounded Project-Proof Summary) */}
  <Hero />

  {/* 2. Contextual Project Proof (Detailed Project Narrative & Metrics in Context) */}
  <ProjectProof />

  {/* 3. Selected Client Experience (Approved Editorial Client Index) */}
  <BrandMarquee />

  {/* 4. Services Overview / Capabilities (Editorial 6-Service Capabilities Grid) */}
  <Features />

  {/* 5. Featured Work (Selected Projects Across E-Commerce, Agriculture & Local Services) */}
  <Showcase />

  {/* 6. Working Method (Execution Accordion Framework) */}
  <Process />

  {/* 7. Platforms & Tools */}
  <PlatformGrid />

  {/* 8. Frequently Asked Questions */}
  <Faq />

  {/* 9. Final CTA */}
  <FinalCta />

  {/* Motion Controller System */}
  <MotionController />
</BaseLayout>

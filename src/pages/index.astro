---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import ProjectProof from '../components/landing/ProjectProof.astro';
import BrandMarquee from '../components/landing/BrandMarquee.astro';
import Features from '../components/landing/Features.astro';
import Showcase from '../components/landing/Showcase.astro';
import EngagementPath from '../components/landing/EngagementPath.astro';
import TeamPreview from '../components/landing/TeamPreview.astro';
import Process from '../components/landing/Process.astro';
import PlatformGrid from '../components/landing/PlatformGrid.astro';
import Faq from '../components/landing/Faq.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import MotionController from '../components/common/MotionController.astro';
import { site } from '../site.config';
---

<BaseLayout 
  title={`${site.name} — Strategy, Execution & Digital Growth`}
  description={site.description}
>
  {/* 1. Hero V2 (Editorial Split Layout & Grounded Campaign Outcomes) */}
  <Hero />

  {/* 2. Project Proof (RK Reno Solutions & ConvortAI Contextual Proof) */}
  <ProjectProof />

  {/* 3. Selected Client Experience (Approved Editorial Client Index) */}
  <BrandMarquee />

  {/* 4. Services Overview / Capabilities (6-Service Capabilities Grid) */}
  <Features />

  {/* 5. Featured Work (4 Selected Projects Across E-Commerce, Agriculture, Services & Technology) */}
  <Showcase />

  {/* 6. Engagement Path (Starting a Project Inquiry Journey) */}
  <EngagementPath />

  {/* 7. Team Preview (Conditionally renders approved team members, zero-height when empty) */}
  <TeamPreview />

  {/* 8. Working Method (Execution Accordion Framework) */}
  <Process />

  {/* 9. Platforms & Tools */}
  <PlatformGrid />

  {/* 10. Frequently Asked Questions */}
  <Faq />

  {/* 11. Final CTA */}
  <FinalCta />

  {/* Motion Controller System */}
  <MotionController />
</BaseLayout>

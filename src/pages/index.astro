---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import Features from '../components/landing/Features.astro';
import EngagementPath from '../components/landing/EngagementPath.astro';
import Process from '../components/landing/Process.astro';
import PlatformGrid from '../components/landing/PlatformGrid.astro';
import BrandMarquee from '../components/landing/BrandMarquee.astro';
import Showcase from '../components/landing/Showcase.astro';
import TeamPreview from '../components/landing/TeamPreview.astro';
import Faq from '../components/landing/Faq.astro';
import FinalCta from '../components/landing/FinalCta.astro';
import MotionController from '../components/common/MotionController.astro';
---

<BaseLayout>
  {/* 1. Hero (Service-First Positioning & Core Capabilities) */}
  <Hero />

  {/* 2. Six Core Services (Capabilities Overview) */}
  <Features />

  {/* 3. Business Problems We Help Solve */}
  <EngagementPath />

  {/* 4. How Starts Digital Works (Working Method) */}
  <Process />

  {/* 5. Platforms & Tools We Work With */}
  <PlatformGrid />

  {/* 6. Brands We Have Worked With (13 Approved Client Brands) */}
  <BrandMarquee />

  {/* 7. Compact Selected Work Preview (4 Compact Project Cards) */}
  <Showcase />

  {/* 8. Team Preview (Ahad, Meesam and Zaid) */}
  <TeamPreview />

  {/* 9. Frequently Asked Questions */}
  <Faq />

  {/* 10. Final CTA */}
  <FinalCta />

  {/* Motion Controller System */}
  <MotionController />
</BaseLayout>

---
import '@fontsource/sora/latin-400.css';
import '@fontsource/sora/latin-600.css';
import '@fontsource/sora/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/jetbrains-mono/latin-500.css';

import '../styles/global.css';

import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEO from '../components/seo/SEO.astro';
import StructuredData from '../components/seo/StructuredData.astro';
import { ClientRouter } from 'astro:transitions';
import { site } from '../site.config';
import MotionController from '../components/common/MotionController.astro';
import InteractionController from '../components/common/InteractionController.astro';
import Analytics from '../components/analytics/Analytics.astro';

import { getMotionCssVariables } from '../data/motion';
import { getSeoForPath } from '../data/seo';

interface Props {
  noindex?: boolean;
}

const { noindex } = Astro.props;
const currentPath = Astro.url.pathname;
const registeredSeo = getSeoForPath(currentPath);

const resolvedNoindex = noindex ?? registeredSeo.robots?.includes('noindex');
---

<html lang="en" style={getMotionCssVariables()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Favicon & App Icons -->
    <link rel="icon" type="image/svg+xml" href={`${site.basePath}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${site.basePath}/favicon-32x32.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${site.basePath}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${site.basePath}/site.webmanifest`} />
    <link rel="sitemap" href={`${site.basePath}/sitemap-index.xml`} />
    
    <SEO noindex={resolvedNoindex} />
    <StructuredData />
    <ClientRouter fallback="swap" />
    
    <script is:inline>
      if (typeof window !== 'undefined' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion-initialized');
      }
    </script>
    <noscript>
      <style>
        [data-motion], .reveal-on-scroll {
          opacity: 1 !important;
          transform: none !important;
          clip-path: none !important;
          filter: none !important;
        }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body class="bg-[#f7f4ed] text-[#061d33] antialiased selection:bg-[#ff762b] selection:text-white font-body">
    <!-- Accessibility Skip to Main Content Link -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-[#061d33] focus:text-[#ddff35] focus:rounded-xl focus:font-mono focus:text-xs focus:font-bold focus:shadow-xl focus:outline-none focus:ring-2 focus:ring-[#ff762b]"
    >
      Skip to main content
    </a>

    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />

    <MotionController />
    <InteractionController />
    <Analytics />
  </body>
</html>
